<?xml version="1.0" encoding="utf-8"?>
<!-- Публичный интерфейс библиотеки — вход через провайдера и умолчания пресетов.
     Всё остальное лежит в src/internal, подключается изнутри директивой
     #Использовать "../internal" и меняется без оглядки на обратную совместимость. -->
<package-def xmlns="http://oscript.io/schemas/lib-config/1.0">
    <class name="ВходЧерезПровайдера" file="src/Классы/ВходЧерезПровайдера.os"/>
    <class name="УмолчанияПресетов" file="src/Классы/УмолчанияПресетов.os"/>
</package-def>
