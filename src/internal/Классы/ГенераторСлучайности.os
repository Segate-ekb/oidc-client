// CSPRNG: контракт СлучайныеБайты(Количество) → ДвоичныеДанные.
// Энтропия — УникальныйИдентификатор (системный CSPRNG .NET) с отбеливанием
// SHA-256. Встроенный ГенераторСлучайныхЧисел не годится: это System.Random.

// Возвращает заданное число криптостойких случайных байт.
//
// Параметры:
//   Количество - Число - целое от 1 до 4096.
//
// Возвращаемое значение:
//   ДвоичныеДанные
//
Функция СлучайныеБайты(Знач Количество) Экспорт

	Если ТипЗнч(Количество) <> Тип("Число") Или Количество <> Цел(Количество)
		Или Количество < 1 Или Количество > 4096 Тогда
		ВызватьИсключение "ГенераторСлучайности: число байт должно быть целым от 1 до 4096";
	КонецЕсли;

	Результат = Новый БуферДвоичныхДанных(Количество);
	Позиция = 0;
	Пока Позиция < Количество Цикл
		Хеш = Новый ХешированиеДанных(ХешФункция.SHA256);
		Хеш.Добавить(ПолучитьДвоичныеДанныеИзСтроки(
			Строка(Новый УникальныйИдентификатор) + Строка(Новый УникальныйИдентификатор), "UTF-8", Ложь));
		Блок = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(Хеш.ХешСумма);
		Взять = Мин(Блок.Размер, Количество - Позиция);
		Результат.Записать(Позиция, Блок, Взять);
		Позиция = Позиция + Взять;
	КонецЦикла;

	Возврат ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(Результат);

КонецФункции
