// Результат начала Authorization Code Flow: URL плюс три секрета, которые
// вызывающий обязан сохранить до возврата с провайдера.

Перем URL_;             // Строка
Перем Состояние_;       // Строка
Перем Одноразовость_;   // Строка
Перем ПроверочныйКод_;  // Строка

Процедура ПриСозданииОбъекта(Знач URL, Знач Состояние, Знач Одноразовость, Знач ПроверочныйКод)
	URL_            = URL;
	Состояние_      = Состояние;
	Одноразовость_  = Одноразовость;
	ПроверочныйКод_ = ПроверочныйКод;
КонецПроцедуры

// Полный URL авторизации (authorization_endpoint со всеми параметрами).
Функция URL() Экспорт
	Возврат URL_;
КонецФункции

// Значение state (анти-CSRF).
Функция Состояние() Экспорт
	Возврат Состояние_;
КонецФункции

// Значение nonce (привязка id_token к входу).
Функция Одноразовость() Экспорт
	Возврат Одноразовость_;
КонецФункции

// Проверочный код PKCE (code_verifier) для обмена кода на токены.
Функция ПроверочныйКод() Экспорт
	Возврат ПроверочныйКод_;
КонецФункции
