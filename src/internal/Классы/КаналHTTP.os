// Единственное место, которое ходит в сеть. Своего HTTP здесь нет — всё делает
// 1connector. Класс остаётся ради четырёх вещей: инъекция сессии (шов для тестов),
// постоянные параметры на все запросы, СВЕЖАЯ структура ДополнительныхПараметров
// на каждый запрос — 1connector дописывает в переданную свои ключи, и общая
// структура протащила бы тело формы token endpoint в следующий GET, — и один повтор
// несостоявшегося GET для тех, кому он разрешён.

#Использовать 1connector

Перем Сессия_;    // Сессия 1connector либо её двойник (тесты)
Перем Настройки_; // Соответствие - постоянные ДополнительныеПараметры 1connector

#Область ПрограммныйИнтерфейс

// Параметры:
//   Соединение    - Сессия 1connector или её двойник; Неопределено — своя новая;
//   ПараметрыHTTP - Структура, Соответствие - ДополнительныеПараметры 1connector,
//                   общие для всех запросов.
//
Процедура ПриСозданииОбъекта(Знач Соединение = Неопределено, Знач ПараметрыHTTP = Неопределено)

	Сессия_ = ?(Соединение = Неопределено, Новый Сессия, Соединение);
	Настройки_ = КСоответствию(ПараметрыHTTP);

КонецПроцедуры

// Сессия канала — чтобы связанные клиенты работали через одно соединение.
Функция Сессия() Экспорт
	Возврат Сессия_;
КонецФункции

// GET по абсолютному URL.
//
// Параметры:
//   URL       - Строка;
//   Заголовки - Соответствие - поверх постоянных.
//
// Возвращаемое значение:
//   Ответ 1connector (КодСостояния, Текст(), Json()).
//
Функция Получить(Знач URL, Знач Заголовки = Неопределено) Экспорт

	Возврат Сессия_.ВызватьМетод("GET", URL, ДополнительныеПараметры(Заголовки, Неопределено));

КонецФункции

// GET, который повторяется один раз и сразу, если запрос не состоялся: нет соединения,
// обрыв, истёк таймаут. Ответ с любым кодом, в том числе с Retry-After, не повторяется
// и возвращается как есть — это решение провайдера, а не сбой сети. Второй несостоявшийся
// запрос — исключение.
//
// Параметры:
//   URL       - Строка;
//   Заголовки - Соответствие - поверх постоянных.
//
// Возвращаемое значение:
//   Ответ 1connector (КодСостояния, Текст(), Json()).
//
Функция ПолучитьСОднимПовтором(Знач URL, Знач Заголовки = Неопределено) Экспорт

	Попытка
		Возврат Получить(URL, Заголовки);
	Исключение
		Возврат Получить(URL, Заголовки);
	КонецПопытки;

КонецФункции

// POST формы; кодирование и Content-Type — за 1connector.
//
// Параметры:
//   URL       - Строка;
//   Форма     - Соответствие - поля формы;
//   Заголовки - Соответствие - поверх постоянных.
//
// Возвращаемое значение:
//   Ответ 1connector.
//
Функция ОтправитьФорму(Знач URL, Знач Форма, Знач Заголовки = Неопределено) Экспорт

	Возврат Сессия_.ВызватьМетод("POST", URL, ДополнительныеПараметры(Заголовки, Форма));

КонецФункции

// Разбирает тело ответа как JSON.
//
// Параметры:
//   Ответ      - ответ 1connector;
//   Назначение - Строка - что разбирается (попадает в текст исключения).
//
// Возвращаемое значение:
//   Соответствие, Массив, Произвольный.
//
Функция JSON(Знач Ответ, Знач Назначение) Экспорт

	Попытка
		Возврат Ответ.Json();
	Исключение
		ВызватьИсключение "OIDC: не удалось разобрать JSON (" + Назначение + "): " + ОписаниеОшибки();
	КонецПопытки;

КонецФункции

// То же без исключения: Неопределено, если тело не разбирается.
Функция JSONИлиНеопределено(Знач Ответ) Экспорт

	Попытка
		Возврат Ответ.Json();
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Свежая на каждый запрос (см. шапку); заголовки запроса поверх общих.
Функция ДополнительныеПараметры(Знач Заголовки, Знач Данные)

	Результат = Новый Структура();
	Для Каждого КиЗ Из Настройки_ Цикл
		Если Строка(КиЗ.Ключ) <> "Заголовки" Тогда
			Результат.Вставить(Строка(КиЗ.Ключ), КиЗ.Значение);
		КонецЕсли;
	КонецЦикла;

	ЗаголовкиЗапроса = СлитыеЗаголовки(Заголовки);
	Если ЗаголовкиЗапроса.Количество() > 0 Тогда
		Результат.Вставить("Заголовки", ЗаголовкиЗапроса);
	КонецЕсли;

	Если Данные <> Неопределено Тогда
		Результат.Вставить("Данные", Данные);
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция СлитыеЗаголовки(Знач Заголовки)

	Результат = Новый Соответствие();
	Для Каждого КиЗ Из КСоответствию(Настройки_.Получить("Заголовки")) Цикл
		Результат.Вставить(Строка(КиЗ.Ключ), КиЗ.Значение);
	КонецЦикла;
	Для Каждого КиЗ Из КСоответствию(Заголовки) Цикл
		Результат.Вставить(Строка(КиЗ.Ключ), КиЗ.Значение);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция КСоответствию(Знач Данные)

	Результат = Новый Соответствие();
	Если ТипЗнч(Данные) = Тип("Соответствие") Или ТипЗнч(Данные) = Тип("Структура") Тогда
		Для Каждого КиЗ Из Данные Цикл
			Результат.Вставить(КиЗ.Ключ, КиЗ.Значение);
		КонецЦикла;
	КонецЕсли;
	Возврат Результат;

КонецФункции

#КонецОбласти
