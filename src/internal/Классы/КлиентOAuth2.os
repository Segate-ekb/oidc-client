// Клиент чистого OAuth 2.0 для провайдеров без OIDC (GitHub и подобные):
// discovery не существует, id_token не выдаётся, сведения о человеке — только
// из userinfo. Композиция над КлиентOIDC: авторизация, обмен кода и userinfo
// у протоколов одинаковы. Проверки id_token здесь нет намеренно.
//
// Умеет двухшаговый добор email: если в профиле нет подтверждённого адреса,
// а точка Emails объявлена — запрашивает её. Неудача добора вход не рушит,
// но и не прячется: исход добора возвращается вызывающему вместе с причиной.

#Использовать 1connector

Перем Внутренний_; // КлиентOIDC — общий для обоих протоколов слой запросов
Перем Канал_;      // КаналHTTP — для точки Emails (сессия общая с внутренним клиентом)

#Область ПрограммныйИнтерфейс

// Параметры:
//   Конфигурация  - КонфигурацияПровайдера (Тип = "oauth2"), Структура, Соответствие;
//   Сессия        - Сессия 1connector или её двойник;
//   Часы          - объект с методом Сейчас();
//   Генератор     - объект с методом СлучайныеБайты(Количество);
//   ПараметрыHTTP - Структура - ДополнительныеПараметры 1connector.
//
Процедура ПриСозданииОбъекта(Знач Конфигурация, Знач Сессия = Неопределено,
	Знач Часы = Неопределено, Знач Генератор = Неопределено, Знач ПараметрыHTTP = Неопределено)

	Канал_ = Новый КаналHTTP(Сессия, ПараметрыHTTP);
	// сессия общая: оба протокола ходят к одному провайдеру
	Внутренний_ = Новый КлиентOIDC(Конфигурация, Канал_.Сессия(), Часы, Генератор, ПараметрыHTTP);

КонецПроцедуры

// Метаданные провайдера (из ручных конечных точек).
//
// Возвращаемое значение:
//   МетаданныеПровайдера
//
Функция Метаданные() Экспорт
	Возврат Внутренний_.Метаданные();
КонецФункции

// Начинает Authorization Code Flow. nonce тоже генерируется и уезжает в URL:
// OAuth2-серверы обязаны игнорировать неизвестные параметры (RFC 6749 §3.1),
// а транзакция остаётся одной формы для обоих протоколов.
//
// Параметры:
//   ДополнительныеПараметры - Соответствие - доп. query-параметры.
//
// Возвращаемое значение:
//   ЗапросАвторизации
//
Функция НачатьАвторизацию(Знач ДополнительныеПараметры = Неопределено) Экспорт
	Возврат Внутренний_.НачатьАвторизацию(ДополнительныеПараметры);
КонецФункции

// Обменивает код на токены; id_token в ответе НЕ ожидается.
//
// Параметры:
//   Код            - Строка - authorization code;
//   ПроверочныйКод - Строка - code_verifier.
//
// Возвращаемое значение:
//   НаборТокенов
//
Функция ОбменятьКодНаТокены(Знач Код, Знач ПроверочныйКод) Экспорт
	Возврат Внутренний_.ОбменятьКодНаТокены(Код, ПроверочныйКод);
КонецФункции

// Профиль с userinfo, без добора email: субъект проверяется раньше, чем идти за адресом.
//
// Параметры:
//   ТокенДоступа - Строка - access_token.
//
// Возвращаемое значение:
//   Соответствие - сырые клеймы провайдера.
//
Функция ПолучитьПрофиль(Знач ТокенДоступа) Экспорт
	Возврат Внутренний_.ПолучитьПрофиль(ТокенДоступа);
КонецФункции

// Добирает подтверждённый адрес со второй точки, когда профиль сам о нём не сказал.
// Найденный адрес кладётся в профиль (email, email_verified). Исключений не бросает:
// email — желательная, а не обязательная часть профиля. Несостоявшийся запрос
// повторяется один раз; ответ с кодом отказа не повторяется.
//
// Параметры:
//   Профиль      - Соответствие - клеймы userinfo; дополняется на месте;
//   ТокенДоступа - Строка - access_token.
//
// Возвращаемое значение:
//   Структура - Исход (Строка: not_needed | obtained | no_verified | failed),
//               Сбой (Строка — что не получилось у failed, иначе пусто).
//
Функция ДобратьEmail(Знач Профиль, Знач ТокенДоступа) Экспорт

	Если EmailПодтверждёнВПрофиле(Профиль) Тогда
		Возврат ИсходДобора("not_needed");
	КонецЕсли;

	ТочкаEmails = Внутренний_.Метаданные().Значение("emails_endpoint");
	Если ТочкаEmails = Неопределено Тогда
		Возврат ИсходДобора("not_needed");
	КонецЕсли;

	Попытка
		Ответ = Канал_.ПолучитьСОднимПовтором(ТочкаEmails, ЗаголовкиЗапроса(ТокенДоступа));
	Исключение
		Возврат ИсходДобора("failed", "запрос не состоялся и после повтора: "
			+ БезТокена(КорневаяПричина(ИнформацияОбОшибке()), ТокенДоступа));
	КонецПопытки;

	Если Ответ.КодСостояния <> КодыСостоянияHTTP.ОК_200 Тогда
		Возврат ИсходДобора("failed", СтрШаблон("провайдер ответил кодом %1", Ответ.КодСостояния));
	КонецЕсли;

	Записи = Канал_.JSONИлиНеопределено(Ответ);
	Если ТипЗнч(Записи) <> Тип("Массив") Тогда
		Возврат ИсходДобора("failed", "тело ответа — не JSON-массив адресов");
	КонецЕсли;

	Запись = ОсновнойEmail(Записи);
	Если Запись = Неопределено Тогда
		Возврат ИсходДобора("no_verified");
	КонецЕсли;

	Профиль.Вставить("email", Запись.Получить("email"));
	Профиль.Вставить("email_verified", Запись.Получить("verified") = Истина);
	Возврат ИсходДобора("obtained");

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ИсходДобора(Знач Исход, Знач Сбой = "")
	Возврат Новый Структура("Исход, Сбой", Исход, Сбой);
КонецФункции

// GitHub /user признака подтверждённости не отдаёт никогда, поэтому для него
// добор выполняется всегда, когда объявлена точка Emails.
Функция EmailПодтверждёнВПрофиле(Знач Профиль)

	Email = Профиль.Получить("email");
	Если Email = Неопределено Или СтрДлина(СокрЛП(Строка(Email))) = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Профиль.Получить("email_verified") <> Неопределено;

КонецФункции

Функция ЗаголовкиЗапроса(Знач ТокенДоступа)

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Authorization", "Bearer " + ТокенДоступа);
	Заголовки.Вставить("Accept", "application/json");
	Возврат Заголовки;

КонецФункции

// 1connector поднимает ошибку сети текстом «…caused by: <причина>»; последняя строка —
// то, что сказала сама сеть: Connection reset by peer, The operation has timed out.
Функция КорневаяПричина(Знач Информация)

	Строки = СтрРазделить(Информация.Описание, Символы.ПС, Ложь);
	Индекс = Строки.ВГраница();
	Пока Индекс >= 0 Цикл
		Последняя = СокрЛП(Строки[Индекс]);
		Если СтрДлина(Последняя) > 0 Тогда
			Возврат Последняя;
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;
	Возврат "причина не названа";

КонецФункции

// Причина уходит в журнал приложения; токену доступа там не место, даже случайно.
Функция БезТокена(Знач Текст, Знач ТокенДоступа)

	Токен = Строка(ТокенДоступа);
	Если СтрДлина(Токен) = 0 Тогда
		Возврат Текст;
	КонецЕсли;
	Возврат СтрЗаменить(Текст, Токен, "***");

КонецФункции

// Ожидается массив вида GitHub /user/emails: [{email, primary, verified}, …].
// primary+verified, иначе первый verified, иначе Неопределено:
// неподтверждённый адрес в привязку личности не подставляется.
Функция ОсновнойEmail(Знач Записи)

	ПервыйПодтверждённый = Неопределено;
	Для Каждого Запись Из Записи Цикл
		Если ТипЗнч(Запись) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;
		Если Запись.Получить("verified") <> Истина Тогда
			Продолжить;
		КонецЕсли;
		Если Запись.Получить("primary") = Истина Тогда
			Возврат Запись;
		КонецЕсли;
		Если ПервыйПодтверждённый = Неопределено Тогда
			ПервыйПодтверждённый = Запись;
		КонецЕсли;
	КонецЦикла;

	Возврат ПервыйПодтверждённый;

КонецФункции

#КонецОбласти
