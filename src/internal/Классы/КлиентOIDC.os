// Клиент OpenID Connect: discovery, URL авторизации, обмен кода, userinfo,
// проверка клеймов id_token. Подпись НЕ проверяется — доверие держится на том,
// что токен получен напрямую от token endpoint по TLS (см. README).

#Использовать 1connector

Перем Издатель_;             // Строка — issuer ровно как задан в конфигурации (сверка iss)
Перем БазаИздателя_;         // Строка — issuer без завершающего "/" (только для URL discovery)
Перем ИдентификаторКлиента_; // Строка
Перем СекретКлиента_;        // Строка ("" — без секрета)
Перем АдресВозврата_;        // Строка
Перем Область_;              // Строка
Перем ЛюфтСекунд_;           // Число
Перем СпособАутентификации_; // Строка — client_secret_post | client_secret_basic | none
Перем РучныеМетаданные_;     // Соответствие сырых конечных точек или Неопределено

Перем Канал_;                // КаналHTTP — все обращения к провайдеру
Перем Часы_;                 // объект с методом Сейчас()
Перем Генератор_;            // объект с методом СлучайныеБайты(Количество)
Перем Метаданные_;           // МетаданныеПровайдера или Неопределено (кэш)

#Область ПрограммныйИнтерфейс

// Параметры:
//   Конфигурация  - КонфигурацияПровайдера, Структура, Соответствие;
//   Сессия        - Сессия 1connector или её двойник;
//   Часы          - объект с методом Сейчас();
//   Генератор     - объект с методом СлучайныеБайты(Количество);
//   ПараметрыHTTP - Структура - ДополнительныеПараметры 1connector.
//
Процедура ПриСозданииОбъекта(Знач Конфигурация, Знач Сессия = Неопределено,
	Знач Часы = Неопределено, Знач Генератор = Неопределено, Знач ПараметрыHTTP = Неопределено)

	Описание = КОписаниюПровайдера(Конфигурация);

	// Издатель пуст только в OAuth2-ветке; для OIDC его требуют
	// КонфигурацияПровайдера.Проверить и явные проверки ниже
	Издатель_             = СокрЛП(Строка(НеобязательноеПоле(Описание, "Издатель", "")));
	ИдентификаторКлиента_ = ОбязательноеПоле(Описание, "ИдентификаторКлиента");
	АдресВозврата_        = НеобязательноеПоле(Описание, "АдресВозврата", "");
	СекретКлиента_        = НеобязательноеПоле(Описание, "СекретКлиента", "");
	Область_              = НеобязательноеПоле(Описание, "Область", "openid profile email");
	ЛюфтСекунд_           = Число(НеобязательноеПоле(Описание, "ЛюфтСекунд", 60));
	СпособАутентификации_ = НРег(СокрЛП(Строка(
		НеобязательноеПоле(Описание, "СпособАутентификацииКлиента", "client_secret_post"))));
	РучныеМетаданные_     = НеобязательноеПоле(Описание, "КонечныеТочки", Неопределено);

	// issuer храним ТОЧНО: по OIDC Core §3.1.3.7 клейм iss сравнивается побайтно,
	// завершающий "/" значим (Authentik: ".../application/o/<slug>/"). Нормализованная
	// копия — только для сборки URL discovery.
	БазаИздателя_ = Издатель_;
	Пока СтрЗаканчиваетсяНа(БазаИздателя_, "/") Цикл
		БазаИздателя_ = Лев(БазаИздателя_, СтрДлина(БазаИздателя_) - 1);
	КонецЦикла;

	Канал_     = Новый КаналHTTP(Сессия, ПараметрыHTTP);
	Часы_      = ?(Часы = Неопределено, Новый ЧасыСистемные, Часы);
	Генератор_ = ?(Генератор = Неопределено, Новый ГенераторСлучайности, Генератор);
	Метаданные_ = Неопределено;

КонецПроцедуры

// Загружает и кэширует документ discovery провайдера.
//
// Возвращаемое значение:
//   МетаданныеПровайдера
//
Функция ЗагрузитьМетаданные() Экспорт

	Если СтрДлина(БазаИздателя_) = 0 Тогда
		ВызватьИсключение "OIDC discovery: не задан Издатель (issuer) — адрес документа неизвестен";
	КонецЕсли;

	URL = БазаИздателя_ + "/.well-known/openid-configuration";
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Accept", "application/json");

	Ответ = Канал_.Получить(URL, Заголовки);
	Если Ответ.КодСостояния <> КодыСостоянияHTTP.ОК_200 Тогда
		ВызватьИсключение СтрШаблон("OIDC discovery: провайдер вернул код %1 на %2",
			Ответ.КодСостояния, URL);
	КонецЕсли;

	Метаданные_ = Новый МетаданныеПровайдера(JSONОбъект(Ответ, "документ discovery"));
	Возврат Метаданные_;

КонецФункции

// Задаёт метаданные вручную, без сети.
//
// Параметры:
//   Метаданные - МетаданныеПровайдера, Соответствие - сырой discovery.
//
// Возвращаемое значение:
//   МетаданныеПровайдера
//
Функция УстановитьМетаданные(Знач Метаданные) Экспорт

	Если ТипЗнч(Метаданные) = Тип("Соответствие") Тогда
		Метаданные_ = Новый МетаданныеПровайдера(Метаданные);
	ИначеЕсли Метаданные <> Неопределено Тогда
		Метаданные_ = Метаданные;
	Иначе
		ВызватьИсключение "OIDC: пустые метаданные";
	КонецЕсли;

	Возврат Метаданные_;

КонецФункции

// Метаданные: кэш, иначе ручные конечные точки, иначе discovery.
//
// Возвращаемое значение:
//   МетаданныеПровайдера
//
Функция Метаданные() Экспорт

	Если Метаданные_ <> Неопределено Тогда
		Возврат Метаданные_;
	КонецЕсли;

	Если ТипЗнч(РучныеМетаданные_) = Тип("Соответствие")
		И РучныеМетаданные_.Получить("token_endpoint") <> Неопределено Тогда
		Возврат МетаданныеИзРучныхТочек();
	КонецЕсли;

	Возврат ЗагрузитьМетаданные();

КонецФункции

// Начинает Authorization Code Flow: state, nonce, code_verifier, PKCE S256.
//
// Параметры:
//   ДополнительныеПараметры - Соответствие - доп. query-параметры.
//
// Возвращаемое значение:
//   ЗапросАвторизации - URL и секреты, которые вызывающий обязан сохранить.
//
Функция НачатьАвторизацию(Знач ДополнительныеПараметры = Неопределено) Экспорт

	Если СтрДлина(СокрЛП(АдресВозврата_)) = 0 Тогда
		ВызватьИсключение "OIDC: для авторизации не задан АдресВозврата (redirect_uri)";
	КонецЕсли;

	Состояние     = КодированиеBase64URL.Кодировать(Генератор_.СлучайныеБайты(16));
	Одноразовость = КодированиеBase64URL.Кодировать(Генератор_.СлучайныеБайты(16));
	ПроверочныйКод = PKCE.СоздатьПроверочныйКод(Генератор_);
	Вызов = PKCE.ВычислитьВызовS256(ПроверочныйКод);

	Параметры = Новый Соответствие;
	Параметры.Вставить("response_type", "code");
	Параметры.Вставить("client_id", ИдентификаторКлиента_);
	Параметры.Вставить("redirect_uri", АдресВозврата_);
	// пустой scope не отправляем вовсе: "scope=" часть серверов считает ошибкой
	Если СтрДлина(СокрЛП(Строка(Область_))) > 0 Тогда
		Параметры.Вставить("scope", Область_);
	КонецЕсли;
	Параметры.Вставить("state", Состояние);
	Параметры.Вставить("nonce", Одноразовость);
	Параметры.Вставить("code_challenge", Вызов);
	Параметры.Вставить("code_challenge_method", PKCE.МетодВызова());

	Если ТипЗнч(ДополнительныеПараметры) = Тип("Соответствие") Тогда
		Для Каждого КиЗ Из ДополнительныеПараметры Цикл
			Параметры.Вставить(Строка(КиЗ.Ключ), Строка(КиЗ.Значение));
		КонецЦикла;
	КонецЕсли;

	БазаURL = Метаданные().КонечнаяТочкаАвторизации();
	Разделитель = ?(СтрНайти(БазаURL, "?") > 0, "&", "?");
	URL = БазаURL + Разделитель + КодироватьПараметрыURL(Параметры);

	Возврат Новый ЗапросАвторизации(URL, Состояние, Одноразовость, ПроверочныйКод);

КонецФункции

// Обменивает код на токены (server-to-server POST). Аутентификация клиента —
// по СпособАутентификацииКлиента.
//
// Параметры:
//   Код            - Строка - authorization code;
//   ПроверочныйКод - Строка - code_verifier.
//
// Возвращаемое значение:
//   НаборТокенов
//
Функция ОбменятьКодНаТокены(Знач Код, Знач ПроверочныйКод) Экспорт

	Если СтрДлина(СокрЛП(Строка(Код))) = 0 Тогда
		ВызватьИсключение "OIDC: пустой код авторизации";
	КонецЕсли;

	Форма = Новый Соответствие;
	Форма.Вставить("grant_type", "authorization_code");
	Форма.Вставить("code", Код);
	Форма.Вставить("redirect_uri", АдресВозврата_);
	Форма.Вставить("client_id", ИдентификаторКлиента_);
	Форма.Вставить("code_verifier", ПроверочныйКод);

	// Accept задаём сами: GitHub без него отвечает формой, а не JSON
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Accept", "application/json");

	Если СпособАутентификации_ = "client_secret_basic" Тогда
		// RFC 6749 §2.3.1: каждый предварительно url-кодирован, иначе секрет
		// с ":" ломает разбор пары
		Пара = КодироватьSafe(ИдентификаторКлиента_) + ":" + КодироватьSafe(СекретКлиента_);
		Заголовки.Вставить("Authorization", "Basic " + БезПереводовСтрок(
			Base64Строка(ПолучитьДвоичныеДанныеИзСтроки(Пара, "UTF-8", Ложь))));
	ИначеЕсли СпособАутентификации_ <> "none" И СтрДлина(СекретКлиента_) > 0 Тогда
		Форма.Вставить("client_secret", СекретКлиента_);
	КонецЕсли;

	Ответ = Канал_.ОтправитьФорму(Метаданные().КонечнаяТочкаТокена(), Форма, Заголовки);

	Если Ответ.КодСостояния <> КодыСостоянияHTTP.ОК_200 Тогда
		ВызватьИсключение ОписаниеОшибкиТокена(Ответ);
	КонецЕсли;

	Возврат Новый НаборТокенов(JSONОбъект(Ответ, "ответ token endpoint"));

КонецФункции

// Запрашивает userinfo по токену доступа.
//
// Параметры:
//   ТокенДоступа - Строка - access_token.
//
// Возвращаемое значение:
//   Соответствие - клеймы userinfo.
//
Функция ПолучитьПрофиль(Знач ТокенДоступа) Экспорт

	Если СтрДлина(СокрЛП(Строка(ТокенДоступа))) = 0 Тогда
		ВызватьИсключение "OIDC: пустой токен доступа";
	КонецЕсли;

	КонечнаяТочка = Метаданные().КонечнаяТочкаПрофиля();
	Если КонечнаяТочка = Неопределено Тогда
		ВызватьИсключение "OIDC: провайдер не объявил userinfo_endpoint";
	КонецЕсли;

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Authorization", "Bearer " + ТокенДоступа);
	Заголовки.Вставить("Accept", "application/json");

	Ответ = Канал_.Получить(КонечнаяТочка, Заголовки);
	Если Ответ.КодСостояния <> КодыСостоянияHTTP.ОК_200 Тогда
		ВызватьИсключение СтрШаблон("OIDC userinfo: провайдер вернул код %1", Ответ.КодСостояния);
	КонецЕсли;

	Возврат JSONОбъект(Ответ, "ответ userinfo");

КонецФункции

// Проверяет id_token и возвращает клеймы. ПОДПИСЬ НЕ ПРОВЕРЯЕТСЯ (см. README):
// сверяются iss, aud, azp, exp, nbf и nonce.
//
// Параметры:
//   ИдентификационныйТокен - Строка - JWT;
//   ОжидаемаяОдноразовость - Строка - ожидаемый nonce; Неопределено — не сверять.
//
// Возвращаемое значение:
//   Соответствие - проверенные клеймы.
//
Функция ПроверитьИдентификационныйТокен(Знач ИдентификационныйТокен,
	Знач ОжидаемаяОдноразовость = Неопределено) Экспорт

	// без ожидаемого издателя сверка iss выродилась бы в "" = "" на токене без
	// клейма iss — принимать такой на веру нельзя
	Если СтрДлина(Издатель_) = 0 Тогда
		ВызватьИсключение "id_token: не задан Издатель (issuer) — сверить клейм iss не с чем";
	КонецЕсли;

	Клеймы = РазборJWT.ПрочитатьПолезнуюНагрузку(ИдентификационныйТокен);

	// iss
	Если Строка(Клеймы.Получить("iss")) <> Издатель_ Тогда
		ВызватьИсключение СтрШаблон("id_token: iss (%1) не совпадает с ожидаемым издателем (%2)",
			Клеймы.Получить("iss"), Издатель_);
	КонецЕсли;

	// aud (строка или массив)
	Если НЕ АудиторияСодержит(Клеймы.Получить("aud"), ИдентификаторКлиента_) Тогда
		ВызватьИсключение СтрШаблон("id_token: aud не содержит client_id (%1)", ИдентификаторКлиента_);
	КонецЕсли;

	// azp НЕобязателен, но если есть — обязан указывать на нас: чужой azp значит
	// токен, выписанный для другого приложения
	Azp = Клеймы.Получить("azp");
	Если Azp <> Неопределено И Строка(Azp) <> ИдентификаторКлиента_ Тогда
		ВызватьИсключение СтрШаблон("id_token: azp (%1) не совпадает с client_id (%2)",
			Azp, ИдентификаторКлиента_);
	КонецЕсли;

	СейчасUnix = ВUnix(Часы_.Сейчас());

	// exp — обязателен
	Exp = Клеймы.Получить("exp");
	Если ТипЗнч(Exp) <> Тип("Число") Тогда
		ВызватьИсключение "id_token: отсутствует или нечисловой клейм exp";
	КонецЕсли;
	Если СейчасUnix > Exp + ЛюфтСекунд_ Тогда
		ВызватьИсключение "id_token: истёк (exp в прошлом)";
	КонецЕсли;

	// nbf — если присутствует
	Nbf = Клеймы.Получить("nbf");
	Если ТипЗнч(Nbf) = Тип("Число") И СейчасUnix + ЛюфтСекунд_ < Nbf Тогда
		ВызватьИсключение "id_token: ещё не действителен (nbf в будущем)";
	КонецЕсли;

	// nonce
	Если ОжидаемаяОдноразовость <> Неопределено И СтрДлина(Строка(ОжидаемаяОдноразовость)) > 0 Тогда
		Если Строка(Клеймы.Получить("nonce")) <> Строка(ОжидаемаяОдноразовость) Тогда
			ВызватьИсключение "id_token: nonce не совпадает с ожидаемым";
		КонецЕсли;
	КонецЕсли;

	Возврат Клеймы;

КонецФункции

// Обмен кода + проверка id_token одним вызовом. Сверку state вызывающий
// выполняет сам, ДО этого метода.
//
// Параметры:
//   Код    - Строка - authorization code;
//   Запрос - ЗапросАвторизации - результат НачатьАвторизацию.
//
// Возвращаемое значение:
//   Структура - Токены, Клеймы.
//
Функция ЗавершитьАвторизацию(Знач Код, Знач Запрос) Экспорт

	Токены = ОбменятьКодНаТокены(Код, Запрос.ПроверочныйКод());

	ИдТокен = Токены.ИдентификационныйТокен();
	Если СтрДлина(СокрЛП(Строка(ИдТокен))) = 0 Тогда
		ВызватьИсключение "OIDC: token endpoint не вернул id_token";
	КонецЕсли;

	Клеймы = ПроверитьИдентификационныйТокен(ИдТокен, Запрос.Одноразовость());
	Возврат Новый Структура("Токены, Клеймы", Токены, Клеймы);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Query-строка URL авторизации: своя, потому что этот URL никуда не
// отправляется — на него уводят браузер.
Функция КодироватьПараметрыURL(Знач Параметры)
	Пары = Новый Массив;
	Для Каждого КиЗ Из Параметры Цикл
		Пары.Добавить(
			КодироватьSafe(Строка(КиЗ.Ключ)) + "=" + КодироватьSafe(Строка(КиЗ.Значение)));
	КонецЦикла;
	Возврат СтрСоединить(Пары, "&");
КонецФункции

Функция КодироватьSafe(Знач Значение)
	Возврат КодироватьСтроку(Значение, СпособКодированияСтроки.КодировкаURL);
КонецФункции

// Base64Строка переносит строки каждые 76 символов; в заголовке HTTP нельзя.
Функция БезПереводовСтрок(Знач Значение)
	Возврат СтрЗаменить(СтрЗаменить(Строка(Значение), Символы.ВК, ""), Символы.ПС, "");
КонецФункции

// Метаданные из ручных точек. issuer здесь необязателен (OAuth2), но заданный
// добирается из конфигурации.
Функция МетаданныеИзРучныхТочек()

	Копия = Новый Соответствие;
	Для Каждого КиЗ Из РучныеМетаданные_ Цикл
		Копия.Вставить(КиЗ.Ключ, КиЗ.Значение);
	КонецЦикла;
	Если Копия.Получить("issuer") = Неопределено И СтрДлина(Издатель_) > 0 Тогда
		Копия.Вставить("issuer", Издатель_);
	КонецЕсли;

	Метаданные_ = Новый МетаданныеПровайдера(Копия, Ложь);
	Возврат Метаданные_;

КонецФункции

// Конфигурация — модель либо сырые поля; дальше работаем с одним видом данных.
Функция КОписаниюПровайдера(Знач Конфигурация)

	Если ТипЗнч(Конфигурация) <> Тип("КонфигурацияПровайдера") Тогда
		Возврат Конфигурация;
	КонецЕсли;

	Описание = Конфигурация.КакСтруктуру();
	Описание.Вставить("КонечныеТочки", Конфигурация.КонечныеТочки());
	Возврат Описание;

КонецФункции

// Разбор — за 1connector; здесь только проверка, что пришёл объект.
Функция JSONОбъект(Знач Ответ, Знач Назначение)
	Данные = Канал_.JSON(Ответ, Назначение);
	Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		ВызватьИсключение "OIDC: ожидался JSON-объект (" + Назначение + ")";
	КонецЕсли;
	Возврат Данные;
КонецФункции

// Формирует сообщение об ошибке token endpoint из JSON error/error_description
// (RFC 6749 §5.2), при неразборчивом теле — из HTTP-кода.
Функция ОписаниеОшибкиТокена(Знач Ответ)

	Данные = Канал_.JSONИлиНеопределено(Ответ);

	Если ТипЗнч(Данные) = Тип("Соответствие") И Данные.Получить("error") <> Неопределено Тогда
		Описание = Данные.Получить("error_description");
		Возврат СтрШаблон("OIDC token endpoint: ошибка %1 (%2)%3",
			Данные.Получить("error"), Ответ.КодСостояния,
			?(Описание = Неопределено, "", ": " + Описание));
	КонецЕсли;

	Возврат СтрШаблон("OIDC token endpoint: провайдер вернул код %1", Ответ.КодСостояния);

КонецФункции

// client_id входит в aud (строка либо массив строк).
Функция АудиторияСодержит(Знач Аудитория, Знач Ожидаемый)
	Если ТипЗнч(Аудитория) = Тип("Строка") Тогда
		Возврат Аудитория = Ожидаемый;
	ИначеЕсли ТипЗнч(Аудитория) = Тип("Массив") Тогда
		Для Каждого Элемент Из Аудитория Цикл
			Если Строка(Элемент) = Ожидаемый Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Ложь;
КонецФункции

Функция ВUnix(Знач Момент)
	Возврат Момент - Дата(1970, 1, 1, 0, 0, 0);
КонецФункции

Функция ОбязательноеПоле(Знач Конфигурация, Знач Имя)
	Значение = ПрочитатьПолеКонфигурации(Конфигурация, Имя, Неопределено);
	Если Значение = Неопределено Или СтрДлина(СокрЛП(Строка(Значение))) = 0 Тогда
		ВызватьИсключение "OIDC: не задано обязательное поле конфигурации " + Имя;
	КонецЕсли;
	Возврат СокрЛП(Строка(Значение));
КонецФункции

Функция НеобязательноеПоле(Знач Конфигурация, Знач Имя, Знач ПоУмолчанию)
	Значение = ПрочитатьПолеКонфигурации(Конфигурация, Имя, Неопределено);
	Если Значение = Неопределено Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;
	Возврат Значение;
КонецФункции

Функция ПрочитатьПолеКонфигурации(Знач Конфигурация, Знач Имя, Знач ПоУмолчанию)
	Если ТипЗнч(Конфигурация) = Тип("Структура") Тогда
		Значение = ПоУмолчанию;
		Конфигурация.Свойство(Имя, Значение);
		Возврат Значение;
	ИначеЕсли ТипЗнч(Конфигурация) = Тип("Соответствие") Тогда
		Значение = Конфигурация.Получить(Имя);
		Возврат ?(Значение = Неопределено, ПоУмолчанию, Значение);
	КонецЕсли;
	ВызватьИсключение "OIDC: конфигурация должна быть Структурой или Соответствием";
КонецФункции

#КонецОбласти
