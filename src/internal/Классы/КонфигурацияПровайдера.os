// Описание одного провайдера: только протокольная часть — то, без чего нельзя
// сходить к провайдеру, и каждое поле библиотека использует. Состав полей
// описан в README.

Перем Имя_;
Перем Тип_;
Перем Издатель_;
Перем ИдентификаторКлиента_;
Перем СекретКлиента_;
Перем АдресВозврата_;
Перем Область_;
Перем ЛюфтСекунд_;
Перем СпособАутентификацииКлиента_;
Перем КонечныеТочки_;        // Соответствие сырых имён discovery → URL (может быть пустым)
Перем МаппингПрофиля_;       // Соответствие: Субъект/Email/EmailПодтверждён → имя клейма
Перем АлиасыКлеймов_;        // Соответствие: стандартное имя клейма → имя у провайдера
Перем ПараметрыАвторизации_; // Соответствие

#Область ПрограммныйИнтерфейс

Процедура ПриСозданииОбъекта(Знач Данные)

	Данные = РазвернутьПресет(Данные);

	Имя_ = НормализоватьИмя(Поле(Данные, "Имя", ""));
	Тип_ = НРег(СокрЛП(Строка(Поле(Данные, "Тип", ТипПоУмолчанию()))));

	Если ПоддерживаемыеТипы().Найти(Тип_) = Неопределено Тогда
		ВызватьИсключение СтрШаблон(
			"КонфигурацияПровайдера: неизвестный Тип ""%1"" (поддерживаются: %2)",
			Тип_, СтрСоединить(ПоддерживаемыеТипы(), ", "));
	КонецЕсли;

	Издатель_             = СокрЛП(Строка(Поле(Данные, "Издатель", "")));
	ИдентификаторКлиента_ = СокрЛП(Строка(Поле(Данные, "ИдентификаторКлиента", "")));
	СекретКлиента_        = Строка(Поле(Данные, "СекретКлиента", ""));
	АдресВозврата_        = СокрЛП(Строка(Поле(Данные, "АдресВозврата", "")));
	// scope OAuth2-провайдеров не стандартизован — умолчание есть только у OIDC
	ОбластьПоУмолчанию = ?(Тип_ = "oauth2", "", "openid profile email");
	Область_              = ЗначениеИлиУмолчание(Поле(Данные, "Область", ""), ОбластьПоУмолчанию);
	ЛюфтСекунд_           = Число(Поле(Данные, "ЛюфтСекунд", 60));
	СпособАутентификацииКлиента_ = НРег(СокрЛП(ЗначениеИлиУмолчание(
		Поле(Данные, "СпособАутентификацииКлиента", ""), "client_secret_post")));

	КонечныеТочки_        = НормализоватьКонечныеТочки(Поле(Данные, "КонечныеТочки", Неопределено));
	МаппингПрофиля_       = НормализоватьМаппингПрофиля(Поле(Данные, "МаппингПрофиля", Неопределено));
	АлиасыКлеймов_        = КСоответствию(Поле(Данные, "АлиасыКлеймов", Неопределено));
	ПараметрыАвторизации_ = КСоответствию(Поле(Данные, "ПараметрыАвторизации", Неопределено));

	Проверить();

КонецПроцедуры

// Идентификатор провайдера в реестре (нижний регистр).
Функция Имя() Экспорт
	Возврат Имя_;
КонецФункции

// Не Тип(): одноимённый со встроенной функцией метод не компилируется.
Функция ВидПротокола() Экспорт
	Возврат Тип_;
КонецФункции

// Издатель (issuer) — ожидаемое значение клейма iss.
Функция Издатель() Экспорт
	Возврат Издатель_;
КонецФункции

// client_id.
Функция ИдентификаторКлиента() Экспорт
	Возврат ИдентификаторКлиента_;
КонецФункции

// client_secret ("" — публичный клиент). НЕ логировать.
Функция СекретКлиента() Экспорт
	Возврат СекретКлиента_;
КонецФункции

// redirect_uri.
Функция АдресВозврата() Экспорт
	Возврат АдресВозврата_;
КонецФункции

// scope.
Функция Область() Экспорт
	Возврат Область_;
КонецФункции

// Допуск расхождения часов в секундах (exp/nbf).
Функция ЛюфтСекунд() Экспорт
	Возврат ЛюфтСекунд_;
КонецФункции

// Способ аутентификации клиента на token endpoint.
Функция СпособАутентификацииКлиента() Экспорт
	Возврат СпособАутентификацииКлиента_;
КонецФункции

// Ручные точки именами discovery либо Неопределено.
//
// Возвращаемое значение:
//   Соответствие, Неопределено
//
Функция КонечныеТочки() Экспорт

	Если КонечныеТочки_.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Копия = Новый Соответствие();
	Для Каждого КиЗ Из КонечныеТочки_ Цикл
		Копия.Вставить(КиЗ.Ключ, КиЗ.Значение);
	КонецЦикла;
	Если Копия.Получить("issuer") = Неопределено И СтрДлина(Издатель_) > 0 Тогда
		Копия.Вставить("issuer", Издатель_);
	КонецЕсли;
	Возврат Копия;

КонецФункции

// Заданы ли точки вручную (провайдер без discovery).
Функция ЕстьРучныеКонечныеТочки() Экспорт
	Возврат КонечныеТочки_.Получить("authorization_endpoint") <> Неопределено
		И КонечныеТочки_.Получить("token_endpoint") <> Неопределено;
КонецФункции

// Маппинг полей исхода на клеймы userinfo; незаданные — умолчания OIDC.
//
// Возвращаемое значение:
//   Соответствие (копия)
//
Функция МаппингПрофиля() Экспорт
	Копия = Новый Соответствие();
	Для Каждого КиЗ Из МаппингПрофиля_ Цикл
		Копия.Вставить(КиЗ.Ключ, КиЗ.Значение);
	КонецЦикла;
	Возврат Копия;
КонецФункции

// Алиасы клеймов: стандартное имя → имя у провайдера.
//
// Возвращаемое значение:
//   Соответствие (копия)
//
Функция АлиасыКлеймов() Экспорт
	Копия = Новый Соответствие();
	Для Каждого КиЗ Из АлиасыКлеймов_ Цикл
		Копия.Вставить(КиЗ.Ключ, КиЗ.Значение);
	КонецЦикла;
	Возврат Копия;
КонецФункции

// Постоянные доп. query-параметры URL авторизации.
//
// Возвращаемое значение:
//   Соответствие (копия)
//
Функция ПараметрыАвторизации() Экспорт
	Копия = Новый Соответствие();
	Для Каждого КиЗ Из ПараметрыАвторизации_ Цикл
		Копия.Вставить(КиЗ.Ключ, КиЗ.Значение);
	КонецЦикла;
	Возврат Копия;
КонецФункции

// Протокольные поля плоской Структурой.
//
// Возвращаемое значение:
//   Структура
//
Функция КакСтруктуру() Экспорт

	Результат = Новый Структура();
	Результат.Вставить("Имя", Имя_);
	Результат.Вставить("Тип", Тип_);
	Результат.Вставить("Издатель", Издатель_);
	Результат.Вставить("ИдентификаторКлиента", ИдентификаторКлиента_);
	Результат.Вставить("СекретКлиента", СекретКлиента_);
	Результат.Вставить("АдресВозврата", АдресВозврата_);
	Результат.Вставить("Область", Область_);
	Результат.Вставить("ЛюфтСекунд", ЛюфтСекунд_);
	Результат.Вставить("СпособАутентификацииКлиента", СпособАутентификацииКлиента_);
	Возврат Результат;

КонецФункции

// Виды протокола, которые модель принимает.
//
// Возвращаемое значение:
//   Массив из Строка
//
Функция ПоддерживаемыеТипы() Экспорт
	Результат = Новый Массив();
	Результат.Добавить("oidc");
	Результат.Добавить("oauth2");
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ТипПоУмолчанию()
	Возврат "oidc";
КонецФункции

// Разворачивает Пресет в описание. Явно заданные поля побеждают: пресет — это
// умолчания. Издатель GitHub не подставляется — он синтетический и служит
// ключом уже существующих привязок личности.
Функция РазвернутьПресет(Знач Данные)

	Ключ = НРег(СокрЛП(Строка(Поле(Данные, "Пресет", ""))));
	Если СтрДлина(Ключ) = 0 Тогда
		Возврат Данные;
	КонецЕсли;

	Результат = ПресетыПровайдеров.Описание(Ключ, Данные);
	Для Каждого КиЗ Из КСоответствию(Данные) Цикл
		Если Строка(КиЗ.Ключ) = "Пресет" Или КиЗ.Значение = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		// пустая строка = «не заполнено»: иначе незаполненная графа админки
		// стирала бы умолчание пресета
		Если ТипЗнч(КиЗ.Значение) = Тип("Строка") И СтрДлина(СокрЛП(КиЗ.Значение)) = 0 Тогда
			Продолжить;
		КонецЕсли;
		Результат.Вставить(Строка(КиЗ.Ключ), КиЗ.Значение);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Процедура Проверить()

	Отсутствуют = Новый Массив();
	Если СтрДлина(Имя_) = 0 Тогда
		Отсутствуют.Добавить("Имя");
	КонецЕсли;
	Если СтрДлина(ИдентификаторКлиента_) = 0 Тогда
		Отсутствуют.Добавить("ИдентификаторКлиента");
	КонецЕсли;
	Если СтрДлина(АдресВозврата_) = 0 Тогда
		Отсутствуют.Добавить("АдресВозврата");
	КонецЕсли;
	// Издатель обязателен только для OIDC: без него нечему сверять iss.
	// В OAuth2 id_token нет, издателя протокол не сообщает.
	Если Тип_ = "oidc" И СтрДлина(Издатель_) = 0 Тогда
		Отсутствуют.Добавить("Издатель");
	КонецЕсли;

	Если Отсутствуют.Количество() > 0 Тогда
		ВызватьИсключение СтрШаблон("КонфигурацияПровайдера: не заданы обязательные поля: %1",
			СтрСоединить(Отсутствуют, ", "));
	КонецЕсли;

	// в OAuth2 нет discovery, а субъект живёт только в userinfo
	Если Тип_ = "oauth2" Тогда
		НетТочек = Новый Массив();
		Если КонечныеТочки_.Получить("authorization_endpoint") = Неопределено Тогда
			НетТочек.Добавить("Авторизация (authorization_endpoint)");
		КонецЕсли;
		Если КонечныеТочки_.Получить("token_endpoint") = Неопределено Тогда
			НетТочек.Добавить("Токен (token_endpoint)");
		КонецЕсли;
		Если КонечныеТочки_.Получить("userinfo_endpoint") = Неопределено Тогда
			НетТочек.Добавить("Профиль (userinfo_endpoint)");
		КонецЕсли;
		Если НетТочек.Количество() > 0 Тогда
			ВызватьИсключение СтрШаблон(
				"КонфигурацияПровайдера: для типа oauth2 обязательны ручные КонечныеТочки, не заданы: %1",
				СтрСоединить(НетТочек, ", "));
		КонецЕсли;
	КонецЕсли;

	Если СпособыАутентификации().Найти(СпособАутентификацииКлиента_) = Неопределено Тогда
		ВызватьИсключение СтрШаблон(
			"КонфигурацияПровайдера: неизвестный СпособАутентификацииКлиента ""%1"" (поддерживаются: %2)",
			СпособАутентификацииКлиента_, СтрСоединить(СпособыАутентификации(), ", "));
	КонецЕсли;

	Если СпособАутентификацииКлиента_ = "client_secret_basic" И СтрДлина(СекретКлиента_) = 0 Тогда
		ВызватьИсключение "КонфигурацияПровайдера: client_secret_basic требует СекретКлиента";
	КонецЕсли;

КонецПроцедуры

Функция СпособыАутентификации()
	Результат = Новый Массив();
	Результат.Добавить("client_secret_post");
	Результат.Добавить("client_secret_basic");
	Результат.Добавить("none");
	Возврат Результат;
КонецФункции

// Ручные точки к сырым именам discovery: так они без переходников ложатся
// в МетаданныеПровайдера.
Функция НормализоватьКонечныеТочки(Знач Данные)

	Результат = Новый Соответствие();
	Источник = КСоответствию(Данные);

	// имя локальной переменной намеренно непохоже на глобальные свойства
	// контейнера: присваивание такому имени падает «is not writable»
	КартаИмён = Новый Соответствие();
	КартаИмён.Вставить("Авторизация", "authorization_endpoint");
	КартаИмён.Вставить("Токен", "token_endpoint");
	КартаИмён.Вставить("Профиль", "userinfo_endpoint");
	КартаИмён.Вставить("Ключи", "jwks_uri");
	КартаИмён.Вставить("Выход", "end_session_endpoint");
	КартаИмён.Вставить("Издатель", "issuer");
	КартаИмён.Вставить("Emails", "emails_endpoint");

	Для Каждого КиЗ Из Источник Цикл
		Ключ = Строка(КиЗ.Ключ);
		Сырое = КартаИмён.Получить(Ключ);
		Если Сырое = Неопределено Тогда
			Сырое = Ключ; // уже сырое имя discovery
		КонецЕсли;
		Значение = СокрЛП(Строка(КиЗ.Значение));
		Если СтрДлина(Значение) > 0 Тогда
			Результат.Вставить(Сырое, Значение);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Известные ключи + умолчания OIDC; неизвестный ключ — ошибка конфигурации.
Функция НормализоватьМаппингПрофиля(Знач Данные)

	Результат = Новый Соответствие();
	Результат.Вставить("Субъект", "sub");
	Результат.Вставить("Email", "email");
	Результат.Вставить("EmailПодтверждён", "email_verified");

	Источник = КСоответствию(Данные);
	Для Каждого КиЗ Из Источник Цикл
		Ключ = Строка(КиЗ.Ключ);
		Если Результат.Получить(Ключ) = Неопределено Тогда
			ВызватьИсключение СтрШаблон(
				"КонфигурацияПровайдера: неизвестный ключ МаппингПрофиля ""%1"" (поддерживаются: Субъект, Email, EmailПодтверждён)",
				Ключ);
		КонецЕсли;
		Значение = СокрЛП(Строка(КиЗ.Значение));
		Если СтрДлина(Значение) > 0 Тогда
			Результат.Вставить(Ключ, Значение);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция КСоответствию(Знач Данные)

	Результат = Новый Соответствие();
	Если ТипЗнч(Данные) = Тип("Соответствие") Тогда
		Для Каждого КиЗ Из Данные Цикл
			Результат.Вставить(КиЗ.Ключ, КиЗ.Значение);
		КонецЦикла;
	ИначеЕсли ТипЗнч(Данные) = Тип("Структура") Тогда
		Для Каждого КиЗ Из Данные Цикл
			Результат.Вставить(КиЗ.Ключ, КиЗ.Значение);
		КонецЦикла;
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция НормализоватьИмя(Знач Имя)
	Возврат НРег(СокрЛП(Строка(Имя)));
КонецФункции

Функция ЗначениеИлиУмолчание(Знач Значение, Знач ПоУмолчанию)
	Строковое = СокрЛП(Строка(?(Значение = Неопределено, "", Значение)));
	Возврат ?(СтрДлина(Строковое) > 0, Строковое, ПоУмолчанию);
КонецФункции

Функция Поле(Знач Данные, Знач Имя, Знач ПоУмолчанию)

	Если ТипЗнч(Данные) = Тип("Структура") Тогда
		Значение = Неопределено;
		Если Данные.Свойство(Имя, Значение) И Значение <> Неопределено Тогда
			Возврат Значение;
		КонецЕсли;
		Возврат ПоУмолчанию;
	ИначеЕсли ТипЗнч(Данные) = Тип("Соответствие") Тогда
		Значение = Данные.Получить(Имя);
		Возврат ?(Значение = Неопределено, ПоУмолчанию, Значение);
	КонецЕсли;

	ВызватьИсключение "КонфигурацияПровайдера: ожидается Структура или Соответствие с полями провайдера";

КонецФункции

#КонецОбласти
