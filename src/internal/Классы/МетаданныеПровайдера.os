// Конечные точки провайдера из документа discovery либо из ручных настроек.
// Обязательные поля проверяются при создании. ТребоватьИздателя = Ложь
// ослабляет только issuer — для OAuth2, где издателя не существует.

Перем Данные_; // Соответствие - сырые метаданные

Процедура ПриСозданииОбъекта(Знач Данные, Знач ТребоватьИздателя = Истина)

	Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		ВызватьИсключение "МетаданныеПровайдера: ожидается Соответствие с полями discovery";
	КонецЕсли;

	Если ТребоватьИздателя Тогда
		ПроверитьПоле(Данные, "issuer");
	КонецЕсли;
	ПроверитьПоле(Данные, "authorization_endpoint");
	ПроверитьПоле(Данные, "token_endpoint");

	Данные_ = Данные;

КонецПроцедуры

// Идентификатор издателя (issuer).
Функция Издатель() Экспорт
	Возврат Данные_.Получить("issuer");
КонецФункции

// Конечная точка авторизации (authorization_endpoint).
Функция КонечнаяТочкаАвторизации() Экспорт
	Возврат Данные_.Получить("authorization_endpoint");
КонецФункции

// Конечная точка обмена кода на токены (token_endpoint).
Функция КонечнаяТочкаТокена() Экспорт
	Возврат Данные_.Получить("token_endpoint");
КонецФункции

// Конечная точка сведений о пользователе (userinfo_endpoint); Неопределено, если нет.
Функция КонечнаяТочкаПрофиля() Экспорт
	Возврат Данные_.Получить("userinfo_endpoint");
КонецФункции

// jwks_uri — для внешней проверки подписи; сама библиотека её не делает.
Функция КонечнаяТочкаКлючей() Экспорт
	Возврат Данные_.Получить("jwks_uri");
КонецФункции

// end_session_endpoint (RP-Initiated Logout); Неопределено, если не объявлена.
Функция КонечнаяТочкаВыхода() Экспорт
	Возврат Данные_.Получить("end_session_endpoint");
КонецФункции

// Произвольное поле метаданных по имени или Неопределено.
//
// Параметры:
//   Ключ - Строка - имя поля discovery.
//
Функция Значение(Знач Ключ) Экспорт
	Возврат Данные_.Получить(Ключ);
КонецФункции

// Служебные

Процедура ПроверитьПоле(Знач Данные, Знач Имя)
	Значение = Данные.Получить(Имя);
	Если ТипЗнч(Значение) <> Тип("Строка") Или СтрДлина(СокрЛП(Значение)) = 0 Тогда
		ВызватьИсключение "МетаданныеПровайдера: отсутствует или пусто обязательное поле " + Имя;
	КонецЕсли;
КонецПроцедуры
