// Ответ token endpoint (RFC 6749 §5.1 + id_token).

Перем Данные_; // Соответствие - сырой ответ token endpoint

Процедура ПриСозданииОбъекта(Знач Данные)

	Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		ВызватьИсключение "НаборТокенов: ожидается Соответствие с ответом token endpoint";
	КонецЕсли;

	Данные_ = Данные;

КонецПроцедуры

// Токен доступа (access_token) для вызова userinfo и ресурсных API.
Функция ТокенДоступа() Экспорт
	Возврат Данные_.Получить("access_token");
КонецФункции

// Идентификационный токен (id_token, JWT) — сведения об аутентификации.
Функция ИдентификационныйТокен() Экспорт
	Возврат Данные_.Получить("id_token");
КонецФункции

// Токен обновления (refresh_token); Неопределено, если не выдан.
Функция ТокенОбновления() Экспорт
	Возврат Данные_.Получить("refresh_token");
КонецФункции

// Тип токена (token_type), обычно "Bearer".
Функция ТипТокена() Экспорт
	Возврат Данные_.Получить("token_type");
КонецФункции

// Срок жизни токена доступа в секундах (expires_in); Неопределено, если не задан.
Функция ЖивётСекунд() Экспорт
	Возврат Данные_.Получить("expires_in");
КонецФункции

// Выданные области (scope).
Функция Область() Экспорт
	Возврат Данные_.Получить("scope");
КонецФункции

// Возвращает произвольное поле ответа по имени или Неопределено.
Функция Значение(Знач Ключ) Экспорт
	Возврат Данные_.Получить(Ключ);
КонецФункции

// Сырой ответ копией — он и уезжает в исход входа.
Функция КакСоответствие() Экспорт
	Копия = Новый Соответствие;
	Для Каждого КиЗ Из Данные_ Цикл
		Копия.Вставить(КиЗ.Ключ, КиЗ.Значение);
	КонецЦикла;
	Возврат Копия;
КонецФункции
