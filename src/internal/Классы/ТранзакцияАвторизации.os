// Транзиентное состояние одной попытки входа: живёт между уходом браузера к
// провайдеру и возвратом на redirect_uri. Хранит его ПРИЛОЖЕНИЕ (см. README).
// Ключи представления читаются в любом регистре: хранилища нередко приводят их.

Перем Провайдер_;
Перем Состояние_;
Перем Одноразовость_;
Перем ПроверочныйКод_;
Перем Контекст_;
Перем URL_;

#Область ПрограммныйИнтерфейс

Процедура ПриСозданииОбъекта(Знач Данные)

	Провайдер_      = СокрЛП(Строка(Поле(Данные, "Провайдер", "")));
	Состояние_      = Строка(Поле(Данные, "Состояние", ""));
	Одноразовость_  = Строка(Поле(Данные, "Одноразовость", ""));
	ПроверочныйКод_ = Строка(Поле(Данные, "ПроверочныйКод", ""));
	Контекст_       = Поле(Данные, "Контекст", Неопределено);
	URL_            = Строка(Поле(Данные, "URL", ""));

	Если СтрДлина(Провайдер_) = 0 Тогда
		ВызватьИсключение "ТранзакцияАвторизации: не задан Провайдер";
	КонецЕсли;
	Если СтрДлина(Состояние_) = 0 Тогда
		ВызватьИсключение "ТранзакцияАвторизации: не задано Состояние (state)";
	КонецЕсли;

КонецПроцедуры

// Имя провайдера, к которому ушёл вход.
Функция Провайдер() Экспорт
	Возврат Провайдер_;
КонецФункции

// state (анти-CSRF).
Функция Состояние() Экспорт
	Возврат Состояние_;
КонецФункции

// nonce (привязка id_token к этому входу).
Функция Одноразовость() Экспорт
	Возврат Одноразовость_;
КонецФункции

// code_verifier PKCE.
Функция ПроверочныйКод() Экспорт
	Возврат ПроверочныйКод_;
КонецФункции

// Метка приложения; библиотека её не интерпретирует.
Функция Контекст() Экспорт
	Возврат Контекст_;
КонецФункции

// URL авторизации; заполнен только у свежей транзакции.
Функция URL() Экспорт
	Возврат URL_;
КонецФункции

// Представление для хранилища. URL сюда НЕ попадает: он длинный, содержит те же
// секреты и после редиректа бесполезен.
//
// Возвращаемое значение:
//   Соответствие
//
Функция КакСоответствие() Экспорт

	Результат = Новый Соответствие();
	Результат.Вставить("Провайдер", Провайдер_);
	Результат.Вставить("Состояние", Состояние_);
	Результат.Вставить("Одноразовость", Одноразовость_);
	Результат.Вставить("ПроверочныйКод", ПроверочныйКод_);
	Результат.Вставить("Контекст", Контекст_);
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Поле(Знач Данные, Знач Имя, Знач ПоУмолчанию)

	Если ТипЗнч(Данные) = Тип("Структура") Тогда
		Значение = Неопределено;
		Если Данные.Свойство(Имя, Значение) И Значение <> Неопределено Тогда
			Возврат Значение;
		КонецЕсли;
		Возврат ПоУмолчанию;
	ИначеЕсли ТипЗнч(Данные) = Тип("Соответствие") Тогда
		Значение = Данные.Получить(Имя);
		Если Значение <> Неопределено Тогда
			Возврат Значение;
		КонецЕсли;
		Искомое = НРег(Имя);
		Для Каждого КиЗ Из Данные Цикл
			Если НРег(Строка(КиЗ.Ключ)) = Искомое И КиЗ.Значение <> Неопределено Тогда
				Возврат КиЗ.Значение;
			КонецЕсли;
		КонецЦикла;
		Возврат ПоУмолчанию;
	КонецЕсли;

	ВызватьИсключение "ТранзакцияАвторизации: ожидается Структура или Соответствие с полями транзакции";

КонецФункции

#КонецОбласти
