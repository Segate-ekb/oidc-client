// Единственный шов рождения клиента: по виду протокола провайдера решает,
// каким классом его вести. Новая ветка протокола добавляется здесь.
// Кэша клиентов нет намеренно — клиент кэширует discovery внутри себя.

Перем Сессия_;
Перем Часы_;
Перем Генератор_;
Перем ПараметрыHTTP_;

#Область ПрограммныйИнтерфейс

// Параметры:
//   Сессия        - Сессия 1connector или её двойник;
//   Часы          - объект с методом Сейчас(); по умолчанию системные;
//   Генератор     - объект с методом СлучайныеБайты(Количество);
//   ПараметрыHTTP - Структура - ДополнительныеПараметры 1connector.
//
Процедура ПриСозданииОбъекта(Знач Сессия = Неопределено, Знач Часы = Неопределено,
	Знач Генератор = Неопределено, Знач ПараметрыHTTP = Неопределено)

	Сессия_        = Сессия;
	Часы_          = ?(Часы = Неопределено, Новый ЧасыСистемные, Часы);
	Генератор_     = ?(Генератор = Неопределено, Новый ГенераторСлучайности, Генератор);
	ПараметрыHTTP_ = ПараметрыHTTP;

КонецПроцедуры

// Клиент для провайдера по виду его протокола.
//
// Параметры:
//   Провайдер - КонфигурацияПровайдера, Структура, Соответствие.
//
// Возвращаемое значение:
//   КлиентOIDC, КлиентOAuth2.
//
Функция Клиент(Знач Провайдер) Экспорт

	Если ВидПротокола(Провайдер) = "oauth2" Тогда
		Возврат Новый КлиентOAuth2(Провайдер, Сессия_, Часы_, Генератор_, ПараметрыHTTP_);
	КонецЕсли;

	Возврат Новый КлиентOIDC(Провайдер, Сессия_, Часы_, Генератор_, ПараметрыHTTP_);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ВидПротокола(Знач Провайдер)

	Если ТипЗнч(Провайдер) = Тип("КонфигурацияПровайдера") Тогда
		Возврат Провайдер.ВидПротокола();
	ИначеЕсли ТипЗнч(Провайдер) = Тип("Структура") Тогда
		Значение = Неопределено;
		Если Провайдер.Свойство("Тип", Значение) И Значение <> Неопределено Тогда
			Возврат НРег(СокрЛП(Строка(Значение)));
		КонецЕсли;
	ИначеЕсли ТипЗнч(Провайдер) = Тип("Соответствие") Тогда
		Значение = Провайдер.Получить("Тип");
		Если Значение <> Неопределено Тогда
			Возврат НРег(СокрЛП(Строка(Значение)));
		КонецЕсли;
	КонецЕсли;

	Возврат "oidc";

КонецФункции

#КонецОбласти
