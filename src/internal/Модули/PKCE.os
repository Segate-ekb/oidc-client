// Proof Key for Code Exchange (RFC 7636), метод S256:
//   code_verifier  = base64url(случайные байты)
//   code_challenge = base64url(SHA-256(ASCII(code_verifier)))

// Создаёт code_verifier — base64url без дополнения (RFC 7636 §4.1: 43..128
// символов; 32 байта дают ровно 43).
//
// Параметры:
//   Генератор - объект с методом СлучайныеБайты(Количество);
//   ДлинаБайт - Число - 32..96, по умолчанию 32.
//
// Возвращаемое значение:
//   Строка
//
Функция СоздатьПроверочныйКод(Знач Генератор, Знач ДлинаБайт = 32) Экспорт

	Если Генератор = Неопределено Тогда
		ВызватьИсключение "PKCE: не задан генератор случайности";
	КонецЕсли;
	Если ТипЗнч(ДлинаБайт) <> Тип("Число") Или ДлинаБайт <> Цел(ДлинаБайт)
		Или ДлинаБайт < 32 Или ДлинаБайт > 96 Тогда
		ВызватьИсключение "PKCE: длина проверочного кода должна быть целым от 32 до 96 байт";
	КонецЕсли;

	Возврат КодированиеBase64URL.Кодировать(Генератор.СлучайныеБайты(ДлинаБайт));

КонецФункции

// Вычисляет code_challenge методом S256.
//
// Параметры:
//   ПроверочныйКод - Строка - code_verifier.
//
// Возвращаемое значение:
//   Строка - base64url без дополнения.
//
Функция ВычислитьВызовS256(Знач ПроверочныйКод) Экспорт

	Если ТипЗнч(ПроверочныйКод) <> Тип("Строка") Или СтрДлина(ПроверочныйКод) = 0 Тогда
		ВызватьИсключение "PKCE: проверочный код должен быть непустой строкой";
	КонецЕсли;

	Хеш = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеш.Добавить(ПолучитьДвоичныеДанныеИзСтроки(ПроверочныйКод, "UTF-8", Ложь));

	Возврат КодированиеBase64URL.Кодировать(
		ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(
			ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(Хеш.ХешСумма)));

КонецФункции

// Значение параметра code_challenge_method.
//
// Возвращаемое значение:
//   Строка - "S256"
//
Функция МетодВызова() Экспорт

	Возврат "S256";

КонецФункции
