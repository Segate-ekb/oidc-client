// base64url (RFC 4648 §5) без дополнения: алфавит "+"→"-", "/"→"_", "=" отброшено.
// Свой, а не встроенный Base64Строка: PKCE и сегменты JWT требуют именно его.

// Кодирует двоичные данные в base64url без дополнения.
//
// Параметры:
//   Данные - ДвоичныеДанные, БуферДвоичныхДанных.
//
// Возвращаемое значение:
//   Строка
//
Функция Кодировать(Знач Данные) Экспорт

	ДвоичныеЗначение = ВДвоичныеДанные(Данные);
	Строка64 = Base64Строка(ДвоичныеЗначение);

	Строка64 = СтрЗаменить(Строка64, Символы.ВК, "");
	Строка64 = СтрЗаменить(Строка64, Символы.ПС, "");
	Строка64 = СтрЗаменить(Строка64, "+", "-");
	Строка64 = СтрЗаменить(Строка64, "/", "_");
	Пока СтрЗаканчиваетсяНа(Строка64, "=") Цикл
		Строка64 = Лев(Строка64, СтрДлина(Строка64) - 1);
	КонецЦикла;

	Возврат Строка64;

КонецФункции

// Кодирует строку (UTF-8 без BOM) в base64url.
//
// Параметры:
//   Текст - Строка.
//
// Возвращаемое значение:
//   Строка
//
Функция КодироватьСтроку(Знач Текст) Экспорт

	Возврат Кодировать(ПолучитьДвоичныеДанныеИзСтроки(Строка(Текст), "UTF-8", Ложь));

КонецФункции

// Декодирует base64url (с дополнением или без).
//
// Параметры:
//   Текст - Строка.
//
// Возвращаемое значение:
//   ДвоичныеДанные
//
Функция Раскодировать(Знач Текст) Экспорт

	Если ТипЗнч(Текст) <> Тип("Строка") Тогда
		ВызватьИсключение "base64url: ожидается строка";
	КонецЕсли;

	Строка64 = СтрЗаменить(Текст, "-", "+");
	Строка64 = СтрЗаменить(Строка64, "_", "/");

	// отбросить возможное дополнение и проверить алфавит
	Пока СтрЗаканчиваетсяНа(Строка64, "=") Цикл
		Строка64 = Лев(Строка64, СтрДлина(Строка64) - 1);
	КонецЦикла;
	Алфавит = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
	Для Индекс = 1 По СтрДлина(Строка64) Цикл
		Если СтрНайти(Алфавит, Сред(Строка64, Индекс, 1)) = 0 Тогда
			ВызватьИсключение "base64url: недопустимый символ в позиции " + Индекс;
		КонецЕсли;
	КонецЦикла;

	// восстановить дополнение до кратности 4
	Остаток = СтрДлина(Строка64) % 4;
	Если Остаток = 1 Тогда
		ВызватьИсключение "base64url: недопустимая длина";
	ИначеЕсли Остаток > 0 Тогда
		Строка64 = Строка64 + Лев("==", 4 - Остаток);
	КонецЕсли;

	Возврат Base64Значение(Строка64);

КонецФункции

// Декодирует base64url и трактует результат как UTF-8.
//
// Параметры:
//   Текст - Строка.
//
// Возвращаемое значение:
//   Строка
//
Функция РаскодироватьВСтроку(Знач Текст) Экспорт

	Возврат ПолучитьСтрокуИзДвоичныхДанных(Раскодировать(Текст), "UTF-8");

КонецФункции

// Служебные

Функция ВДвоичныеДанные(Знач Значение)

	Если ТипЗнч(Значение) = Тип("ДвоичныеДанные") Тогда
		Возврат Значение;
	ИначеЕсли ТипЗнч(Значение) = Тип("БуферДвоичныхДанных") Тогда
		Возврат ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(Значение);
	КонецЕсли;

	ВызватьИсключение "base64url: ожидаются ДвоичныеДанные или БуферДвоичныхДанных";

КонецФункции
