// Умолчания популярных провайдеров: вид протокола, конечные точки, области,
// маппинг профиля и алиасы клеймов; учётных данных не касается. Заготовки
// собираются один раз на процесс и общие всем потокам — потребитель работает
// с копией (КопияОписания).

Перем Заготовки_;   // Строка → Структура

// Умолчания провайдера по ключу пресета. Отдаёт ОБЩУЮ заготовку — менять её
// нельзя, потребитель работает с копией.
//
// Параметры:
//   Ключ      - Строка - "github" | "gitlab" | "google";
//   Настройки - Структура, Соответствие - исходное описание (нужен БазовыйАдрес
//               для self-hosted GitLab).
//
// Возвращаемое значение:
//   Структура - поля описания провайдера.
//
Функция Описание(Знач Ключ, Знач Настройки = Неопределено) Экспорт

	Норм = НРег(СокрЛП(Строка(Ключ)));
	Готовое = ЗаготовкаПресета(Норм);

	Если Готовое = Неопределено Тогда
		ВызватьИсключение СтрШаблон(
			"ПресетыПровайдеров: неизвестный Пресет ""%1"" (поддерживаются: %2)",
			Строка(Ключ), СтрСоединить(Ключи(), ", "));
	КонецЕсли;

	// издатель GitLab считается по адресу инсталляции — в заготовке его нет
	Если Норм = "gitlab" Тогда
		Возврат СИздателемИнсталляции(Готовое, Настройки);
	КонецЕсли;

	Возврат Готовое;

КонецФункции

// Ключи поддерживаемых пресетов.
//
// Возвращаемое значение:
//   Массив из Строка.
//
Функция Ключи() Экспорт
	Результат = Новый Массив();
	Результат.Добавить("github");
	Результат.Добавить("gitlab");
	Результат.Добавить("google");
	Возврат Результат;
КонецФункции

// Собственная копия описания провайдера: вложенные карты копируются тоже,
// поэтому правка копии заготовку не задевает.
//
// Параметры:
//   Описание - Структура - то, что вернуло Описание().
//
// Возвращаемое значение:
//   Структура.
//
Функция КопияОписания(Знач Описание) Экспорт

	Если ТипЗнч(Описание) = Тип("Структура") Тогда
		Результат = Новый Структура();
	ИначеЕсли ТипЗнч(Описание) = Тип("Соответствие") Тогда
		Результат = Новый Соответствие();
	Иначе
		Возврат Описание;
	КонецЕсли;

	Для Каждого КиЗ Из Описание Цикл
		Результат.Вставить(КиЗ.Ключ, КопияОписания(КиЗ.Значение));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Служебные

Функция ЗаготовкаПресета(Знач Ключ)

	Готовые = Заготовки_;
	Если Готовые = Неопределено Тогда
		Готовые = Новый Соответствие();
		Готовые.Вставить("github", GitHub());
		Готовые.Вставить("gitlab", GitLab());
		Готовые.Вставить("google", Google());
		// присваивание последним: соседний поток видит либо Неопределено и
		// соберёт свою карту, либо полную — но никогда полупустую
		Заготовки_ = Готовые;
	КонецЕсли;

	Возврат Готовые.Получить(Ключ);

КонецФункции

// GitHub — чистый OAuth2: discovery нет, id_token не выдаётся, подтверждённый
// адрес живёт только в /user/emails.
Функция GitHub()

	Точки = Новый Соответствие();
	Точки.Вставить("Авторизация", "https://github.com/login/oauth/authorize");
	Точки.Вставить("Токен", "https://github.com/login/oauth/access_token");
	Точки.Вставить("Профиль", "https://api.github.com/user");
	Точки.Вставить("Emails", "https://api.github.com/user/emails");

	// login переименовывается, в привязку личности идёт неизменный id
	Маппинг = Новый Соответствие();
	Маппинг.Вставить("Субъект", "id");
	Маппинг.Вставить("Email", "email");
	Маппинг.Вставить("EmailПодтверждён", "email_verified");

	Результат = Новый Структура();
	Результат.Вставить("Тип", "oauth2");
	Результат.Вставить("Область", "read:user user:email");
	Результат.Вставить("КонечныеТочки", Точки);
	Результат.Вставить("МаппингПрофиля", Маппинг);
	Результат.Вставить("АлиасыКлеймов", АлиасыGitHub());
	Возврат Результат;

КонецФункции

// Профиль GitHub на словарь клеймов OIDC; сырые поля остаются рядом.
Функция АлиасыGitHub()
	Алиасы = Новый Соответствие();
	Алиасы.Вставить("sub", "id");
	Алиасы.Вставить("preferred_username", "login");
	Алиасы.Вставить("picture", "avatar_url");
	Алиасы.Вставить("profile", "html_url");
	Возврат Алиасы;
КонецФункции

Функция GitLab()
	Результат = Новый Структура();
	Результат.Вставить("Тип", "oidc");
	Результат.Вставить("Область", "openid profile email");
	Возврат Результат;
КонецФункции

// issuer GitLab = базовый адрес инсталляции без завершающего слеша.
Функция СИздателемИнсталляции(Знач Заготовка, Знач Настройки)

	Результат = КопияОписания(Заготовка);
	Результат.Вставить("Издатель",
		БезЗавершающегоСлеша(Строка(Поле(Настройки, "БазовыйАдрес", "https://gitlab.com"))));
	Возврат Результат;

КонецФункции

Функция Google()
	Результат = Новый Структура();
	Результат.Вставить("Тип", "oidc");
	Результат.Вставить("Издатель", "https://accounts.google.com");
	Результат.Вставить("Область", "openid profile email");
	Возврат Результат;
КонецФункции

Функция БезЗавершающегоСлеша(Знач Адрес)
	Результат = СокрЛП(Адрес);
	Пока СтрЗаканчиваетсяНа(Результат, "/") Цикл
		Результат = Лев(Результат, СтрДлина(Результат) - 1);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция Поле(Знач Данные, Знач Имя, Знач ПоУмолчанию)

	Если ТипЗнч(Данные) = Тип("Структура") Тогда
		Значение = Неопределено;
		Если Данные.Свойство(Имя, Значение) И Значение <> Неопределено Тогда
			Возврат Значение;
		КонецЕсли;
	ИначеЕсли ТипЗнч(Данные) = Тип("Соответствие") Тогда
		Значение = Данные.Получить(Имя);
		Если Значение <> Неопределено Тогда
			Возврат Значение;
		КонецЕсли;
	КонецЕсли;

	Возврат ПоУмолчанию;

КонецФункции
