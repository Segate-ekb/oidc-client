// Чтение сегментов JWT (JWS Compact, RFC 7519/7515) БЕЗ проверки подписи.
// Доверять разобранной нагрузке можно только если сам токен получен напрямую
// от token endpoint по TLS (см. README).

// Читает полезную нагрузку JWT. Подпись не проверяется.
//
// Параметры:
//   Токен - Строка - JWT в компактной форме.
//
// Возвращаемое значение:
//   Соответствие - клеймы.
//
Функция ПрочитатьПолезнуюНагрузку(Знач Токен) Экспорт

	Возврат РазобратьСегмент(Токен, 1, "полезная нагрузка");

КонецФункции

// Читает заголовок JWT (alg, typ, kid).
//
// Параметры:
//   Токен - Строка - JWT в компактной форме.
//
// Возвращаемое значение:
//   Соответствие
//
Функция ПрочитатьЗаголовок(Знач Токен) Экспорт

	Возврат РазобратьСегмент(Токен, 0, "заголовок");

КонецФункции

// Служебные

Функция РазобратьСегмент(Знач Токен, Знач Индекс, Знач Назначение)

	Если ТипЗнч(Токен) <> Тип("Строка") Или СтрДлина(Токен) = 0 Тогда
		ВызватьИсключение "JWT: токен должен быть непустой строкой";
	КонецЕсли;

	Части = СтрРазделить(Токен, ".", Истина);
	Если Части.Количество() <> 3 Тогда
		ВызватьИсключение "JWT: ожидается три сегмента, разделённых точкой";
	КонецЕсли;

	Попытка
		ТекстJSON = КодированиеBase64URL.РаскодироватьВСтроку(Части[Индекс]);
	Исключение
		ВызватьИсключение "JWT: не удалось раскодировать сегмент (" + Назначение + "): " + ОписаниеОшибки();
	КонецПопытки;

	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(ТекстJSON);
		Данные = ПрочитатьJSON(Чтение, Истина);
		Чтение.Закрыть();
	Исключение
		ВызватьИсключение "JWT: сегмент (" + Назначение + ") не является корректным JSON: " + ОписаниеОшибки();
	КонецПопытки;

	Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		ВызватьИсключение "JWT: сегмент (" + Назначение + ") не является JSON-объектом";
	КонецЕсли;

	Возврат Данные;

КонецФункции
