// Вход через провайдера OpenID Connect / OAuth 2.0. Один объект — один провайдер.
// Библиотека не хранит ничего: транзакцию между Начать и Завершить хранит
// приложение, оно же двигает браузер и ставит куки. См. README.

#Использовать "../internal"

Перем Провайдер_;      // КонфигурацияПровайдера
Перем Сессия_;         // Сессия 1connector или её двойник
Перем Часы_;           // объект с методом Сейчас()
Перем Генератор_;      // объект с методом СлучайныеБайты(Количество)
Перем ПараметрыHTTP_;  // ДополнительныеПараметры 1connector

#Область ПрограммныйИнтерфейс

// Параметры:
//   Провайдер - Структура, Соответствие, КонфигурацияПровайдера - описание
//               провайдера (состав полей — в README);
//   Настройки - Структура, Соответствие - необязательные Сессия, ПараметрыHTTP,
//               Часы, Генератор.
//
Процедура ПриСозданииОбъекта(Знач Провайдер, Знач Настройки = Неопределено)

	Если ТипЗнч(Провайдер) = Тип("КонфигурацияПровайдера") Тогда
		Провайдер_ = Провайдер;
	Иначе
		Провайдер_ = Новый КонфигурацияПровайдера(Провайдер);
	КонецЕсли;

	Сессия_        = Поле(Настройки, "Сессия", Неопределено);
	ПараметрыHTTP_ = Поле(Настройки, "ПараметрыHTTP", Неопределено);
	Часы_          = Поле(Настройки, "Часы", Неопределено);
	Генератор_     = Поле(Настройки, "Генератор", Неопределено);

КонецПроцедуры

// Имя провайдера, как оно задано в конфигурации.
Функция Имя() Экспорт
	Возврат Провайдер_.Имя();
КонецФункции

// Разрешённое описание провайдера: пресет развёрнут, БазовыйАдрес применён, умолчания
// подставлены. Нужно приложению, которое хранит конфигурацию у себя: развёрнутые пресетом
// издатель, точки и маппинг взять больше неоткуда, а издатель у приложения — половина
// ключа внешней личности. Конечные точки — заданные, а не вычитанные из discovery.
//
// Возвращаемое значение:
//   Структура - протокольные поля плюс КонечныеТочки, МаппингПрофиля, АлиасыКлеймов.
//
Функция Описание() Экспорт

	Результат = Провайдер_.КакСтруктуру();
	Результат.Вставить("КонечныеТочки", Провайдер_.КонечныеТочки());
	Результат.Вставить("МаппингПрофиля", Провайдер_.МаппингПрофиля());
	Результат.Вставить("АлиасыКлеймов", Провайдер_.АлиасыКлеймов());
	Возврат Результат;

КонецФункции

// Начинает вход: state, nonce, code_verifier, PKCE S256 и URL авторизации.
// Недоступный или неверно настроенный провайдер — исключение: это поломка
// настройки, а не исход входа.
//
// Параметры:
//   ДополнительныеПараметры - Структура, Соответствие - разовые query-параметры
//                             URL авторизации поверх постоянных.
//
// Возвращаемое значение:
//   Структура - URL (Строка, куда увести браузер), Транзакция (Соответствие,
//               сохранить до возврата; внутри секреты — см. README).
//
Функция Начать(Знач ДополнительныеПараметры = Неопределено) Экспорт

	Запрос = Клиент().НачатьАвторизацию(
		СлитьПараметры(Провайдер_.ПараметрыАвторизации(), ДополнительныеПараметры));

	Данные = Новый Структура();
	Данные.Вставить("Провайдер", Провайдер_.Имя());
	Данные.Вставить("Состояние", Запрос.Состояние());
	Данные.Вставить("Одноразовость", Запрос.Одноразовость());
	Данные.Вставить("ПроверочныйКод", Запрос.ПроверочныйКод());

	Возврат Новый Структура("URL, Транзакция",
		Запрос.URL(), Новый ТранзакцияАвторизации(Данные).КакСоответствие());

КонецФункции

// Завершает вход по возврату от провайдера. На исходах протокола исключений НЕ
// бросает — возвращает Успех = Ложь с различимой Причиной.
//
// Параметры:
//   Транзакция - Соответствие - то, что вернул Начать (ключи в любом регистре);
//   Код        - Строка - authorization code из query;
//   Состояние  - Строка - state из query.
//
// Возвращаемое значение:
//   Структура - Успех, Причина, Провайдер, Субъект, Издатель, Email,
//               EmailПодтверждён, Клеймы, Токены, ПрофильПолучен, ИсходДобораEmail,
//               СбойДобораEmail (состав, коды отказа и исходы добора — в README).
//
Функция Завершить(Знач Транзакция, Знач Код, Знач Состояние) Экспорт

	Ожидания = Ожидания(Транзакция);

	// state сверяется ДО сети: иначе по чужому редиректу мы сами обменяем
	// подсунутый код. Пустое ожидание совпадением не считается.
	Если НЕ СравнениеСекретов.НепустоеИРавно(Ожидания.Состояние, Состояние) Тогда
		Возврат Отказ("state_mismatch");
	КонецЕсли;

	Если НРег(СокрЛП(Ожидания.Провайдер)) <> Провайдер_.Имя() Тогда
		Возврат Отказ("unknown_provider");
	КонецЕсли;

	// сюда же попадают беды discovery: метаданные грузятся лениво
	Попытка
		Клиент = Клиент();
		Токены = Клиент.ОбменятьКодНаТокены(Код, Ожидания.ПроверочныйКод);
	Исключение
		Возврат Отказ("exchange_failed");
	КонецПопытки;

	Если Провайдер_.ВидПротокола() = "oauth2" Тогда
		Возврат ЗавершитьOAuth2(Клиент, Токены);
	КонецЕсли;

	Возврат ЗавершитьOIDC(Клиент, Токены, Ожидания.Одноразовость);

КонецФункции

// Адрес выхода у провайдера (RP-Initiated Logout 1.0). Пустая строка, а не
// исключение, если точки выхода нет (у OAuth2 не бывает никогда) или провайдер
// недоступен: свою сессию приложение гасит в любом случае.
//
// Параметры:
//   ИдентификационныйТокен - Строка - id_token этого входа → id_token_hint;
//   АдресПослеВыхода       - Строка - post_logout_redirect_uri.
//
// Возвращаемое значение:
//   Строка - URL выхода либо "".
//
Функция АдресВыхода(Знач ИдентификационныйТокен = "", Знач АдресПослеВыхода = "") Экспорт

	Попытка
		КонечнаяТочка = Клиент().Метаданные().КонечнаяТочкаВыхода();
	Исключение
		Возврат "";
	КонецПопытки;

	Если КонечнаяТочка = Неопределено Или СтрДлина(СокрЛП(Строка(КонечнаяТочка))) = 0 Тогда
		Возврат "";
	КонецЕсли;

	Параметры = Новый Соответствие();
	Если СтрДлина(СокрЛП(Строка(ИдентификационныйТокен))) > 0 Тогда
		Параметры.Вставить("id_token_hint", СокрЛП(Строка(ИдентификационныйТокен)));
	КонецЕсли;
	Если СтрДлина(СокрЛП(Строка(АдресПослеВыхода))) > 0 Тогда
		Параметры.Вставить("post_logout_redirect_uri", СокрЛП(Строка(АдресПослеВыхода)));
	КонецЕсли;
	// без client_id часть провайдеров не принимает post_logout_redirect_uri
	Параметры.Вставить("client_id", Провайдер_.ИдентификаторКлиента());

	Разделитель = ?(СтрНайти(КонечнаяТочка, "?") > 0, "&", "?");
	Возврат КонечнаяТочка + Разделитель + КодироватьПараметры(Параметры);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// На каждый вызов новый: клиент кэширует discovery, и вечный клиент вечно
// держал бы устаревшие конечные точки.
Функция Клиент()
	Возврат Новый ФабрикаКлиентов(Сессия_, Часы_, Генератор_, ПараметрыHTTP_).Клиент(Провайдер_);
КонецФункции

// id_token — единственный доверенный источник субъекта; userinfo с деградацией.
Функция ЗавершитьOIDC(Знач Клиент, Знач Токены, Знач ОжидаемаяОдноразовость)

	Попытка
		Клеймы = Клиент.ПроверитьИдентификационныйТокен(
			Токены.ИдентификационныйТокен(), ОжидаемаяОдноразовость);
	Исключение
		Возврат Отказ("id_token_invalid");
	КонецПопытки;

	Субъект = СокрЛП(Строка(ЗначениеКлейма(Клеймы, "sub")));
	Если СтрДлина(Субъект) = 0 Тогда
		Возврат Отказ("no_subject");
	КонецЕсли;

	Профиль = Новый Соответствие();
	ПрофильПолучен = Ложь;
	Попытка
		Ответ = Клиент.ПолучитьПрофиль(Токены.ТокенДоступа());
		// OIDC Core §5.3.2: чужой sub — подмена профиля; деградируем к клеймам
		// токена, а не подставляем чужой email в привязку личности
		Если СубъектСовпадает(Ответ, Субъект) Тогда
			Профиль = Ответ;
			ПрофильПолучен = Истина;
		КонецЕсли;
	Исключение
		Профиль = Новый Соответствие();
	КонецПопытки;

	ОбъединённыеКлеймы = Слить(Клеймы, Профиль);

	Результат = Успех(Субъект, ОбъединённыеКлеймы, Токены, ПрофильПолучен);
	Результат.Вставить("Email", Строка(ЗначениеКлейма(ОбъединённыеКлеймы, "email")));
	Результат.Вставить("EmailПодтверждён",
		ОбъединённыеКлеймы.Получить("email_verified") = Истина);
	Возврат Результат;

КонецФункции

// Порядок ОБРАТНЫЙ OIDC: сначала userinfo — субъект существует только там,
// поэтому деградации нет. За адресом идём, только когда вход уже состоялся.
Функция ЗавершитьOAuth2(Знач Клиент, Знач Токены)

	Попытка
		Профиль = Клиент.ПолучитьПрофиль(Токены.ТокенДоступа());
	Исключение
		Возврат Отказ("no_subject");
	КонецПопытки;

	Маппинг = Провайдер_.МаппингПрофиля();

	Субъект = КлеймКакСтрока(Профиль, Маппинг.Получить("Субъект"));
	Если СтрДлина(Субъект) = 0 Тогда
		Возврат Отказ("no_subject");
	КонецЕсли;

	Добор = Клиент.ДобратьEmail(Профиль, Токены.ТокенДоступа());

	Результат = Успех(Субъект, СоСтандартнымиИменами(Профиль), Токены, Истина);
	Результат.Вставить("Email", КлеймКакСтрока(Профиль, Маппинг.Получить("Email")));
	Результат.Вставить("EmailПодтверждён",
		Профиль.Получить(Маппинг.Получить("EmailПодтверждён")) = Истина);
	Результат.Вставить("ИсходДобораEmail", Добор.Исход);
	Результат.Вставить("СбойДобораEmail", Добор.Сбой);
	Возврат Результат;

КонецФункции

Функция Успех(Знач Субъект, Знач Клеймы, Знач Токены, Знач ПрофильПолучен)

	Результат = Новый Структура();
	Результат.Вставить("Успех", Истина);
	Результат.Вставить("Причина", "");
	Результат.Вставить("Провайдер", Провайдер_.Имя());
	Результат.Вставить("Субъект", Субъект);
	// Издатель — ИЗ КОНФИГУРАЦИИ: связка «личность = issuer + sub» обязана
	// опираться на доверенное значение, а не на клейм
	Результат.Вставить("Издатель", Провайдер_.Издатель());
	Результат.Вставить("Email", "");
	Результат.Вставить("EmailПодтверждён", Ложь);
	Результат.Вставить("Клеймы", Клеймы);
	Результат.Вставить("Токены", Токены.КакСоответствие());
	Результат.Вставить("ПрофильПолучен", ПрофильПолучен);
	// второй запрос за адресом делает только OAuth2-ветка; она же перепишет эти поля
	Результат.Вставить("ИсходДобораEmail", "not_needed");
	Результат.Вставить("СбойДобораEmail", "");
	Возврат Результат;

КонецФункции

Функция Отказ(Знач Причина)

	Результат = Новый Структура();
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Причина", Причина);
	Результат.Вставить("Провайдер", Провайдер_.Имя());
	Результат.Вставить("Субъект", "");
	Результат.Вставить("Издатель", "");
	Результат.Вставить("Email", "");
	Результат.Вставить("EmailПодтверждён", Ложь);
	Результат.Вставить("Клеймы", Новый Соответствие());
	Результат.Вставить("Токены", Новый Соответствие());
	Результат.Вставить("ПрофильПолучен", Ложь);
	Результат.Вставить("ИсходДобораEmail", "not_needed");
	Результат.Вставить("СбойДобораEmail", "");
	Возврат Результат;

КонецФункции

// Пустая или битая транзакция даёт пустые ожидания и упирается в проверку state.
Функция Ожидания(Знач Транзакция)

	Если Транзакция = Неопределено Тогда
		Возврат Новый Структура("Провайдер, Состояние, Одноразовость, ПроверочныйКод",
			"", "", "", "");
	КонецЕсли;

	Если ТипЗнч(Транзакция) = Тип("ТранзакцияАвторизации") Тогда
		Модель = Транзакция;
	Иначе
		Попытка
			Модель = Новый ТранзакцияАвторизации(Транзакция);
		Исключение
			Возврат Новый Структура("Провайдер, Состояние, Одноразовость, ПроверочныйКод",
				"", "", "", "");
		КонецПопытки;
	КонецЕсли;

	Возврат Новый Структура("Провайдер, Состояние, Одноразовость, ПроверочныйКод",
		Модель.Провайдер(), Модель.Состояние(),
		Модель.Одноразовость(), Модель.ПроверочныйКод());

КонецФункции

// Дописывает стандартные имена клеймов OIDC поверх сырых имён провайдера.
// Сырые поля остаются; своё значение провайдера алиас не перебивает.
Функция СоСтандартнымиИменами(Знач Профиль)

	Алиасы = Провайдер_.АлиасыКлеймов();
	Если Алиасы.Количество() = 0 Или ТипЗнч(Профиль) <> Тип("Соответствие") Тогда
		Возврат Профиль;
	КонецЕсли;

	Результат = Новый Соответствие();
	Для Каждого КиЗ Из Профиль Цикл
		Результат.Вставить(КиЗ.Ключ, КиЗ.Значение);
	КонецЦикла;

	Для Каждого КиЗ Из Алиасы Цикл
		Стандартное = Строка(КиЗ.Ключ);
		Если Результат.Получить(Стандартное) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Значение = Профиль.Получить(Строка(КиЗ.Значение));
		Если Значение <> Неопределено Тогда
			Результат.Вставить(Стандартное, Значение);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// XMLСтрока для чисел — гарантированно без разделителей групп и локали
// (в 1С:Предприятии Строка(Число) их разделяет).
Функция КлеймКакСтрока(Знач Клеймы, Знач Имя)

	Значение = Клеймы.Получить(Имя);
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат XMLСтрока(Значение);
	КонецЕсли;
	Возврат СокрЛП(Строка(Значение));

КонецФункции

// Профиль БЕЗ sub принимается: провайдеры (Authentik, Gitea) его не отдают, а
// ответ получен по токену этого же входа. Ловим подмену, а не неполноту.
Функция СубъектСовпадает(Знач Профиль, Знач Субъект)

	Если ТипЗнч(Профиль) <> Тип("Соответствие") Тогда
		Возврат Ложь;
	КонецЕсли;

	СубъектПрофиля = СокрЛП(Строка(ЗначениеКлейма(Профиль, "sub")));
	Если СтрДлина(СубъектПрофиля) = 0 Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат СравнениеСекретов.БезопасноеРавенство(СубъектПрофиля, Субъект);

КонецФункции

// userinfo перекрывает id_token: актуальные email и группы приходят оттуда.
Функция Слить(Знач КлеймыТокена, Знач Профиль)

	Результат = Новый Соответствие();
	Если ТипЗнч(КлеймыТокена) = Тип("Соответствие") Тогда
		Для Каждого КиЗ Из КлеймыТокена Цикл
			Результат.Вставить(КиЗ.Ключ, КиЗ.Значение);
		КонецЦикла;
	КонецЕсли;
	Если ТипЗнч(Профиль) = Тип("Соответствие") Тогда
		Для Каждого КиЗ Из Профиль Цикл
			Результат.Вставить(КиЗ.Ключ, КиЗ.Значение);
		КонецЦикла;
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеКлейма(Знач Клеймы, Знач Имя)
	Значение = Клеймы.Получить(Имя);
	Возврат ?(Значение = Неопределено, "", Значение);
КонецФункции

Функция СлитьПараметры(Знач Постоянные, Знач Разовые)

	Результат = Новый Соответствие();
	Для Каждого КиЗ Из Постоянные Цикл
		Результат.Вставить(Строка(КиЗ.Ключ), КиЗ.Значение);
	КонецЦикла;

	Если ТипЗнч(Разовые) = Тип("Соответствие") Или ТипЗнч(Разовые) = Тип("Структура") Тогда
		Для Каждого КиЗ Из Разовые Цикл
			Результат.Вставить(Строка(КиЗ.Ключ), КиЗ.Значение);
		КонецЦикла;
	КонецЕсли;

	Возврат ?(Результат.Количество() = 0, Неопределено, Результат);

КонецФункции

Функция КодироватьПараметры(Знач Параметры)
	Пары = Новый Массив();
	Для Каждого КиЗ Из Параметры Цикл
		Пары.Добавить(КодироватьСтроку(Строка(КиЗ.Ключ), СпособКодированияСтроки.КодировкаURL)
			+ "=" + КодироватьСтроку(Строка(КиЗ.Значение), СпособКодированияСтроки.КодировкаURL));
	КонецЦикла;
	Возврат СтрСоединить(Пары, "&");
КонецФункции

Функция Поле(Знач Данные, Знач Имя, Знач ПоУмолчанию)

	Если ТипЗнч(Данные) = Тип("Структура") Тогда
		Значение = Неопределено;
		Если Данные.Свойство(Имя, Значение) И Значение <> Неопределено Тогда
			Возврат Значение;
		КонецЕсли;
	ИначеЕсли ТипЗнч(Данные) = Тип("Соответствие") Тогда
		Значение = Данные.Получить(Имя);
		Если Значение <> Неопределено Тогда
			Возврат Значение;
		КонецЕсли;
	КонецЕсли;

	Возврат ПоУмолчанию;

КонецФункции

#КонецОбласти
