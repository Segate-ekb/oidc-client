// Умолчания пресетов провайдеров для чтения снаружи. Отдаёт копию: приложение
// правит полученное под себя, пресеты библиотеки от этого не меняются.

#Использовать "../internal"

#Область ПрограммныйИнтерфейс

// Ключи поддерживаемых пресетов.
//
// Возвращаемое значение:
//   Массив из Строка.
//
Функция Ключи() Экспорт
	Возврат ПресетыПровайдеров.Ключи();
КонецФункции

// Умолчания пресета — те же значения, что пресет подставляет в описание
// провайдера. Состав полей задаёт сам пресет: Тип и Область есть всегда,
// Издатель, КонечныеТочки, МаппингПрофиля и АлиасыКлеймов — где они заданы.
// Неизвестный ключ отклоняется исключением.
//
// Параметры:
//   Ключ      - Строка - один из Ключи();
//   Настройки - Структура, Соответствие - исходное описание провайдера (нужен
//               БазовыйАдрес для самостоятельной инсталляции GitLab).
//
// Возвращаемое значение:
//   Структура - копия умолчаний, правка которой не влияет на библиотеку.
//
Функция Умолчания(Знач Ключ, Знач Настройки = Неопределено) Экспорт
	Возврат ПресетыПровайдеров.КопияОписания(ПресетыПровайдеров.Описание(Ключ, Настройки));
КонецФункции

#КонецОбласти
