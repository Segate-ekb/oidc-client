// Детерминированный СлучайныеБайты(Количество). Без аргумента — счётчик
// (байт[i] = (Смещение + i) mod 256, смещение растёт), с буфером — всегда
// заданные байты.

Перем Шаблон_;   // БуферДвоичныхДанных или Неопределено
Перем Смещение_; // Число - для режима-счётчика

Процедура ПриСозданииОбъекта(Знач Байты = Неопределено)
	УстановитьБайты(Байты);
КонецПроцедуры

// Переключает генератор в режим фиксированного буфера (или в режим-счётчик,
// если передано Неопределено). Нужен, когда фикстура создаётся через
// ЗагрузитьСценарий (без аргументов конструктора).
Процедура УстановитьБайты(Знач Байты) Экспорт
	Если Байты = Неопределено Тогда
		Шаблон_ = Неопределено;
	Иначе
		Шаблон_ = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(Байты);
	КонецЕсли;
	Смещение_ = 0;
КонецПроцедуры

Функция СлучайныеБайты(Знач Количество) Экспорт

	Буфер = Новый БуферДвоичныхДанных(Количество);

	Если Шаблон_ = Неопределено Тогда
		Для Индекс = 0 По Количество - 1 Цикл
			Буфер[Индекс] = (Смещение_ + Индекс) % 256;
		КонецЦикла;
		Смещение_ = Смещение_ + Количество;
	Иначе
		Для Индекс = 0 По Количество - 1 Цикл
			Буфер[Индекс] = Шаблон_[Индекс % Шаблон_.Размер];
		КонецЦикла;
	КонецЕсли;

	Возврат ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(Буфер);

КонецФункции
