// Двойник ответа 1connector: КодСостояния, URL, Текст(), Json().
// Заполняется через Установить — ЗагрузитьСценарий не передаёт аргументы
// конструктора.

Перем КодСостояния Экспорт; // Число
Перем URL Экспорт;          // Строка

Перем Тело_;

Процедура ПриСозданииОбъекта()
	Установить(200, "", "");
КонецПроцедуры

// Задаёт содержимое ответа.
Процедура Установить(Знач Код, Знач Тело, Знач АдресЗапроса = "") Экспорт
	КодСостояния = Код;
	URL = АдресЗапроса;
	Тело_ = ?(Тело = Неопределено, "", Строка(Тело));
КонецПроцедуры

Функция Текст(Знач КодировкаТекста = Неопределено) Экспорт
	Возврат Тело_;
КонецФункции

Функция Json() Экспорт
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Тело_);
	Данные = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Возврат Данные;
КонецФункции
