// Двойник сессии 1connector: ВызватьМетод(Метод, URL, ДополнительныеПараметры)
// → ОтветФейковый. Совпадение по URL без query. Запоминает последний запрос —
// поля формы здесь ещё НЕ закодированы: кодирование делает 1connector, и
// проверять его тесты этой библиотеки не должны. Умеет обрывать запросы
// исключением, как 1connector, когда запрос не состоялся, и считает запросы.

Перем Ответы_;  // Соответствие "МЕТОД URL" → Структура(Код, Тело)
Перем Обрывы_;  // Соответствие "МЕТОД URL" → Структура(Осталось, Текст)
Перем Запросы_; // Соответствие "МЕТОД URL" → Число

Перем ПоследнийМетод_;
Перем ПоследнийURL_;
Перем ПоследниеДанные_;
Перем ПоследниеЗаголовки_;

Процедура ПриСозданииОбъекта()
	Ответы_ = Новый Соответствие;
	Обрывы_ = Новый Соответствие;
	Запросы_ = Новый Соответствие;
	ПоследниеЗаголовки_ = Новый Соответствие;
КонецПроцедуры

// Регистрирует ответ на GET по указанному URL.
Процедура ПриGET(Знач URL, Знач Код, Знач Тело) Экспорт
	Ответы_.Вставить(Ключ("GET", URL), Новый Структура("Код, Тело", Код, Тело));
КонецПроцедуры

// Регистрирует ответ на POST по указанному URL.
Процедура ПриPOST(Знач URL, Знач Код, Знач Тело) Экспорт
	Ответы_.Вставить(Ключ("POST", URL), Новый Структура("Код, Тело", Код, Тело));
КонецПроцедуры

// Первые Количество запросов Метод URL не состоятся: вместо ответа — исключение
// с текстом ТекстОшибки, как у 1connector при обрыве или таймауте.
Процедура Оборвать(Знач Метод, Знач URL, Знач Количество, Знач ТекстОшибки) Экспорт
	Обрывы_.Вставить(Ключ(Метод, URL), Новый Структура("Осталось, Текст", Количество, ТекстОшибки));
КонецПроцедуры

// Сколько раз вызывался Метод URL, включая оборванные.
Функция ЧислоЗапросов(Знач Метод, Знач URL) Экспорт
	Число = Запросы_.Получить(Ключ(Метод, URL));
	Возврат ?(Число = Неопределено, 0, Число);
КонецФункции

// Контракт сессии 1connector.
Функция ВызватьМетод(Знач Метод, Знач URL, Знач ДополнительныеПараметры = Неопределено) Экспорт

	ЗапомнитьЗапрос(Метод, URL, ДополнительныеПараметры);
	Запросы_.Вставить(Ключ(Метод, URL), ЧислоЗапросов(Метод, URL) + 1);

	Обрыв = Обрывы_.Получить(Ключ(Метод, URL));
	Если Обрыв <> Неопределено И Обрыв.Осталось > 0 Тогда
		Обрыв.Осталось = Обрыв.Осталось - 1;
		ВызватьИсключение Обрыв.Текст;
	КонецЕсли;

	Ответ = Ответы_.Получить(Ключ(Метод, URL));
	Если Ответ = Неопределено Тогда
		ВызватьИсключение СтрШаблон("СессияФейковая: не зарегистрирован ответ %1 для %2", Метод, URL);
	КонецЕсли;

	Результат = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "ОтветФейковый.os"));
	Результат.Установить(Ответ.Код, Ответ.Тело, URL);
	Возврат Результат;

КонецФункции

// URL последнего запроса (Неопределено, если запросов не было).
Функция ПоследнийURL() Экспорт
	Возврат ПоследнийURL_;
КонецФункции

// HTTP-метод последнего запроса.
Функция ПоследнийМетод() Экспорт
	Возврат ПоследнийМетод_;
КонецФункции

// Поля формы последнего запроса (Соответствие) или Неопределено, если тела не было.
Функция ПоследниеДанные() Экспорт
	Возврат ПоследниеДанные_;
КонецФункции

// Значение поля формы последнего запроса по имени (или Неопределено).
Функция ПолеФормы(Знач Имя) Экспорт
	Возврат ?(ПоследниеДанные_ = Неопределено, Неопределено, ПоследниеДанные_.Получить(Имя));
КонецФункции

// Значение заголовка последнего запроса по имени (или Неопределено).
Функция ЗаголовокПоследнего(Знач Имя) Экспорт
	Возврат ПоследниеЗаголовки_.Получить(Имя);
КонецФункции

// --- Служебные ---

Процедура ЗапомнитьЗапрос(Знач Метод, Знач URL, Знач ДополнительныеПараметры)

	ПоследнийМетод_ = Метод;
	ПоследнийURL_   = URL;
	ПоследниеДанные_ = Неопределено;
	ПоследниеЗаголовки_ = Новый Соответствие;

	Если ТипЗнч(ДополнительныеПараметры) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;

	Значение = Неопределено;
	Если ДополнительныеПараметры.Свойство("Данные", Значение) И Значение <> Неопределено Тогда
		ПоследниеДанные_ = Значение;
	КонецЕсли;
	Если ДополнительныеПараметры.Свойство("Заголовки", Значение)
		И ТипЗнч(Значение) = Тип("Соответствие") Тогда
		ПоследниеЗаголовки_ = Значение;
	КонецЕсли;

КонецПроцедуры

Функция Ключ(Знач Метод, Знач URL)
	Позиция = СтрНайти(URL, "?");
	Возврат ВРег(Строка(Метод)) + " " + ?(Позиция > 0, Лев(URL, Позиция - 1), URL);
КонецФункции
