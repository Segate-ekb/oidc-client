// Управляемые часы: контракт Сейчас() → Дата, момент задаётся вручную.
// Живут в тестах, а не в библиотеке: продакшену двойник не нужен.

Перем Момент_; // Дата (UTC)

Процедура ПриСозданииОбъекта(НачальныйМомент = Неопределено)
	Момент_ = ?(НачальныйМомент = Неопределено, Дата(2026, 1, 1, 12, 0, 0), НачальныйМомент);
КонецПроцедуры

// Возвращает текущий момент управляемых часов.
Функция Сейчас() Экспорт
	Возврат Момент_;
КонецФункции

// Устанавливает момент времени.
Процедура УстановитьМомент(Знач Момент) Экспорт
	Момент_ = Момент;
КонецПроцедуры

// Продвигает часы вперёд на заданное число секунд.
Процедура Прибавить(Знач Секунд) Экспорт
	Момент_ = Момент_ + Секунд;
КонецПроцедуры
