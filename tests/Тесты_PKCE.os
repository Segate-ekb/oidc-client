#Использовать "../"
#Использовать "../src/internal"
#Использовать asserts

// Тесты модуля PKCE: сверка с эталонным вектором RFC 7636 (Appendix B),
// генерация проверочного кода, границы и негативные случаи.

&Тест
Процедура ВекторRFC7636AppendixB() Экспорт

	// RFC 7636, Appendix B: заданный code_verifier → заданный code_challenge (S256)
	Верификатор = "dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk";
	Ожидаемый  = "E9Melhoa2OwvFrEMTJguCHaoeK1t8URWbuGJSstw-cM";

	Ожидаем.Что(PKCE.ВычислитьВызовS256(Верификатор)).Равно(Ожидаемый);

КонецПроцедуры

&Тест
Процедура МетодВызоваS256() Экспорт

	Ожидаем.Что(PKCE.МетодВызова()).Равно("S256");

КонецПроцедуры

&Тест
Процедура ПроверочныйКодИз32БайтДаёт43Символа() Экспорт

	Генератор = НовыйГенератор();
	Код = PKCE.СоздатьПроверочныйКод(Генератор, 32);

	// base64url без дополнения от 32 байт = 43 символа
	Ожидаем.Что(СтрДлина(Код)).Равно(43);
	Ожидаем.Что(СтрНайти(Код, "=")).Равно(0);
	Ожидаем.Что(ТолькоUnreservedСимволы(Код)).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПроверочныйКодРавенBase64URLОтБайтГенератора() Экспорт

	// фиксируем байты генератора и сверяем, что verifier = base64url(этих байт)
	Байты = ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(Новый БуферДвоичныхДанных(32));
	Генератор = НовыйГенератор();
	Генератор.УстановитьБайты(Байты);

	Код = PKCE.СоздатьПроверочныйКод(Генератор, 32);
	Ожидаем.Что(Код).Равно(КодированиеBase64URL.Кодировать(Байты));

КонецПроцедуры

&Тест
Процедура СоздатьПроверочныйКодБезГенератораВызываетИсключение() Экспорт

	Ожидаем.Что(БылоИсключениеСоздания(Неопределено, 32)).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура СоздатьПроверочныйКодСНедопустимойДлинойВызываетИсключение() Экспорт

	Генератор = НовыйГенератор();
	Ожидаем.Что(БылоИсключениеСоздания(Генератор, 16)).ЭтоИстина();  // < 32
	Ожидаем.Что(БылоИсключениеСоздания(Генератор, 200)).ЭтоИстина(); // > 96

КонецПроцедуры

&Тест
Процедура ВычислитьВызовОтПустогоВызываетИсключение() Экспорт

	Попытка
		PKCE.ВычислитьВызовS256("");
		Ожидаем.Что(Ложь, "ожидалось исключение на пустой проверочный код").ЭтоИстина();
	Исключение
		Ожидаем.Что(Истина).ЭтоИстина();
	КонецПопытки;

КонецПроцедуры

// --- Служебные ---

Функция НовыйГенератор()
	Возврат ЗагрузитьСценарий(ПутьФикстуры("ГенераторФиксированный.os"));
КонецФункции

Функция ТолькоUnreservedСимволы(Знач Строка_)
	Алфавит = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_";
	Для Индекс = 1 По СтрДлина(Строка_) Цикл
		Если СтрНайти(Алфавит, Сред(Строка_, Индекс, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

Функция БылоИсключениеСоздания(Знач Генератор, Знач Длина)
	Попытка
		PKCE.СоздатьПроверочныйКод(Генератор, Длина);
	Исключение
		Возврат Истина;
	КонецПопытки;
	Возврат Ложь;
КонецФункции

Функция ПутьФикстуры(Знач Имя)
	Файл = Новый Файл(ТекущийСценарий().Источник);
	Возврат ОбъединитьПути(Файл.Путь, "fixtures", Имя);
КонецФункции
