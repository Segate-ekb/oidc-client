#Использовать "../"
#Использовать "../src/internal"
#Использовать asserts

// Тесты сборки URL авторизации (Authorization Code Flow + PKCE): состав
// параметров, согласованность code_challenge с проверочным кодом, доп.
// параметры, разделитель, отсутствие redirect_uri.

&Тест
Процедура URLСодержитВсеОбязательныеПараметры() Экспорт

	Клиент = НовыйКлиент();
	Запрос = Клиент.НачатьАвторизацию();
	URL = Запрос.URL();

	Ожидаем.Что(СтрНачинаетсяС(URL, "https://idp.example.com/authorize?")).ЭтоИстина();
	Ожидаем.Что(СодержитПару(URL, "response_type", "code")).ЭтоИстина();
	Ожидаем.Что(СодержитПару(URL, "client_id", "client-1")).ЭтоИстина();
	Ожидаем.Что(СодержитПару(URL, "code_challenge_method", "S256")).ЭтоИстина();
	// redirect_uri и scope url-кодированы
	Ожидаем.Что(СтрНайти(URL, "redirect_uri=https%3A%2F%2Fapp.example.com%2Fcallback") > 0).ЭтоИстина();
	Ожидаем.Что(СтрНайти(URL, "scope=openid%20profile%20email") > 0).ЭтоИстина();
	Ожидаем.Что(СтрНайти(URL, "state=") > 0).ЭтоИстина();
	Ожидаем.Что(СтрНайти(URL, "nonce=") > 0).ЭтоИстина();
	Ожидаем.Что(СтрНайти(URL, "code_challenge=") > 0).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура CodeChallengeСогласованСПроверочнымКодом() Экспорт

	Клиент = НовыйКлиент();
	Запрос = Клиент.НачатьАвторизацию();

	// code_challenge в URL должен быть ровно S256 от возвращённого проверочного кода
	Ожидаемый = PKCE.ВычислитьВызовS256(Запрос.ПроверочныйКод());
	Ожидаем.Что(СодержитПару(Запрос.URL(), "code_challenge", Ожидаемый)).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура StateИNonceНепустыеИРазные() Экспорт

	Клиент = НовыйКлиент();
	Запрос = Клиент.НачатьАвторизацию();

	Ожидаем.Что(СтрДлина(Запрос.Состояние()) > 0).ЭтоИстина();
	Ожидаем.Что(СтрДлина(Запрос.Одноразовость()) > 0).ЭтоИстина();
	Ожидаем.Что(Запрос.Состояние()).ЭтоНе().Равно(Запрос.Одноразовость());
	Ожидаем.Что(СтрДлина(Запрос.ПроверочныйКод())).Равно(43);

КонецПроцедуры

&Тест
Процедура ДополнительныеПараметрыДобавляютсяВURL() Экспорт

	Клиент = НовыйКлиент();
	Доп = Новый Соответствие;
	Доп.Вставить("prompt", "login");
	Доп.Вставить("login_hint", "user@example.com");

	Запрос = Клиент.НачатьАвторизацию(Доп);

	Ожидаем.Что(СодержитПару(Запрос.URL(), "prompt", "login")).ЭтоИстина();
	// значение url-кодировано (@ → %40)
	Ожидаем.Что(СтрНайти(Запрос.URL(), "login_hint=user%40example.com") > 0).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура РазделительУчитываетЗапросВКонечнойТочке() Экспорт

	// authorization_endpoint уже содержит "?" — параметры цепляются через "&"
	Клиент = НовыйКлиентСМетаданными("https://idp.example.com/authorize?foo=bar");
	Запрос = Клиент.НачатьАвторизацию();

	Ожидаем.Что(СтрНачинаетсяС(Запрос.URL(), "https://idp.example.com/authorize?foo=bar&")).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура БезАдресаВозвратаВызываетИсключение() Экспорт

	Конфиг = Новый Структура;
	Конфиг.Вставить("Издатель", "https://idp.example.com");
	Конфиг.Вставить("ИдентификаторКлиента", "client-1");
	// АдресВозврата не задан
	Клиент = Новый КлиентOIDC(Конфиг, НоваяСессия());
	Клиент.УстановитьМетаданные(МетаданныеСоответствие("https://idp.example.com/authorize"));

	Попытка
		Клиент.НачатьАвторизацию();
		Ожидаем.Что(Ложь, "ожидалось исключение без redirect_uri").ЭтоИстина();
	Исключение
		Ожидаем.Что(Истина).ЭтоИстина();
	КонецПопытки;

КонецПроцедуры

// --- Служебные ---

Функция НовыйКлиент()
	Возврат НовыйКлиентСМетаданными("https://idp.example.com/authorize");
КонецФункции

Функция НовыйКлиентСМетаданными(Знач ТочкаАвторизации)
	Конфиг = Новый Структура;
	Конфиг.Вставить("Издатель", "https://idp.example.com");
	Конфиг.Вставить("ИдентификаторКлиента", "client-1");
	Конфиг.Вставить("АдресВозврата", "https://app.example.com/callback");

	Клиент = Новый КлиентOIDC(Конфиг, НоваяСессия());
	Клиент.УстановитьМетаданные(МетаданныеСоответствие(ТочкаАвторизации));
	Возврат Клиент;
КонецФункции

Функция МетаданныеСоответствие(Знач ТочкаАвторизации)
	М = Новый Соответствие;
	М.Вставить("issuer", "https://idp.example.com");
	М.Вставить("authorization_endpoint", ТочкаАвторизации);
	М.Вставить("token_endpoint", "https://idp.example.com/token");
	М.Вставить("userinfo_endpoint", "https://idp.example.com/userinfo");
	Возврат М;
КонецФункции

Функция НоваяСессия()
	Возврат ЗагрузитьСценарий(ПутьФикстуры("СессияФейковая.os"));
КонецФункции

// Проверяет наличие пары ключ=значение (значение — как в url, без спецсимволов).
Функция СодержитПару(Знач URL, Знач Ключ, Знач Значение)
	Возврат СтрНайти(URL, Ключ + "=" + Значение) > 0;
КонецФункции

Функция ПутьФикстуры(Знач Имя)
	Файл = Новый Файл(ТекущийСценарий().Источник);
	Возврат ОбъединитьПути(Файл.Путь, "fixtures", Имя);
КонецФункции
