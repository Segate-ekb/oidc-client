#Использовать "../"
#Использовать "../src/internal"
#Использовать asserts

// Тесты проверки id_token: iss/aud/exp/nbf/nonce, границы (люфт часов),
// массивный aud, а также сквозной ЗавершитьАвторизацию (обмен + проверка).
// Время — инъектируемые управляемые часы; подпись НЕ проверяется (модель доверия
// server-to-server, см. README).

&Тест
Процедура КорректныйТокенПроходитИВозвращаетКлеймы() Экспорт

	Клиент = НовыйКлиент();
	Клеймы = БазовыеКлеймы();
	Клеймы.Вставить("nonce", "nonce-1");
	Токен = СобратьJWT(Клеймы);

	Результат = Клиент.ПроверитьИдентификационныйТокен(Токен, "nonce-1");

	Ожидаем.Что(Результат.Получить("sub")).Равно("user-42");

КонецПроцедуры

&Тест
Процедура НеверныйIssВызываетИсключение() Экспорт

	Клиент = НовыйКлиент();
	Клеймы = БазовыеКлеймы();
	Клеймы.Вставить("iss", "https://evil.example.com");

	Ожидаем.Что(ОтклоненТокен(Клиент, СобратьJWT(Клеймы), Неопределено)).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура AudБезClientIdВызываетИсключение() Экспорт

	Клиент = НовыйКлиент();
	Клеймы = БазовыеКлеймы();
	Клеймы.Вставить("aud", "другой-клиент");

	Ожидаем.Что(ОтклоненТокен(Клиент, СобратьJWT(Клеймы), Неопределено)).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура AudМассивСодержащийClientIdПроходит() Экспорт

	Клиент = НовыйКлиент();
	Массив = Новый Массив;
	Массив.Добавить("другой-клиент");
	Массив.Добавить("client-1");
	Клеймы = БазовыеКлеймы();
	Клеймы.Вставить("aud", Массив);

	Результат = Клиент.ПроверитьИдентификационныйТокен(СобратьJWT(Клеймы), Неопределено);
	Ожидаем.Что(Результат.Получить("sub")).Равно("user-42");

КонецПроцедуры

&Тест
Процедура ИстёкшийТокенВызываетИсключение() Экспорт

	Клиент = НовыйКлиент();
	Клеймы = БазовыеКлеймы();
	Клеймы.Вставить("exp", ВUnix(МоментТеста()) - 3600); // час назад, за пределами люфта

	Ожидаем.Что(ОтклоненТокен(Клиент, СобратьJWT(Клеймы), Неопределено)).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура НедавноИстёкшийВПределахЛюфтаПроходит() Экспорт

	Клиент = НовыйКлиент(); // люфт по умолчанию 60 с
	Клеймы = БазовыеКлеймы();
	Клеймы.Вставить("exp", ВUnix(МоментТеста()) - 30); // 30 с назад, в пределах люфта

	Результат = Клиент.ПроверитьИдентификационныйТокен(СобратьJWT(Клеймы), Неопределено);
	Ожидаем.Что(Результат.Получить("sub")).Равно("user-42");

КонецПроцедуры

&Тест
Процедура NbfВБудущемВызываетИсключение() Экспорт

	Клиент = НовыйКлиент();
	Клеймы = БазовыеКлеймы();
	Клеймы.Вставить("nbf", ВUnix(МоментТеста()) + 3600); // действует через час

	Ожидаем.Что(ОтклоненТокен(Клиент, СобратьJWT(Клеймы), Неопределено)).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура НесовпадающийNonceВызываетИсключение() Экспорт

	Клиент = НовыйКлиент();
	Клеймы = БазовыеКлеймы();
	Клеймы.Вставить("nonce", "nonce-настоящий");

	Ожидаем.Что(ОтклоненТокен(Клиент, СобратьJWT(Клеймы), "nonce-ожидаемый")).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура NonceНеСверяетсяЕслиНеЗадан() Экспорт

	Клиент = НовыйКлиент();
	Клеймы = БазовыеКлеймы(); // без nonce

	Результат = Клиент.ПроверитьИдентификационныйТокен(СобратьJWT(Клеймы), Неопределено);
	Ожидаем.Что(Результат.Получить("sub")).Равно("user-42");

КонецПроцедуры

&Тест
Процедура ОтсутствиеExpВызываетИсключение() Экспорт

	Клиент = НовыйКлиент();
	Клеймы = Новый Соответствие;
	Клеймы.Вставить("iss", "https://idp.example.com");
	Клеймы.Вставить("aud", "client-1");
	Клеймы.Вставить("sub", "user-42"); // exp отсутствует

	Ожидаем.Что(ОтклоненТокен(Клиент, СобратьJWT(Клеймы), Неопределено)).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПустойИздательНеПринимаетТокенНаВеру() Экспорт

	// ОХРАННЫЙ ТЕСТ. Клиент без Издателя достижим (сырая Структура в обход
	// КонфигурацияПровайдера). Без ожидаемого iss сверка выродилась бы в "" = ""
	// на токене без клейма iss, и токен принялся бы на веру.
	Конфиг = Новый Структура;
	Конфиг.Вставить("ИдентификаторКлиента", "client-1");
	Конфиг.Вставить("АдресВозврата", "https://app.example.com/callback");
	Клиент = Новый КлиентOIDC(Конфиг, НоваяСессия(), НовыеЧасы());

	Клеймы = Новый Соответствие; // клейма iss нет — как и ожидаемого издателя
	Клеймы.Вставить("aud", "client-1");
	Клеймы.Вставить("sub", "user-42");
	Клеймы.Вставить("exp", ВUnix(МоментТеста()) + 3600);

	Ожидаем.Что(ОтклоненТокен(Клиент, СобратьJWT(Клеймы), Неопределено),
		"токен без iss при пустом Издателе принят на веру").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ЗавершитьАвторизациюОбменИПроверка() Экспорт

	// сквозной сценарий: код → токены → проверенный id_token с nonce из запроса
	Клеймы = БазовыеКлеймы();
	Клеймы.Вставить("nonce", "nonce-1");
	ТелоТокенов = "{""access_token"":""AT"",""token_type"":""Bearer"",""id_token"":"""
		+ СобратьJWT(Клеймы) + """}";

	Сессия = НоваяСессия();
	Сессия.ПриPOST("https://idp.example.com/token", 200, ТелоТокенов);
	Клиент = НовыйКлиентССессией(Сессия);

	Запрос = Новый ЗапросАвторизации("https://idp.example.com/authorize?...",
		"state-1", "nonce-1", "verifier-1");

	Итог = Клиент.ЗавершитьАвторизацию("код-123", Запрос);

	Ожидаем.Что(Итог.Токены.ТокенДоступа()).Равно("AT");
	Ожидаем.Что(Итог.Клеймы.Получить("sub")).Равно("user-42");
	// code_verifier из запроса ушёл в форму
	Ожидаем.Что(Сессия.ПолеФормы("code_verifier")).Равно("verifier-1");

КонецПроцедуры

&Тест
Процедура ЗавершитьАвторизациюБезIdTokenВызываетИсключение() Экспорт

	Сессия = НоваяСессия();
	Сессия.ПриPOST("https://idp.example.com/token", 200,
		"{""access_token"":""AT"",""token_type"":""Bearer""}"); // без id_token
	Клиент = НовыйКлиентССессией(Сессия);
	Запрос = Новый ЗапросАвторизации("url", "state-1", "nonce-1", "verifier-1");

	Попытка
		Клиент.ЗавершитьАвторизацию("код-123", Запрос);
		Ожидаем.Что(Ложь, "ожидалось исключение без id_token").ЭтоИстина();
	Исключение
		Ожидаем.Что(Истина).ЭтоИстина();
	КонецПопытки;

КонецПроцедуры

// --- Служебные ---

Функция МоментТеста()
	Возврат Дата(2026, 1, 1, 12, 0, 0);
КонецФункции

Функция НовыйКлиент()
	Возврат НовыйКлиентССессией(НоваяСессия());
КонецФункции

Функция НовыйКлиентССессией(Знач Сессия)
	Конфиг = Новый Структура;
	Конфиг.Вставить("Издатель", "https://idp.example.com");
	Конфиг.Вставить("ИдентификаторКлиента", "client-1");
	Конфиг.Вставить("СекретКлиента", "секрет-1");
	Конфиг.Вставить("АдресВозврата", "https://app.example.com/callback");

	Клиент = Новый КлиентOIDC(Конфиг, Сессия, НовыеЧасы());

	М = Новый Соответствие;
	М.Вставить("issuer", "https://idp.example.com");
	М.Вставить("authorization_endpoint", "https://idp.example.com/authorize");
	М.Вставить("token_endpoint", "https://idp.example.com/token");
	Клиент.УстановитьМетаданные(М);
	Возврат Клиент;
КонецФункции

Функция БазовыеКлеймы()
	Клеймы = Новый Соответствие;
	Клеймы.Вставить("iss", "https://idp.example.com");
	Клеймы.Вставить("aud", "client-1");
	Клеймы.Вставить("sub", "user-42");
	Клеймы.Вставить("exp", ВUnix(МоментТеста()) + 3600);
	Возврат Клеймы;
КонецФункции

Функция ОтклоненТокен(Знач Клиент, Знач Токен, Знач Nonce)
	Попытка
		Клиент.ПроверитьИдентификационныйТокен(Токен, Nonce);
	Исключение
		Возврат Истина;
	КонецПопытки;
	Возврат Ложь;
КонецФункции

Функция ВUnix(Знач Момент)
	Возврат Момент - Дата(1970, 1, 1, 0, 0, 0);
КонецФункции

Функция СобратьJWT(Знач Клеймы)
	Заголовок = Новый Соответствие;
	Заголовок.Вставить("alg", "RS256");
	Заголовок.Вставить("typ", "JWT");
	Возврат КодированиеBase64URL.КодироватьСтроку(ВJSON(Заголовок))
		+ "." + КодированиеBase64URL.КодироватьСтроку(ВJSON(Клеймы))
		+ ".fakesignature";
КонецФункции

Функция ВJSON(Знач Данные)
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	Возврат Запись.Закрыть();
КонецФункции

Функция НовыеЧасы()
	Часы = ЗагрузитьСценарий(ПутьФикстуры("ЧасыРучные.os"));
	Часы.УстановитьМомент(МоментТеста());
	Возврат Часы;
КонецФункции

Функция НоваяСессия()
	Возврат ЗагрузитьСценарий(ПутьФикстуры("СессияФейковая.os"));
КонецФункции

Функция ПутьФикстуры(Знач Имя)
	Файл = Новый Файл(ТекущийСценарий().Источник);
	Возврат ОбъединитьПути(Файл.Путь, "fixtures", Имя);
КонецФункции
