#Использовать "../"
#Использовать asserts

// Тесты входа OAuth2-веткой (провайдер без OIDC, вроде GitHub):
// вход БЕЗ id_token — token endpoint отдаёт только access_token, субъект
// существует только ПОСЛЕ userinfo. Ни один тест не ходит в сеть.
//
// Покрытие: успешный вход по маппингу профиля (числовой id без разделителей
// групп), синтетический издатель, двухшаговый добор email, деградация добора,
// все причины отказа ветки (state_mismatch до сети, exchange_failed,
// no_subject при недоступном userinfo и при профиле без субъекта) и
// игнорирование ЗапрашиватьПрофиль.

#Область Успех

&Тест
Процедура УспешныйВходБезIdTokenПоМаппингуПрофиля() Экспорт

	Сессия = НоваяСессия();
	НастроитьОбменБезIdToken(Сессия);
	// GitHub-подобный /user: числовой id, публичного email нет
	НастроитьПрофиль(Сессия, 200,
		"{""id"":583231,""login"":""octocat"",""email"":null}");
	НастроитьEmails(Сессия, 200,
		"[{""email"":""octocat@example.com"",""primary"":true,""verified"":true}]");

	Итог = НовыйВход(Сессия).Завершить(Транзакция(), "код-123", "state-1");

	Ожидаем.Что(Итог.Успех, Итог.Причина).ЭтоИстина();
	Ожидаем.Что(Итог.Причина).Равно("");
	// числовой id приведён к строке БЕЗ разделителей групп ("583 231" — брак)
	Ожидаем.Что(Итог.Субъект).Равно("583231");
	Ожидаем.Что(Итог.Издатель, "синтетический издатель — из конфигурации, как задан")
		.Равно("oauth2:github:тест");
	Ожидаем.Что(Итог.Email, "email добран со второй точки").Равно("octocat@example.com");
	Ожидаем.Что(Итог.EmailПодтверждён).ЭтоИстина();
	Ожидаем.Что(Итог.ПрофильПолучен).ЭтоИстина();
	Ожидаем.Что(Итог.Клеймы.Получить("login"), "сырые клеймы профиля сохранены").Равно("octocat");
	Ожидаем.Что(Итог.Токены.Получить("access_token")).Равно("AT-oauth2");

КонецПроцедуры

&Тест
Процедура НачатьСтроитURLАвторизацииИзРучныхТочек() Экспорт

	Начало = НовыйВход(НоваяСессия()).Начать();

	Ожидаем.Что(СтрНачинаетсяС(Начало.URL, "https://oauth.example.com/authorize?")).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Начало.URL, "scope=read%3Auser%20user%3Aemail") > 0,
		"область из конфигурации уехала в URL").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Начало.URL, "state=" + Начало.Транзакция.Получить("Состояние")) > 0).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Начало.URL, "code_challenge_method=S256") > 0,
		"PKCE в OAuth2 работает так же").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура БезОбластиПараметрScopeНеОтправляется() Экспорт

	// у OAuth2 нет умолчания области; пустая область не должна давать "scope="
	// в URL — часть серверов считает пустой scope ошибкой
	Описание = ОписаниеПровайдера();
	Описание.Удалить("Область");

	Начало = ВходСОписанием(НоваяСессия(), Описание).Начать();

	Ожидаем.Что(СтрНайти(Начало.URL, "scope=") = 0,
		"параметра scope нет в URL: " + Начало.URL).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура БезСинтетическогоИздателяВозвращаетсяПустой() Экспорт

	Сессия = НоваяСессия();
	НастроитьОбменБезIdToken(Сессия);
	НастроитьПрофиль(Сессия, 200, "{""id"":1,""email"":""u@example.com"",""email_verified"":true}");

	Описание = ОписаниеПровайдера();
	Описание.Удалить("Издатель");
	Итог = ВходСОписанием(Сессия, Описание).Завершить(Транзакция(), "код-123", "state-1");

	Ожидаем.Что(Итог.Успех, Итог.Причина).ЭтоИстина();
	Ожидаем.Что(Итог.Издатель, "издателя не задавали — пусто, решение за приложением").Равно("");

КонецПроцедуры

&Тест
Процедура ДоборВыбираетПодтверждённыйАдрес() Экспорт

	// primary без verified в привязку не годится; берётся первый verified
	Сессия = НоваяСессия();
	НастроитьОбменБезIdToken(Сессия);
	НастроитьПрофиль(Сессия, 200, "{""id"":1,""email"":null}");
	НастроитьEmails(Сессия, 200,
		"[{""email"":""неподтверждённый@example.com"",""primary"":true,""verified"":false},"
		+ "{""email"":""подтверждённый@example.com"",""primary"":false,""verified"":true}]");

	Итог = НовыйВход(Сессия).Завершить(Транзакция(), "код-123", "state-1");

	Ожидаем.Что(Итог.Email).Равно("подтверждённый@example.com");
	Ожидаем.Что(Итог.EmailПодтверждён).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура НеудачныйДоборНеРушитВход() Экспорт

	Сессия = НоваяСессия();
	НастроитьОбменБезIdToken(Сессия);
	НастроитьПрофиль(Сессия, 200, "{""id"":1,""email"":null}");
	НастроитьEmails(Сессия, 500, "boom");

	Итог = НовыйВход(Сессия).Завершить(Транзакция(), "код-123", "state-1");

	Ожидаем.Что(Итог.Успех, "email — желательная часть профиля, не обязательная").ЭтоИстина();
	Ожидаем.Что(Итог.Субъект).Равно("1");
	Ожидаем.Что(Итог.Email).Равно("");
	Ожидаем.Что(Итог.EmailПодтверждён).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТолькоНеподтверждённыеАдресаНеПодставляются() Экспорт

	// М-2 ревью 7.D: в списке нет ни одного verified — неподтверждённый адрес
	// в привязку личности не подставляется даже как «лучше, чем ничего».
	// Вход при этом успешен: email — желательная часть профиля, не обязательная.
	Сессия = НоваяСессия();
	НастроитьОбменБезIdToken(Сессия);
	НастроитьПрофиль(Сессия, 200, "{""id"":1,""email"":null}");
	НастроитьEmails(Сессия, 200,
		"[{""email"":""основной@example.com"",""primary"":true,""verified"":false},"
		+ "{""email"":""запасной@example.com"",""primary"":false,""verified"":false}]");

	Итог = НовыйВход(Сессия).Завершить(Транзакция(), "код-123", "state-1");

	Ожидаем.Что(Итог.Успех, Итог.Причина).ЭтоИстина();
	Ожидаем.Что(Итог.Субъект).Равно("1");
	Ожидаем.Что(Итог.Email, "неподтверждённый адрес не подставлен").Равно("");
	Ожидаем.Что(Итог.EmailПодтверждён).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ПриПодтверждённомEmailВПрофилеЗаEmailsНеХодят() Экспорт

	Сессия = НоваяСессия();
	НастроитьОбменБезIdToken(Сессия);
	// профиль сам отдал и email, и подтверждённость — добор не нужен;
	// точка Emails у транспорта НЕ зарегистрирована: поход в неё уронил бы тест
	// не той причиной, поэтому главная проверка — последний URL
	НастроитьПрофиль(Сессия, 200,
		"{""id"":1,""email"":""u@example.com"",""email_verified"":true}");

	Итог = НовыйВход(Сессия).Завершить(Транзакция(), "код-123", "state-1");

	Ожидаем.Что(Итог.Успех, Итог.Причина).ЭтоИстина();
	Ожидаем.Что(Итог.Email).Равно("u@example.com");
	Ожидаем.Что(Сессия.ПоследнийURL(), "последним был userinfo, не emails")
		.Равно("https://api.example.com/user");

КонецПроцедуры

&Тест
Процедура БезТочкиEmailsПрофильВозвращаетсяКакЕсть() Экспорт

	Сессия = НоваяСессия();
	НастроитьОбменБезIdToken(Сессия);
	НастроитьПрофиль(Сессия, 200, "{""id"":1,""email"":""публичный@example.com""}");

	Описание = ОписаниеПровайдера();
	Описание.КонечныеТочки.Удалить("Emails");
	Итог = ВходСОписанием(Сессия, Описание).Завершить(Транзакция(), "код-123", "state-1");

	Ожидаем.Что(Итог.Успех, Итог.Причина).ЭтоИстина();
	Ожидаем.Что(Итог.Email).Равно("публичный@example.com");
	Ожидаем.Что(Итог.EmailПодтверждён, "подтверждённость неизвестна = Ложь").ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область Отказы

&Тест
Процедура ЧужойStateДаётStateMismatchДоЛюбогоЗапросаВСеть() Экспорт

	// порядок общей части сохранён и в OAuth2: state — до сети
	Сессия = НоваяСессия();
	НастроитьОбменБезIdToken(Сессия);

	Итог = НовыйВход(Сессия).Завершить(Транзакция(), "код-123", "state-атакующего");

	Ожидаем.Что(Итог.Успех).ЭтоЛожь();
	Ожидаем.Что(Итог.Причина).Равно("state_mismatch");
	Ожидаем.Что(Сессия.ПоследнийURL(), "ни одного запроса к провайдеру").Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ОшибкаTokenEndpointДаётExchangeFailed() Экспорт

	Сессия = НоваяСессия();
	Сессия.ПриPOST("https://oauth.example.com/token", 400, "{""error"":""bad_verification_code""}");

	Итог = НовыйВход(Сессия).Завершить(Транзакция(), "код-123", "state-1");

	Ожидаем.Что(Итог.Причина).Равно("exchange_failed");

КонецПроцедуры

&Тест
Процедура НедоступныйUserinfoДаётNoSubjectАНеДеградацию() Экспорт

	// КЛЮЧЕВОЕ ОТЛИЧИЕ ОТ OIDC: там недоступный userinfo — деградация к клеймам
	// id_token; здесь id_token нет, субъекта взять неоткуда — входа нет
	Сессия = НоваяСессия();
	НастроитьОбменБезIdToken(Сессия);
	НастроитьПрофиль(Сессия, 500, "boom");

	Итог = НовыйВход(Сессия).Завершить(Транзакция(), "код-123", "state-1");

	Ожидаем.Что(Итог.Успех).ЭтоЛожь();
	Ожидаем.Что(Итог.Причина).Равно("no_subject");
	Ожидаем.Что(Итог.Токены.Количество(), "токенов в отказе нет").Равно(0);

КонецПроцедуры

&Тест
Процедура ПрофильБезКлеймаСубъектаДаётNoSubject() Экспорт

	// маппинг ждёт id, а его в ответе нет — без устойчивого идентификатора
	// привязка личности невозможна
	Сессия = НоваяСессия();
	НастроитьОбменБезIdToken(Сессия);
	НастроитьПрофиль(Сессия, 200, "{""login"":""octocat"",""email"":""u@example.com""}");

	Итог = НовыйВход(Сессия).Завершить(Транзакция(), "код-123", "state-1");

	Ожидаем.Что(Итог.Успех).ЭтоЛожь();
	Ожидаем.Что(Итог.Причина).Равно("no_subject");

КонецПроцедуры

&Тест
Процедура НеизвестныйПровайдерДаётUnknownProvider() Экспорт

	Итог = НовыйВход(НоваяСессия()).Завершить(Транзакция("другой"), "код-123", "state-1");

	Ожидаем.Что(Итог.Причина).Равно("unknown_provider");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НоваяСессия()
	Возврат ЗагрузитьСценарий(ПутьФикстуры("СессияФейковая.os"));
КонецФункции

Функция ПутьФикстуры(Знач Имя)
	Файл = Новый Файл(ТекущийСценарий().Источник);
	Возврат ОбъединитьПути(Файл.Путь, "fixtures", Имя);
КонецФункции

// OAuth2-провайдер, похожий на GitHub: ручные конечные точки (включая вторую
// точку Emails), маппинг профиля id/email/email_verified, синтетический издатель.
Функция ОписаниеПровайдера()

	Точки = Новый Структура();
	Точки.Вставить("Авторизация", "https://oauth.example.com/authorize");
	Точки.Вставить("Токен", "https://oauth.example.com/token");
	Точки.Вставить("Профиль", "https://api.example.com/user");
	Точки.Вставить("Emails", "https://api.example.com/user/emails");

	Маппинг = Новый Структура();
	Маппинг.Вставить("Субъект", "id");

	Данные = Новый Структура();
	Данные.Вставить("Имя", "github-подобный");
	Данные.Вставить("Тип", "oauth2");
	Данные.Вставить("Издатель", "oauth2:github:тест");
	Данные.Вставить("ИдентификаторКлиента", "client-1");
	Данные.Вставить("СекретКлиента", "секрет-1");
	Данные.Вставить("АдресВозврата", "https://app.example.com/callback");
	Данные.Вставить("Область", "read:user user:email");
	Данные.Вставить("КонечныеТочки", Точки);
	Данные.Вставить("МаппингПрофиля", Маппинг);
	Возврат Данные;

КонецФункции

Функция Зависимости(Знач Сессия)
	Часы = ЗагрузитьСценарий(ПутьФикстуры("ЧасыРучные.os"));
	Часы.УстановитьМомент(Дата(2026, 7, 30, 12, 0, 0));

	Результат = Новый Структура();
	Результат.Вставить("Сессия", Сессия);
	Результат.Вставить("Часы", Часы);
	Результат.Вставить("Генератор", ЗагрузитьСценарий(ПутьФикстуры("ГенераторФиксированный.os")));
	Возврат Результат;
КонецФункции

Функция НовыйВход(Знач Сессия)
	Возврат ВходСОписанием(Сессия, ОписаниеПровайдера());
КонецФункции

Функция ВходСОписанием(Знач Сессия, Знач Описание)
	Возврат Новый ВходЧерезПровайдера(Описание, Зависимости(Сессия));
КонецФункции

Функция Транзакция(Знач ИмяПровайдера = "github-подобный")
	Данные = Новый Соответствие();
	Данные.Вставить("Провайдер", ИмяПровайдера);
	Данные.Вставить("Состояние", "state-1");
	Данные.Вставить("Одноразовость", "nonce-1");
	Данные.Вставить("ПроверочныйКод", "verifier-1");
	Возврат Данные;
КонецФункции

// token endpoint OAuth2: access_token есть, id_token НЕ выдаётся вовсе
Процедура НастроитьОбменБезIdToken(Сессия)
	Сессия.ПриPOST("https://oauth.example.com/token", 200,
		"{""access_token"":""AT-oauth2"",""token_type"":""bearer"",""scope"":""read:user,user:email""}");
КонецПроцедуры

Процедура НастроитьПрофиль(Сессия, Знач Код, Знач Тело)
	Сессия.ПриGET("https://api.example.com/user", Код, Тело);
КонецПроцедуры

Процедура НастроитьEmails(Сессия, Знач Код, Знач Тело)
	Сессия.ПриGET("https://api.example.com/user/emails", Код, Тело);
КонецПроцедуры

#КонецОбласти
