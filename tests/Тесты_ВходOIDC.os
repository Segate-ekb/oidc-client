	Ожидаем.Что(ПричинаОтказаСКлеймами(Клеймы)).Равно("id_token_invalid");

КонецПроцедуры

&Тест
Процедура ИстёкшийТокенДаётIdTokenInvalid() Экспорт

	Клеймы = БазовыеКлеймы("user-42", "nonce-1");
	Клеймы.Вставить("exp", ВUnix(МоментТеста()) - 3600);

	Ожидаем.Что(ПричинаОтказаСКлеймами(Клеймы)).Равно("id_token_invalid");

КонецПроцедуры

&Тест
Процедура ЧужойAzpДаётIdTokenInvalid() Экспорт

	// OIDC Core §3.1.3.7: azp необязателен, но если он есть — обязан указывать
	// на нас. Токен, выписанный для другого приложения, не наш.
	Клеймы = БазовыеКлеймы("user-42", "nonce-1");
	Клеймы.Вставить("azp", "другой-клиент");

	Ожидаем.Что(ПричинаОтказаСКлеймами(Клеймы)).Равно("id_token_invalid");

КонецПроцедуры

&Тест
Процедура СвойAzpПриМножественномAudПроходит() Экспорт

	Аудитория = Новый Массив();
	Аудитория.Добавить("client-1");
	Аудитория.Добавить("другой-ресурс");
	Клеймы = БазовыеКлеймы("user-42", "nonce-1");
	Клеймы.Вставить("aud", Аудитория);
	Клеймы.Вставить("azp", "client-1");

	Сессия = НоваяСессия();
	НастроитьУспешныйОбмен(Сессия, Клеймы);
	НастроитьПрофиль(Сессия, 200, "{""sub"":""user-42""}");

	Итог = НовыйВход(Сессия).Завершить(Транзакция(), "код-123", "state-1");

	Ожидаем.Что(Итог.Успех, Итог.Причина).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ОтсутствующийIdTokenДаётIdTokenInvalid() Экспорт

	Сессия = НоваяСессия();
	// token endpoint ответил 200, но id_token не выдал — принять такой вход
	// нельзя: подтверждения аутентификации нет
	Сессия.ПриPOST("https://idp.example.com/token", 200,
		"{""access_token"":""AT-xyz"",""token_type"":""Bearer""}");

	Итог = НовыйВход(Сессия).Завершить(Транзакция(), "код-123", "state-1");

	Ожидаем.Что(Итог.Причина).Равно("id_token_invalid");

КонецПроцедуры

