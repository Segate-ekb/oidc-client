#Использовать "../"
#Использовать "../src/internal"
#Использовать asserts

// Тесты входа OIDC-веткой: Начать → Завершить и ВСЕ исходы. Ни один тест не
// ходит в сеть — сессия фейковая, часы ручные, генератор детерминированный.
//
// Покрытие кодов отказа: state_mismatch, unknown_provider, exchange_failed,
// id_token_invalid, no_subject — плюс деградация userinfo (недоступен / отдал
// чужой sub) и порядок проверок (state сверяется ДО сети).

#Область Начало

&Тест
Процедура НачатьДаётURLИНепрозрачнуюТранзакцию() Экспорт

	Начало = НовыйВход(НоваяСессия()).Начать();
	Т = Начало.Транзакция;

	Ожидаем.Что(ТипЗнч(Т), "транзакция уезжает данными, а не нашим типом")
		.Равно(Тип("Соответствие"));
	Ожидаем.Что(Т.Получить("Провайдер")).Равно("keycloak");
	Ожидаем.Что(ЗначениеЗаполнено(Т.Получить("Состояние"))).ЭтоИстина();
	Ожидаем.Что(ЗначениеЗаполнено(Т.Получить("Одноразовость"))).ЭтоИстина();
	Ожидаем.Что(ЗначениеЗаполнено(Т.Получить("ПроверочныйКод"))).ЭтоИстина();

	Ожидаем.Что(СтрНачинаетсяС(Начало.URL, "https://idp.example.com/authorize?")).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Начало.URL, "state=" + Т.Получить("Состояние")) > 0).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Начало.URL, "nonce=" + Т.Получить("Одноразовость")) > 0).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Начало.URL, "code_challenge_method=S256") > 0).ЭтоИстина();
	// PKCE: в URL уезжает ВЫЗОВ, а не сам проверочный код
	Ожидаем.Что(СтрНайти(Начало.URL, Т.Получить("ПроверочныйКод")) = 0,
		"code_verifier не должен попадать в URL авторизации").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура НекорректноеОписаниеПровайдераОтклоняетсяПриСоздании() Экспорт

	// Кривая конфигурация — не исход входа, а поломка настройки: приложению
	// честнее увидеть её при сборке объекта, а не загадочным отказом на callback.
	Данные = ОписаниеПровайдера();
	Данные.Удалить("ИдентификаторКлиента");

	Попытка
		Проба = Новый ВходЧерезПровайдера(Данные, Зависимости(НоваяСессия()));
		Проба = Проба;
		Ожидаем.Что(Ложь, "ожидалось исключение для описания без client_id").ЭтоИстина();
	Исключение
		Ожидаем.Что(Истина).ЭтоИстина();
	КонецПопытки;

КонецПроцедуры

&Тест
Процедура ПостоянныеИРазовыеПараметрыАвторизацииПопадаютВURL() Экспорт

	Данные = ОписаниеПровайдера();
	Постоянные = Новый Соответствие();
	Постоянные.Вставить("prompt", "consent");
	Данные.Вставить("ПараметрыАвторизации", Постоянные);

	Разовые = Новый Соответствие();
	Разовые.Вставить("login_hint", "u@example.com");

	Начало = Новый ВходЧерезПровайдера(Данные, Зависимости(НоваяСессия())).Начать(Разовые);

	Ожидаем.Что(СтрНайти(Начало.URL, "prompt=consent") > 0).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Начало.URL, "login_hint=u%40example.com") > 0).ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Успех

&Тест
Процедура УспешныйВходДаётСубъектаИздателяИПрофиль() Экспорт

	Сессия = НоваяСессия();
	НастроитьУспешныйОбмен(Сессия, БазовыеКлеймы("user-42", "nonce-1"));
	НастроитьПрофиль(Сессия, 200,
		"{""sub"":""user-42"",""email"":""u@example.com"",""email_verified"":true,""groups"":[""dev""]}");

	Итог = НовыйВход(Сессия).Завершить(Транзакция(), "код-123", "state-1");

	Ожидаем.Что(Итог.Успех, Итог.Причина).ЭтоИстина();
	Ожидаем.Что(Итог.Причина).Равно("");
	Ожидаем.Что(Итог.Субъект).Равно("user-42");
	Ожидаем.Что(Итог.Издатель, "издатель — из конфигурации, а не из клеймов").Равно("https://idp.example.com");
	Ожидаем.Что(Итог.Email).Равно("u@example.com");
	Ожидаем.Что(Итог.EmailПодтверждён).ЭтоИстина();
	Ожидаем.Что(Итог.ПрофильПолучен).ЭтоИстина();
	Ожидаем.Что(Итог.Клеймы.Получить("groups").Количество(), "клеймы userinfo слиты с id_token").Равно(1);
	Ожидаем.Что(Итог.Токены.Получить("access_token"), "токены — сырой ответ провайдера").Равно("AT-xyz");

КонецПроцедуры

&Тест
Процедура ПрофильПерекрываетКлеймыТокенаПоСовпадающимКлючам() Экспорт

	Клеймы = БазовыеКлеймы("user-42", "nonce-1");
	Клеймы.Вставить("email", "старый@example.com");
	Сессия = НоваяСессия();
	НастроитьУспешныйОбмен(Сессия, Клеймы);
	НастроитьПрофиль(Сессия, 200, "{""sub"":""user-42"",""email"":""новый@example.com""}");

	Итог = НовыйВход(Сессия).Завершить(Транзакция(), "код-123", "state-1");

	Ожидаем.Что(Итог.Email, "userinfo авторитетнее id_token").Равно("новый@example.com");

КонецПроцедуры

&Тест
Процедура ТранзакцияПереживаетСериализациюХранилищем() Экспорт

	// Приложение кладёт транзакцию куда угодно, и хранилища нередко приводят
	// ключи к нижнему регистру. Вернувшееся представление обязано читаться.
	Сессия = НоваяСессия();
	НастроитьУспешныйОбмен(Сессия, БазовыеКлеймы("user-42", "nonce-1"));
	НастроитьПрофиль(Сессия, 200, "{""sub"":""user-42""}");

	Приведённая = Новый Соответствие();
	Для Каждого КиЗ Из Транзакция() Цикл
		Приведённая.Вставить(НРег(Строка(КиЗ.Ключ)), КиЗ.Значение);
	КонецЦикла;

	Итог = НовыйВход(Сессия).Завершить(Приведённая, "код-123", "state-1");

	Ожидаем.Что(Итог.Успех, Итог.Причина).ЭтоИстина();
	Ожидаем.Что(Итог.Субъект).Равно("user-42");

КонецПроцедуры

#КонецОбласти

#Область ОтказStateMismatch

&Тест
Процедура ЧужойStateДаётStateMismatchДоЛюбогоЗапросаВСеть() Экспорт

	Сессия = НоваяСессия();
	НастроитьУспешныйОбмен(Сессия, БазовыеКлеймы("user-42", "nonce-1"));

	Итог = НовыйВход(Сессия).Завершить(Транзакция(), "код-123", "state-атакующего");

	Ожидаем.Что(Итог.Успех).ЭтоЛожь();
	Ожидаем.Что(Итог.Причина).Равно("state_mismatch");
	// ГЛАВНОЕ: к провайдеру не сходили. Иначе по чужому редиректу мы сами
	// обменивали бы подсунутый код авторизации.
	Ожидаем.Что(Сессия.ПоследнийURL(), "ни одного запроса к провайдеру").Равно(Неопределено);
	Ожидаем.Что(Итог.Токены.Количество(), "токенов в отказе нет").Равно(0);

КонецПроцедуры

&Тест
Процедура ПустоеОжидаемоеСостояниеНеСчитаетсяСовпадением() Экспорт

	// «Ожидания нет» — это не «сверка прошла»: транзакция без state (потерянная,
	// битая, подделанная) не должна открывать вход пустым state в редиректе.
	Итог = НовыйВход(НоваяСессия()).Завершить(Транзакция("keycloak", ""), "код-123", "");

	Ожидаем.Что(Итог.Причина).Равно("state_mismatch");

КонецПроцедуры

&Тест
Процедура StateРазнойДлиныОтклоняется() Экспорт

	Итог = НовыйВход(НоваяСессия()).Завершить(Транзакция(), "код-123", "state-1-и-хвост");

	Ожидаем.Что(Итог.Причина).Равно("state_mismatch");

КонецПроцедуры

&Тест
Процедура ПотеряннаяТранзакцияДаётStateMismatch() Экспорт

	// Приложение может передать Неопределено (в его хранилище ничего не нашлось)
	// или битое представление — вход не должен ни падать, ни открываться.
	Ожидаем.Что(НовыйВход(НоваяСессия()).Завершить(Неопределено, "код-123", "state-1").Причина)
		.Равно("state_mismatch");
	Ожидаем.Что(НовыйВход(НоваяСессия()).Завершить(Новый Соответствие(), "код-123", "state-1").Причина)
		.Равно("state_mismatch");

КонецПроцедуры

#КонецОбласти

#Область ОтказНеизвестныйПровайдер

&Тест
Процедура ТранзакцияЧужогоПровайдераДаётUnknownProvider() Экспорт

	// объект ведёт ОДНОГО провайдера: транзакцией чужого входа его не завершить
	Итог = НовыйВход(НоваяСессия()).Завершить(
		Транзакция("другой-провайдер"), "код-123", "state-1");

	Ожидаем.Что(Итог.Успех).ЭтоЛожь();
	Ожидаем.Что(Итог.Причина).Равно("unknown_provider");

КонецПроцедуры

#КонецОбласти

#Область ОтказExchangeFailed

&Тест
Процедура ОшибкаTokenEndpointДаётExchangeFailed() Экспорт

	Сессия = НоваяСессия();
	Сессия.ПриPOST("https://idp.example.com/token", 400, "{""error"":""invalid_grant""}");

	Итог = НовыйВход(Сессия).Завершить(Транзакция(), "код-123", "state-1");

	Ожидаем.Что(Итог.Успех).ЭтоЛожь();
	Ожидаем.Что(Итог.Причина).Равно("exchange_failed");

КонецПроцедуры

&Тест
Процедура НедоступныйTokenEndpointДаётExchangeFailed() Экспорт

	// транспорт не знает такого адреса и бросает исключение — это «к провайдеру
	// сходить не удалось», а не аварийная остановка входа
	Итог = НовыйВход(НоваяСессия()).Завершить(Транзакция(), "код-123", "state-1");

	Ожидаем.Что(Итог.Причина).Равно("exchange_failed");

КонецПроцедуры

&Тест
Процедура ПустойКодДаётExchangeFailed() Экспорт

	Сессия = НоваяСессия();
	НастроитьУспешныйОбмен(Сессия, БазовыеКлеймы("user-42", "nonce-1"));

	Итог = НовыйВход(Сессия).Завершить(Транзакция(), "", "state-1");

	Ожидаем.Что(Итог.Причина).Равно("exchange_failed");

КонецПроцедуры

