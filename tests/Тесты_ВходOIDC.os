КонецПроцедуры

#КонецОбласти

#Область ДеградацияUserinfo

&Тест
Процедура НедоступныйUserinfoНеОтменяетВход() Экспорт

	Клеймы = БазовыеКлеймы("user-42", "nonce-1");
	Клеймы.Вставить("email", "из-токена@example.com");
	Клеймы.Вставить("email_verified", Истина);
	Сессия = НоваяСессия();
	НастроитьУспешныйОбмен(Сессия, Клеймы);
	НастроитьПрофиль(Сессия, 500, "boom");

	Итог = НовыйВход(Сессия).Завершить(Транзакция(), "код-123", "state-1");

	Ожидаем.Что(Итог.Успех, "деградация: работаем на клеймах id_token").ЭтоИстина();
	Ожидаем.Что(Итог.ПрофильПолучен, "признак деградации виден вызывающему").ЭтоЛожь();
	Ожидаем.Что(Итог.Субъект).Равно("user-42");
	Ожидаем.Что(Итог.Email).Равно("из-токена@example.com");
	Ожидаем.Что(Итог.EmailПодтверждён).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПровайдерБезUserinfoEndpointНеЛомаетВход() Экспорт

	Клеймы = БазовыеКлеймы("user-42", "nonce-1");
	Сессия = НоваяСессия();
	НастроитьУспешныйОбмен(Сессия, Клеймы);

	// конечная точка профиля у провайдера вообще не объявлена
	Данные = ОписаниеПровайдера();
	Точки = Новый Структура();
	Точки.Вставить("Авторизация", "https://idp.example.com/authorize");
	Точки.Вставить("Токен", "https://idp.example.com/token");
	Данные.Вставить("КонечныеТочки", Точки);

	Итог = Новый ВходЧерезПровайдера(Данные, Зависимости(Сессия))
		.Завершить(Транзакция(), "код-123", "state-1");

	Ожидаем.Что(Итог.Успех).ЭтоИстина();
	Ожидаем.Что(Итог.ПрофильПолучен).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ПрофильСЧужимSubИгнорируется() Экспорт

	// OIDC Core §5.3.2: sub из userinfo обязан совпадать с sub id_token. Иначе
	// это профиль другого человека — подставить из него email в привязку
	// личности значит отдать чужую учётку.
	Клеймы = БазовыеКлеймы("user-42", "nonce-1");
	Клеймы.Вставить("email", "свой@example.com");
	Сессия = НоваяСессия();
	НастроитьУспешныйОбмен(Сессия, Клеймы);
	НастроитьПрофиль(Сессия, 200,
		"{""sub"":""admin-1"",""email"":""admin@example.com"",""email_verified"":true}");

	Итог = НовыйВход(Сессия).Завершить(Транзакция(), "код-123", "state-1");

	Ожидаем.Что(Итог.Успех).ЭтоИстина();
	Ожидаем.Что(Итог.ПрофильПолучен, "чужой профиль отброшен").ЭтоЛожь();
	Ожидаем.Что(Итог.Субъект).Равно("user-42");
	Ожидаем.Что(Итог.Email, "email чужого профиля не подставлен").Равно("свой@example.com");

КонецПроцедуры

&Тест
Процедура ПрофильБезSubПринимаетсяЦеликом() Экспорт

	// ОХРАННЫЙ ТЕСТ. Соблазн доужесточить проверку до «sub обязателен» велик, и
	// на всём наборе это остаётся зелёным — а вход у Authentik и Gitea молча
	// деградирует: ПрофильПолучен = Ложь, email пропал, группы не сверились.
	Клеймы = БазовыеКлеймы("user-42", "nonce-1");
	Сессия = НоваяСессия();
	НастроитьУспешныйОбмен(Сессия, Клеймы);
	НастроитьПрофиль(Сессия, 200,
		"{""email"":""u@example.com"",""email_verified"":true,""groups"":[""dev""]}");

	Итог = НовыйВход(Сессия).Завершить(Транзакция(), "код-123", "state-1");

	Ожидаем.Что(Итог.Успех, Итог.Причина).ЭтоИстина();
	Ожидаем.Что(Итог.ПрофильПолучен, "профиль без sub ПРИНЯТ, деградации нет").ЭтоИстина();
	Ожидаем.Что(Итог.Субъект, "субъект остаётся из id_token").Равно("user-42");
	Ожидаем.Что(Итог.Email, "email из userinfo подставлен").Равно("u@example.com");
	Ожидаем.Что(Итог.EmailПодтверждён).ЭтоИстина();
	Ожидаем.Что(Итог.Клеймы.Получить("groups").Количество(), "группы из userinfo слиты").Равно(1);

КонецПроцедуры

&Тест
Процедура ПрофильСПустымSubПринимаетсяКакПрофильБезSub() Экспорт

	// Пустая строка и пробелы — та же «клейма нет», а не «sub не совпал»: иначе
	// провайдер, отдающий sub пустым, терял бы профиль по другой причине.
	Клеймы = БазовыеКлеймы("user-42", "nonce-1");
	Сессия = НоваяСессия();
	НастроитьУспешныйОбмен(Сессия, Клеймы);
	НастроитьПрофиль(Сессия, 200, "{""sub"":""   "",""email"":""u@example.com""}");

	Итог = НовыйВход(Сессия).Завершить(Транзакция(), "код-123", "state-1");

	Ожидаем.Что(Итог.ПрофильПолучен).ЭтоИстина();
	Ожидаем.Что(Итог.Email).Равно("u@example.com");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НоваяСессия()
	Возврат ЗагрузитьСценарий(ПутьФикстуры("СессияФейковая.os"));
КонецФункции

Функция ПутьФикстуры(Знач Имя)
	Файл = Новый Файл(ТекущийСценарий().Источник);
	Возврат ОбъединитьПути(Файл.Путь, "fixtures", Имя);
КонецФункции

// Описание провайдера с РУЧНЫМИ конечными точками: discovery в этих тестах не
// нужен, к сети поток обращается только за token/userinfo.
Функция ОписаниеПровайдера()

	Точки = Новый Структура();
	Точки.Вставить("Авторизация", "https://idp.example.com/authorize");
	Точки.Вставить("Токен", "https://idp.example.com/token");
	Точки.Вставить("Профиль", "https://idp.example.com/userinfo");

	Данные = Новый Структура();
	Данные.Вставить("Имя", "keycloak");
	Данные.Вставить("Издатель", "https://idp.example.com");
	Данные.Вставить("ИдентификаторКлиента", "client-1");
	Данные.Вставить("СекретКлиента", "секрет-1");
	Данные.Вставить("АдресВозврата", "https://app.example.com/callback");
	Данные.Вставить("КонечныеТочки", Точки);
	Возврат Данные;

КонецФункции

Функция Зависимости(Знач Сессия)
	Часы = ЗагрузитьСценарий(ПутьФикстуры("ЧасыРучные.os"));
	Часы.УстановитьМомент(МоментТеста());

	Результат = Новый Структура();
	Результат.Вставить("Сессия", Сессия);
	Результат.Вставить("Часы", Часы);
	Результат.Вставить("Генератор", ЗагрузитьСценарий(ПутьФикстуры("ГенераторФиксированный.os")));
	Возврат Результат;
КонецФункции

Функция НовыйВход(Знач Сессия)
	Возврат Новый ВходЧерезПровайдера(ОписаниеПровайдера(), Зависимости(Сессия));
КонецФункции

// Транзакция, какой её вернул бы Начать и сохранило приложение.
Функция Транзакция(Знач ИмяПровайдера = "keycloak", Знач Состояние = "state-1")
	Данные = Новый Соответствие();
	Данные.Вставить("Провайдер", ИмяПровайдера);
	Данные.Вставить("Состояние", Состояние);
	Данные.Вставить("Одноразовость", "nonce-1");
	Данные.Вставить("ПроверочныйКод", "verifier-1");
	Возврат Данные;
КонецФункции

Функция ПричинаОтказаСКлеймами(Знач Клеймы)

	Сессия = НоваяСессия();
	НастроитьУспешныйОбмен(Сессия, Клеймы);
	НастроитьПрофиль(Сессия, 200, "{""sub"":""user-42""}");

	Итог = НовыйВход(Сессия).Завершить(Транзакция(), "код-123", "state-1");
	Ожидаем.Что(Итог.Успех, "ожидался отказ").ЭтоЛожь();
	Возврат Итог.Причина;

КонецФункции

Процедура НастроитьУспешныйОбмен(Сессия, Знач Клеймы)
	Тело = "{""access_token"":""AT-xyz"",""token_type"":""Bearer"",""expires_in"":3600,"
		+ """id_token"":""" + СобратьJWT(Клеймы) + """}";
	Сессия.ПриPOST("https://idp.example.com/token", 200, Тело);
КонецПроцедуры

Процедура НастроитьПрофиль(Сессия, Знач Код, Знач Тело)
	Сессия.ПриGET("https://idp.example.com/userinfo", Код, Тело);
КонецПроцедуры

Функция БазовыеКлеймы(Знач Субъект, Знач Nonce)
	Клеймы = Новый Соответствие();
	Клеймы.Вставить("iss", "https://idp.example.com");
	Клеймы.Вставить("aud", "client-1");
	Клеймы.Вставить("sub", Субъект);
	Клеймы.Вставить("nonce", Nonce);
	Клеймы.Вставить("exp", ВUnix(МоментТеста()) + 3600);
	Возврат Клеймы;
КонецФункции

Функция СобратьJWT(Знач Клеймы)
	Заголовок = Новый Соответствие();
	Заголовок.Вставить("alg", "RS256");
	Заголовок.Вставить("typ", "JWT");
	Возврат КодированиеBase64URL.КодироватьСтроку(ВJSON(Заголовок))
		+ "." + КодированиеBase64URL.КодироватьСтроку(ВJSON(Клеймы))
		+ ".fakesignature";
КонецФункции

Функция ВJSON(Знач Данные)
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	Возврат Запись.Закрыть();
КонецФункции

Функция МоментТеста()
	Возврат Дата(2026, 7, 30, 12, 0, 0);
КонецФункции

Функция ВUnix(Знач Момент)
	Возврат Момент - Дата(1970, 1, 1, 0, 0, 0);
КонецФункции

#КонецОбласти
