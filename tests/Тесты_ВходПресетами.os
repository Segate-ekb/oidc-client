#Использовать "../"
#Использовать "../src/internal"
#Использовать asserts

// Сквозные входы обоими путями на пресетах: OAuth2 (GitHub — ручные точки,
// профиль без id_token, добор email) и OIDC (GitLab — discovery, id_token).
// Разбор самих пресетов в описание провайдера проверяет Тесты_КонфигурацияПровайдера.

#Область СквознойВходOAuth2ЧерезПресетGitHub

&Тест
Процедура E2EВходЧерезПресетGitHubОтСтартаДоИсхода() Экспорт

	// полный цикл: Начать (URL на github.com) → редирект → Завершить
	// (обмен кода на access_token БЕЗ id_token → /user → добор /user/emails)
	Сессия = НоваяСессия();
	Сессия.ПриPOST("https://github.com/login/oauth/access_token", 200,
		"{""access_token"":""gho_abc"",""token_type"":""bearer"",""scope"":""read:user,user:email""}");
	Сессия.ПриGET("https://api.github.com/user", 200,
		"{""id"":583231,""login"":""octocat"",""email"":null}");
	Сессия.ПриGET("https://api.github.com/user/emails", 200,
		"[{""email"":""octocat@users.example.com"",""primary"":true,""verified"":true}]");

	Описание = НастройкиGitHub();
	Описание.Вставить("Имя", "github");
	Описание.Вставить("Пресет", "github");
	Описание.Вставить("Издатель", "oauth2:github");
	Вход = НовыйВход(Сессия, Описание);

	Начало = Вход.Начать();
	Ожидаем.Что(СтрНачинаетсяС(Начало.URL, "https://github.com/login/oauth/authorize?")).ЭтоИстина();

	Итог = Вход.Завершить(Начало.Транзакция, "код-от-github",
		Начало.Транзакция.Получить("Состояние"));

	Ожидаем.Что(Итог.Успех, Итог.Причина).ЭтоИстина();
	Ожидаем.Что(Итог.Субъект).Равно("583231");
	Ожидаем.Что(Итог.Издатель).Равно("oauth2:github");
	Ожидаем.Что(Итог.Email).Равно("octocat@users.example.com");
	Ожидаем.Что(Итог.EmailПодтверждён).ЭтоИстина();
	Ожидаем.Что(Итог.ПрофильПолучен).ЭтоИстина();
	Ожидаем.Что(Итог.Клеймы.Получить("login"), "сырое поле провайдера на месте").Равно("octocat");
	// профиль приведён к словарю OIDC: приложение читает клеймы одинаково у всех
	Ожидаем.Что(Итог.Клеймы.Получить("preferred_username")).Равно("octocat");
	Ожидаем.Что(Итог.Клеймы.Получить("sub")).Равно(583231);

КонецПроцедуры

// Приложение хранит конфигурацию провайдера у себя, поэтому развёрнутое пресетом обязано
// быть ему видно: иначе издатель, точки и маппинг заводятся второй копией на его стороне.
&Тест
Процедура ОписаниеОтдаётРазвёрнутыйПресет() Экспорт

	Описание = НастройкиGitHub();
	Описание.Вставить("Имя", "github");
	Описание.Вставить("Пресет", "github");
	Описание.Вставить("Издатель", "oauth2:github");

	Развёрнутое = НовыйВход(НоваяСессия(), Описание).Описание();
	Ожидаем.Что(Развёрнутое.Тип, "вид протокола из пресета").Равно("oauth2");
	Ожидаем.Что(Развёрнутое.КонечныеТочки.Получить("authorization_endpoint"),
		"конечные точки развёрнуты").Равно("https://github.com/login/oauth/authorize");
	Ожидаем.Что(Развёрнутое.АлиасыКлеймов.Получить("preferred_username"),
		"алиасы клеймов развёрнуты").Равно("login");
	Ожидаем.Что(Развёрнутое.Издатель, "заданное пресет не перебивает").Равно("oauth2:github");

	// у OIDC-пресета издателя подставляет он сам — приложению его иначе не узнать
	Свой = НастройкиOIDC();
	Свой.Вставить("Имя", "gitlab");
	Свой.Вставить("Пресет", "gitlab");
	Свой.Вставить("БазовыйАдрес", "https://git.example.com");
	Ожидаем.Что(НовыйВход(НоваяСессия(), Свой).Описание().Издатель,
		"издатель выведен из базового адреса").Равно("https://git.example.com");

КонецПроцедуры

#КонецОбласти

#Область СквознойВходOIDCЧерезDiscovery

&Тест
Процедура E2EВходЧерезOIDCDiscoveryПресетомGitLab() Экспорт

	// полный цикл второго пути: discovery-документ → авторизация → обмен кода
	// (id_token с проверкой iss/aud/nonce) → userinfo
	База = "https://git.example.com";
	Сессия = НоваяСессия();
	Сессия.ПриGET(База + "/.well-known/openid-configuration", 200, ТелоDiscovery(База));

	Описание = НастройкиOIDC();
	Описание.Вставить("Имя", "gitlab");
	Описание.Вставить("Пресет", "gitlab");
	Описание.Вставить("БазовыйАдрес", База);
	Вход = НовыйВход(Сессия, Описание);

	Начало = Вход.Начать();
	Ожидаем.Что(СтрНачинаетсяС(Начало.URL, База + "/oauth/authorize?")).ЭтоИстина();

	Клеймы = Новый Соответствие();
	Клеймы.Вставить("iss", База);
	Клеймы.Вставить("aud", "client-1");
	Клеймы.Вставить("sub", "42");
	Клеймы.Вставить("nonce", Начало.Транзакция.Получить("Одноразовость"));
	Клеймы.Вставить("exp", ВUnix(МоментТеста()) + 3600);
	Сессия.ПриPOST(База + "/oauth/token", 200,
		"{""access_token"":""AT-gitlab"",""token_type"":""Bearer"",""id_token"":""" + СобратьJWT(Клеймы) + """}");
	Сессия.ПриGET(База + "/oauth/userinfo", 200,
		"{""sub"":""42"",""email"":""dev@example.com"",""email_verified"":true}");

	Итог = Вход.Завершить(Начало.Транзакция, "код-от-gitlab",
		Начало.Транзакция.Получить("Состояние"));

	Ожидаем.Что(Итог.Успех, Итог.Причина).ЭтоИстина();
	Ожидаем.Что(Итог.Субъект).Равно("42");
	Ожидаем.Что(Итог.Издатель, "issuer — реальный, из discovery-конфигурации").Равно(База);
	Ожидаем.Что(Итог.Email).Равно("dev@example.com");
	Ожидаем.Что(Итог.EmailПодтверждён).ЭтоИстина();
	Ожидаем.Что(Итог.ПрофильПолучен).ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НоваяСессия()
	Возврат ЗагрузитьСценарий(ПутьФикстуры("СессияФейковая.os"));
КонецФункции

Функция ПутьФикстуры(Знач Имя)
	Файл = Новый Файл(ТекущийСценарий().Источник);
	Возврат ОбъединитьПути(Файл.Путь, "fixtures", Имя);
КонецФункции

Функция НастройкиGitHub()
	Настройки = Новый Структура();
	Настройки.Вставить("ИдентификаторКлиента", "Iv1.client");
	Настройки.Вставить("СекретКлиента", "s3cr3t");
	Настройки.Вставить("АдресВозврата", "https://app.example.com/callback");
	Возврат Настройки;
КонецФункции

Функция НастройкиOIDC()
	Настройки = Новый Структура();
	Настройки.Вставить("ИдентификаторКлиента", "client-1");
	Настройки.Вставить("СекретКлиента", "секрет-1");
	Настройки.Вставить("АдресВозврата", "https://app.example.com/callback");
	Возврат Настройки;
КонецФункции

Функция НовыйВход(Знач Сессия, Знач Описание)
	Часы = ЗагрузитьСценарий(ПутьФикстуры("ЧасыРучные.os"));
	Часы.УстановитьМомент(МоментТеста());

	Зависимости = Новый Структура();
	Зависимости.Вставить("Сессия", Сессия);
	Зависимости.Вставить("Часы", Часы);
	Зависимости.Вставить("Генератор", ЗагрузитьСценарий(ПутьФикстуры("ГенераторФиксированный.os")));
	Возврат Новый ВходЧерезПровайдера(Описание, Зависимости);
КонецФункции

Функция ТелоDiscovery(Знач База)
	М = Новый Соответствие();
	М.Вставить("issuer", База);
	М.Вставить("authorization_endpoint", База + "/oauth/authorize");
	М.Вставить("token_endpoint", База + "/oauth/token");
	М.Вставить("userinfo_endpoint", База + "/oauth/userinfo");
	М.Вставить("jwks_uri", База + "/oauth/discovery/keys");
	Возврат ВJSON(М);
КонецФункции

Функция СобратьJWT(Знач Клеймы)
	Заголовок = Новый Соответствие();
	Заголовок.Вставить("alg", "RS256");
	Заголовок.Вставить("typ", "JWT");
	Возврат КодированиеBase64URL.КодироватьСтроку(ВJSON(Заголовок))
		+ "." + КодированиеBase64URL.КодироватьСтроку(ВJSON(Клеймы))
		+ ".fakesignature";
КонецФункции

Функция ВJSON(Знач Данные)
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	Возврат Запись.Закрыть();
КонецФункции

Функция МоментТеста()
	Возврат Дата(2026, 7, 30, 12, 0, 0);
КонецФункции

Функция ВUnix(Знач Момент)
	Возврат Момент - Дата(1970, 1, 1, 0, 0, 0);
КонецФункции

#КонецОбласти
