#Использовать "../"
#Использовать asserts

// Тесты выхода у провайдера (OpenID Connect RP-Initiated Logout 1.0):
// сборка URL из end_session_endpoint, состав параметров и поведение там, где
// точки выхода нет — а нет её у OAuth2-провайдеров всегда.

&Тест
Процедура АдресВыходаСобираетсяИзDiscovery() Экспорт

	Сессия = НоваяСессия();
	Сессия.ПриGET("https://idp.example.com/.well-known/openid-configuration", 200, ТелоDiscovery());

	Адрес = НовыйВход(Сессия).АдресВыхода("id.jwt.token", "https://app.example.com/");

	Ожидаем.Что(СтрНачинаетсяС(Адрес, "https://idp.example.com/logout?")).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Адрес, "id_token_hint=id.jwt.token") > 0).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Адрес, "post_logout_redirect_uri=https%3A%2F%2Fapp.example.com%2F") > 0,
		"адрес возврата url-кодирован").ЭтоИстина();
	// client_id: допустимая по спецификации замена id_token_hint, и часть
	// провайдеров без него отказывается принимать post_logout_redirect_uri
	Ожидаем.Что(СтрНайти(Адрес, "client_id=client-1") > 0).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура БезТокенаИАдресаВозвратаОстаётсяТолькоClientId() Экспорт

	Сессия = НоваяСессия();
	Сессия.ПриGET("https://idp.example.com/.well-known/openid-configuration", 200, ТелоDiscovery());

	Адрес = НовыйВход(Сессия).АдресВыхода();

	Ожидаем.Что(СтрНайти(Адрес, "id_token_hint") = 0, "пустой хинт не отправляется").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Адрес, "post_logout_redirect_uri") = 0).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Адрес, "client_id=client-1") > 0).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПровайдерБезТочкиВыходаДаётПустуюСтроку() Экспорт

	// ЧТО ЭТОТ ТЕСТ ОХРАНЯЕТ. Соблазн бросить исключение здесь велик, но выход
	// без end_session_endpoint — штатный случай (его нет у всего OAuth2), и
	// приложение обязано просто погасить свою сессию, а не показать аварию.
	Тело = "{""issuer"":""https://idp.example.com"","
		+ """authorization_endpoint"":""https://idp.example.com/authorize"","
		+ """token_endpoint"":""https://idp.example.com/token""}";
	Сессия = НоваяСессия();
	Сессия.ПриGET("https://idp.example.com/.well-known/openid-configuration", 200, Тело);

	Ожидаем.Что(НовыйВход(Сессия).АдресВыхода("id.jwt.token", "https://app.example.com/")).Равно("");

КонецПроцедуры

&Тест
Процедура НедоступныйПровайдерДаётПустуюСтрокуАНеИсключение() Экспорт

	// discovery не ответил — выйти у провайдера не выйдет, но и падать незачем:
	// свою сессию приложение гасит в любом случае
	Сессия = НоваяСессия(); // ответ discovery не зарегистрирован

	Ожидаем.Что(НовыйВход(Сессия).АдресВыхода("id.jwt.token")).Равно("");

КонецПроцедуры

&Тест
Процедура OAuth2ПровайдерВыходаНеПредлагает() Экспорт

	Точки = Новый Структура();
	Точки.Вставить("Авторизация", "https://oauth.example.com/authorize");
	Точки.Вставить("Токен", "https://oauth.example.com/token");
	Точки.Вставить("Профиль", "https://api.example.com/user");

	Описание = Новый Структура();
	Описание.Вставить("Имя", "github-подобный");
	Описание.Вставить("Тип", "oauth2");
	Описание.Вставить("ИдентификаторКлиента", "client-1");
	Описание.Вставить("АдресВозврата", "https://app.example.com/callback");
	Описание.Вставить("КонечныеТочки", Точки);

	Вход = Новый ВходЧерезПровайдера(Описание, Новый Структура("Сессия", НоваяСессия()));

	Ожидаем.Что(Вход.АдресВыхода("любой-токен")).Равно("");

КонецПроцедуры

&Тест
Процедура РучнаяТочкаВыходаРаботаетБезDiscovery() Экспорт

	Точки = Новый Структура();
	Точки.Вставить("Авторизация", "https://idp.example.com/authorize");
	Точки.Вставить("Токен", "https://idp.example.com/token");
	Точки.Вставить("Выход", "https://idp.example.com/logout");

	Описание = ОписаниеПровайдера();
	Описание.Вставить("КонечныеТочки", Точки);

	// сети быть не должно: точки заданы вручную
	Вход = Новый ВходЧерезПровайдера(Описание, Новый Структура("Сессия", НоваяСессия()));

	Ожидаем.Что(СтрНачинаетсяС(Вход.АдресВыхода("id.jwt.token"),
		"https://idp.example.com/logout?")).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТочкаВыходаСоСвоимЗапросомПолучаетАмперсанд() Экспорт

	Точки = Новый Структура();
	Точки.Вставить("Авторизация", "https://idp.example.com/authorize");
	Точки.Вставить("Токен", "https://idp.example.com/token");
	Точки.Вставить("Выход", "https://idp.example.com/logout?realm=main");

	Описание = ОписаниеПровайдера();
	Описание.Вставить("КонечныеТочки", Точки);
	Вход = Новый ВходЧерезПровайдера(Описание, Новый Структура("Сессия", НоваяСессия()));

	Адрес = Вход.АдресВыхода("id.jwt.token");

	Ожидаем.Что(СтрНачинаетсяС(Адрес, "https://idp.example.com/logout?realm=main&")).ЭтоИстина();

КонецПроцедуры

// --- Служебные ---

Функция НоваяСессия()
	Файл = Новый Файл(ТекущийСценарий().Источник);
	Возврат ЗагрузитьСценарий(ОбъединитьПути(Файл.Путь, "fixtures", "СессияФейковая.os"));
КонецФункции

Функция ОписаниеПровайдера()
	Данные = Новый Структура();
	Данные.Вставить("Имя", "keycloak");
	Данные.Вставить("Издатель", "https://idp.example.com");
	Данные.Вставить("ИдентификаторКлиента", "client-1");
	Данные.Вставить("АдресВозврата", "https://app.example.com/callback");
	Возврат Данные;
КонецФункции

Функция НовыйВход(Знач Сессия)
	Возврат Новый ВходЧерезПровайдера(ОписаниеПровайдера(), Новый Структура("Сессия", Сессия));
КонецФункции

Функция ТелоDiscovery()
	Возврат "{""issuer"":""https://idp.example.com"","
		+ """authorization_endpoint"":""https://idp.example.com/authorize"","
		+ """token_endpoint"":""https://idp.example.com/token"","
		+ """userinfo_endpoint"":""https://idp.example.com/userinfo"","
		+ """end_session_endpoint"":""https://idp.example.com/logout""}";
КонецФункции
