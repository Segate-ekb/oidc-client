#Использовать "../"
#Использовать "../src/internal"
#Использовать asserts

// Тесты модуля КодированиеBase64URL: url-safe алфавит, отсутствие дополнения,
// восстановление дополнения при разборе, границы и негативные случаи.

&Тест
Процедура КодированиеБезДополнения() Экспорт

	// 1 байт → base64 "AA==" (2 значащих + 2 дополнения); base64url — без "="
	Данные = ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(Новый БуферДвоичныхДанных(1));
	Результат = КодированиеBase64URL.Кодировать(Данные);

	Ожидаем.Что(СтрНайти(Результат, "=")).Равно(0);
	Ожидаем.Что(Результат).Равно("AA");

КонецПроцедуры

&Тест
Процедура КодированиеИспользуетUrlSafeАлфавит() Экспорт

	// байты 0xFB 0xFF 0xBF в обычном base64 → "+/+/" ; в base64url → "-_-_"
	Буфер = Новый БуферДвоичныхДанных(3);
	Буфер[0] = 251; Буфер[1] = 255; Буфер[2] = 191;
	Результат = КодированиеBase64URL.Кодировать(ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(Буфер));

	Ожидаем.Что(СтрНайти(Результат, "+")).Равно(0);
	Ожидаем.Что(СтрНайти(Результат, "/")).Равно(0);
	Ожидаем.Что(Результат).Равно("-_-_");

КонецПроцедуры

&Тест
Процедура КодированиеСтрокиИОбратноUTF8() Экспорт

	Исходная = "Привет, OIDC! Ünïçödé";
	Закодировано = КодированиеBase64URL.КодироватьСтроку(Исходная);

	Ожидаем.Что(СтрНайти(Закодировано, "=")).Равно(0);
	Ожидаем.Что(КодированиеBase64URL.РаскодироватьВСтроку(Закодировано)).Равно(Исходная);

КонецПроцедуры

&Тест
Процедура РаскодированиеПринимаетСДополнениемИБез() Экспорт

	// "AQID" = байты 1,2,3 (кратно 4, без дополнения)
	Без = КодированиеBase64URL.Раскодировать("AQID");
	Ожидаем.Что(ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(Без).Размер).Равно(3);

	// то же значение с восстановлением дополнения: "AQ" → 1 байт
	Один = КодированиеBase64URL.Раскодировать("AQ");
	Буфер = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(Один);
	Ожидаем.Что(Буфер.Размер).Равно(1);
	Ожидаем.Что(Буфер[0]).Равно(1);

	// с явным дополнением тоже принимается
	СДополнением = КодированиеBase64URL.Раскодировать("AQ==");
	Ожидаем.Что(ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(СДополнением).Размер).Равно(1);

КонецПроцедуры

&Тест
Процедура РаскодированиеНедопустимогоСимволаВызываетИсключение() Экспорт

	Ожидаем.Что(БылоИсключение("Раскодировать", "не base64!")).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура РаскодированиеНедопустимойДлиныВызываетИсключение() Экспорт

	// длина по модулю 4 = 1 невозможна для base64
	Ожидаем.Что(БылоИсключение("Раскодировать", "A")).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура РаскодированиеНеСтрокиВызываетИсключение() Экспорт

	Ожидаем.Что(БылоИсключение("Раскодировать", 123)).ЭтоИстина();

КонецПроцедуры

// --- Служебные ---

Функция БылоИсключение(Знач ИмяМетода, Знач Аргумент)
	Попытка
		Если ИмяМетода = "Раскодировать" Тогда
			КодированиеBase64URL.Раскодировать(Аргумент);
		КонецЕсли;
	Исключение
		Возврат Истина;
	КонецПопытки;
	Возврат Ложь;
КонецФункции
