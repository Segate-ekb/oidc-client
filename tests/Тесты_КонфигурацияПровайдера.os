Процедура НеизвестныйСпособАутентификацииОтклоняется() Экспорт

	Данные = МинимальноеОписание();
	Данные.Вставить("СпособАутентификацииКлиента", "private_key_jwt");

	Ожидаем.Что(ОтклоненоОписание(Данные)).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура BasicБезСекретаОтклоняется() Экспорт

	Данные = МинимальноеОписание();
	Данные.Вставить("СпособАутентификацииКлиента", "client_secret_basic");

	Ожидаем.Что(ОтклоненоОписание(Данные)).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура СообщенияПроверкиНеНесутЗначенийСекретныхПолей() Экспорт

	// Библиотека не логирует — но текст ИСКЛЮЧЕНИЯ приложение почти наверняка запишет
	// в лог или покажет администратору. Поэтому сообщения проверки описания говорят об
	// ОТСУТСТВИИ поля (называют имя), а не о его значении: иначе client_secret уезжает
	// в журнал при первой же опечатке в конфигурации.
	Секрет = "супер-секрет-клиента-42";

	Данные = МинимальноеОписание();
	Данные.Вставить("СекретКлиента", Секрет);
	Данные.Вставить("СпособАутентификацииКлиента", "private_key_jwt"); // неизвестный способ
	Сообщение = СообщениеОтклонения(Данные);
	Ожидаем.Что(СтрНайти(Сообщение, Секрет) = 0,
		"неизвестный способ аутентификации: " + Сообщение).ЭтоИстина();
	Ожидаем.Что(Сообщение, "негодный способ назван").Содержит("private_key_jwt");

	// то же для «не заданы обязательные поля» — самый частый отказ на старте
	Данные = МинимальноеОписание();
	Данные.Вставить("СекретКлиента", Секрет);
	Данные.Вставить("ИдентификаторКлиента", "");
	Сообщение = СообщениеОтклонения(Данные);
	Ожидаем.Что(СтрНайти(Сообщение, Секрет) = 0,
		"отсутствие обязательного поля: " + Сообщение).ЭтоИстина();
	Ожидаем.Что(Сообщение, "имя недостающего поля названо").Содержит("ИдентификаторКлиента");

	// и для отказа, который САМ говорит про секрет: он называет поле, но не значение
	Данные = МинимальноеОписание();
	Данные.Вставить("СпособАутентификацииКлиента", "client_secret_basic");
	Сообщение = СообщениеОтклонения(Данные);
	Ожидаем.Что(СтрНайти(Сообщение, Секрет) = 0,
		"basic без секрета: " + Сообщение).ЭтоИстина();
	Ожидаем.Что(Сообщение, "поле названо по имени").Содержит("СекретКлиента");

КонецПроцедуры

&Тест
Процедура РучныеКонечныеТочкиПриводятсяКИменамDiscovery() Экспорт

	Точки = Новый Структура();
	Точки.Вставить("Авторизация", "https://idp.example.com/authorize");
	Точки.Вставить("Токен", "https://idp.example.com/token");
	Точки.Вставить("Профиль", "https://idp.example.com/userinfo");
	Данные = МинимальноеОписание();
	Данные.Вставить("КонечныеТочки", Точки);

	Провайдер = Новый КонфигурацияПровайдера(Данные);
	Метаданные = Провайдер.КонечныеТочки();

	Ожидаем.Что(Провайдер.ЕстьРучныеКонечныеТочки()).ЭтоИстина();
	Ожидаем.Что(Метаданные.Получить("authorization_endpoint")).Равно("https://idp.example.com/authorize");
	Ожидаем.Что(Метаданные.Получить("token_endpoint")).Равно("https://idp.example.com/token");
	Ожидаем.Что(Метаданные.Получить("userinfo_endpoint")).Равно("https://idp.example.com/userinfo");
	Ожидаем.Что(Метаданные.Получить("issuer"), "issuer добирается из конфигурации")
		.Равно("https://idp.example.com");
	// документ годится для МетаданныеПровайдера без переходников
	Ожидаем.Что(Новый МетаданныеПровайдера(Метаданные).КонечнаяТочкаТокена())
		.Равно("https://idp.example.com/token");

КонецПроцедуры

