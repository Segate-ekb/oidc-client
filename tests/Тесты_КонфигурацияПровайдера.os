КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

Функция МинимальноеОписание()
	Данные = Новый Структура();
	Данные.Вставить("Имя", "keycloak");
	Данные.Вставить("Издатель", "https://idp.example.com");
	Данные.Вставить("ИдентификаторКлиента", "client-1");
	Данные.Вставить("АдресВозврата", "https://app.example.com/callback");
	Возврат Данные;
КонецФункции

Функция ОписаниеСИменем(Знач Имя)
	Данные = МинимальноеОписание();
	Данные.Вставить("Имя", Имя);
	Возврат Данные;
КонецФункции

Функция МинимальноеОписаниеOAuth2()
	Точки = Новый Структура();
	Точки.Вставить("Авторизация", "https://oauth.example.com/authorize");
	Точки.Вставить("Токен", "https://oauth.example.com/token");
	Точки.Вставить("Профиль", "https://api.example.com/user");
	Данные = Новый Структура();
	Данные.Вставить("Имя", "github");
	Данные.Вставить("Тип", "oauth2");
	Данные.Вставить("ИдентификаторКлиента", "client-1");
	Данные.Вставить("АдресВозврата", "https://app.example.com/callback");
	Данные.Вставить("КонечныеТочки", Точки);
	Возврат Данные;
КонецФункции

// Текст исключения, которым описание отклонено ("" — если принято).
Функция СообщениеОтклонения(Знач Данные)
	Попытка
		Проба = Новый КонфигурацияПровайдера(Данные);
		Проба = Проба;
	Исключение
		Возврат ОписаниеОшибки();
	КонецПопытки;
	Возврат "";
КонецФункции

Функция ОтклоненоОписание(Знач Данные)
	Попытка
		Проба = Новый КонфигурацияПровайдера(Данные);
		Проба = Проба;
	Исключение
		Возврат Истина;
	КонецПопытки;
	Возврат Ложь;
КонецФункции

#КонецОбласти
