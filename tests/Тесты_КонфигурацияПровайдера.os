	Ожидаем.Что(Провайдер.ВидПротокола()).Равно("oidc");
	Ожидаем.Что(Провайдер.Издатель(), "issuer без завершающего слеша")
		.Равно("https://git.example.com");

КонецПроцедуры

&Тест
Процедура НеизвестныйПресетОтклоняется() Экспорт

	Данные = МинимальноеОписание();
	Данные.Вставить("Пресет", "нет-такого");

