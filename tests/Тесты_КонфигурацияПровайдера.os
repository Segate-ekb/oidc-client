#Использовать "../"
#Использовать "../src/internal"
#Использовать asserts

// Тесты модели конфигурации провайдера: обязательные поля, умолчания,
// нормализация имени, ручные конечные точки, разворот пресета.

&Тест
Процедура УмолчанияЗаполняютсяИзКоробки() Экспорт

	Провайдер = Новый КонфигурацияПровайдера(МинимальноеОписание());

	Ожидаем.Что(Провайдер.Имя()).Равно("keycloak");
	Ожидаем.Что(Провайдер.ВидПротокола()).Равно("oidc");
	Ожидаем.Что(Провайдер.Область()).Равно("openid profile email");
	Ожидаем.Что(Провайдер.ЛюфтСекунд()).Равно(60);
	Ожидаем.Что(Провайдер.СпособАутентификацииКлиента()).Равно("client_secret_post");
	Ожидаем.Что(Провайдер.СекретКлиента(), "публичный клиент допустим").Равно("");
	Ожидаем.Что(Провайдер.КонечныеТочки(), "без ручных точек работает discovery").Равно(Неопределено);
	Ожидаем.Что(Провайдер.ЕстьРучныеКонечныеТочки()).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ИмяНормализуетсяКНижнемуРегистру() Экспорт

	Данные = МинимальноеОписание();
	Данные.Вставить("Имя", "  KeyCloak-Main ");

	Ожидаем.Что(Новый КонфигурацияПровайдера(Данные).Имя()).Равно("keycloak-main");

КонецПроцедуры

&Тест
Процедура ИздательСохраняетЗавершающийСлеш() Экспорт

	// клейм iss сверяется побайтно (OIDC Core §3.1.3.7): "…/o/slug/" ≠ "…/o/slug"
	Данные = МинимальноеОписание();
	Данные.Вставить("Издатель", "https://sso.example.com/application/o/hub/");

	Ожидаем.Что(Новый КонфигурацияПровайдера(Данные).Издатель())
		.Равно("https://sso.example.com/application/o/hub/");

КонецПроцедуры

&Тест
Процедура ОтсутствиеОбязательныхПолейОтклоняется() Экспорт

	Для Каждого Поле Из СтрРазделить("Имя,Издатель,ИдентификаторКлиента,АдресВозврата", ",") Цикл
		Данные = МинимальноеОписание();
		Данные.Вставить(Поле, "");
		Ожидаем.Что(ОтклоненоОписание(Данные), "поле " + Поле + " обязательно").ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура НеизвестныйТипОтклоняется() Экспорт

	// описать провайдера, которого поток вести не умеет, — соврать конфигурацией.
	// До 0.3.0 здесь отклонялся «oauth2»; вместе с OAuth2-веткой (шаг 7.D) он
	// стал поддерживаемым, и негативом остаётся любой нереализованный протокол.
	Данные = МинимальноеОписание();
	Данные.Вставить("Тип", "saml");

	Ожидаем.Что(ОтклоненоОписание(Данные)).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура Oauth2БезИздателяПринимается() Экспорт

	// РЕЛАКСАЦИЯ 0.3.0: у OAuth2-провайдера издателя не существует — поле
	// необязательно. Заданный синтетический Издатель при этом сохраняется.
	Провайдер = Новый КонфигурацияПровайдера(МинимальноеОписаниеOAuth2());

	Ожидаем.Что(Провайдер.ВидПротокола()).Равно("oauth2");
	Ожидаем.Что(Провайдер.Издатель()).Равно("");
	Ожидаем.Что(Провайдер.Область(), "у oauth2 нет умолчания области").Равно("");

	Данные = МинимальноеОписаниеOAuth2();
	Данные.Вставить("Издатель", "oauth2:github");
	Ожидаем.Что(Новый КонфигурацияПровайдера(Данные).Издатель(),
		"синтетический издатель сохраняется как есть").Равно("oauth2:github");

КонецПроцедуры

&Тест
Процедура OidcБезИздателяПоПрежнемуОтклоняется() Экспорт

	// ОХРАННЫЙ ТЕСТ: необязательным Издатель стал ТОЛЬКО для oauth2.
	Данные = МинимальноеОписание();
	Данные.Вставить("Тип", "oidc");
	Данные.Вставить("Издатель", "");

	Ожидаем.Что(ОтклоненоОписание(Данные)).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура Oauth2БезРучныхКонечныхТочекОтклоняется() Экспорт

	// discovery в OAuth2 нет, а без userinfo не существует субъекта: каждая из
	// трёх точек обязательна.
	Для Каждого Точка Из СтрРазделить("Авторизация,Токен,Профиль", ",") Цикл
		Данные = МинимальноеОписаниеOAuth2();
		Данные.КонечныеТочки.Вставить(Точка, "");
		Ожидаем.Что(ОтклоненоОписание(Данные), "точка " + Точка + " обязательна").ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура МаппингПрофиляЗаполняетсяУмолчаниямиИПереопределяется() Экспорт

	Провайдер = Новый КонфигурацияПровайдера(МинимальноеОписаниеOAuth2());
	Маппинг = Провайдер.МаппингПрофиля();
	Ожидаем.Что(Маппинг.Получить("Субъект")).Равно("sub");
	Ожидаем.Что(Маппинг.Получить("Email")).Равно("email");
	Ожидаем.Что(Маппинг.Получить("EmailПодтверждён")).Равно("email_verified");

	Данные = МинимальноеОписаниеOAuth2();
	Свой = Новый Структура();
	Свой.Вставить("Субъект", "id");
	Данные.Вставить("МаппингПрофиля", Свой);
	Маппинг = Новый КонфигурацияПровайдера(Данные).МаппингПрофиля();
	Ожидаем.Что(Маппинг.Получить("Субъект"), "переопределён только Субъект").Равно("id");
	Ожидаем.Что(Маппинг.Получить("Email"), "остальные — умолчания").Равно("email");

КонецПроцедуры

&Тест
Процедура НеизвестныйКлючМаппингаПрофиляОтклоняется() Экспорт

	// опечатка в ключе маппинга молча дала бы «no_subject всем» — честнее упасть
	// на старте конфигурации
	Данные = МинимальноеОписаниеOAuth2();
	Свой = Новый Структура();
	Свой.Вставить("Логин", "login");
	Данные.Вставить("МаппингПрофиля", Свой);

	Ожидаем.Что(ОтклоненоОписание(Данные)).ЭтоИстина();

КонецПроцедуры

