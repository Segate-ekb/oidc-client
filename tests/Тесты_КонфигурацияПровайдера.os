КонецПроцедуры

&Тест
Процедура ПресетРазворачиваетсяВОписание() Экспорт

	Данные = Новый Структура();
	Данные.Вставить("Имя", "github");
	Данные.Вставить("Пресет", "github");
	Данные.Вставить("Издатель", "oauth2:github");
	Данные.Вставить("ИдентификаторКлиента", "Iv1.client");
	Данные.Вставить("СекретКлиента", "s3cr3t");
	Данные.Вставить("АдресВозврата", "https://app.example.com/callback");

	Провайдер = Новый КонфигурацияПровайдера(Данные);

	Ожидаем.Что(Провайдер.ВидПротокола()).Равно("oauth2");
	Ожидаем.Что(Провайдер.Область()).Равно("read:user user:email");
	Ожидаем.Что(Провайдер.КонечныеТочки().Получить("token_endpoint"))
		.Равно("https://github.com/login/oauth/access_token");
	Ожидаем.Что(Провайдер.КонечныеТочки().Получить("emails_endpoint"))
		.Равно("https://api.github.com/user/emails");
	Ожидаем.Что(Провайдер.МаппингПрофиля().Получить("Субъект"),
		"login переименовывается, в привязку идёт id").Равно("id");
	Ожидаем.Что(Провайдер.АлиасыКлеймов().Получить("preferred_username")).Равно("login");
	Ожидаем.Что(Провайдер.Издатель(), "синтетический издатель остаётся за приложением")
		.Равно("oauth2:github");

КонецПроцедуры

&Тест
Процедура ЯвноеПолеПеребиваетПресетАПустоеНет() Экспорт

	// ЧТО ЭТОТ ТЕСТ ОХРАНЯЕТ. Незаполненная графа формы админки приезжает пустой
	// строкой. Если считать её заданным значением, пресет затрётся пустотой и
	// провайдер молча потеряет области.
	Данные = Новый Структура();
	Данные.Вставить("Имя", "github");
	Данные.Вставить("Пресет", "github");
	Данные.Вставить("Издатель", "oauth2:github");
	Данные.Вставить("ИдентификаторКлиента", "Iv1.client");
	Данные.Вставить("СекретКлиента", "s3cr3t");
	Данные.Вставить("АдресВозврата", "https://app.example.com/callback");
	Данные.Вставить("Область", "");                       // не заполнено
	Провайдер = Новый КонфигурацияПровайдера(Данные);
	Ожидаем.Что(Провайдер.Область(), "пустая графа не стирает умолчание пресета")
		.Равно("read:user user:email");

	Данные.Вставить("Область", "read:org");               // заполнено явно
	Ожидаем.Что(Новый КонфигурацияПровайдера(Данные).Область()).Равно("read:org");

КонецПроцедуры

