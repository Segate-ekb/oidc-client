#Использовать "../"
#Использовать asserts

// Тесты обмена кода на токены (server-to-server POST на token endpoint):
// разбор ответа, состав формы, аутентификация клиента, обработка ошибок.

&Тест
Процедура УспешныйОбменРазбираетТокены() Экспорт

	Сессия = НоваяСессия();
	Сессия.ПриPOST("https://idp.example.com/token", 200, ТелоТокенов());
	Клиент = НовыйКлиент(Сессия, "секрет-1");

	Токены = Клиент.ОбменятьКодНаТокены("код-123", "verifier-abc");

	Ожидаем.Что(Токены.ТокенДоступа()).Равно("AT-xyz");
	Ожидаем.Что(Токены.ИдентификационныйТокен()).Равно("id.jwt.token");
	Ожидаем.Что(Токены.ТокенОбновления()).Равно("RT-456");
	Ожидаем.Что(Токены.ТипТокена()).Равно("Bearer");
	Ожидаем.Что(Токены.ЖивётСекунд()).Равно(3600);
	Ожидаем.Что(Токены.Область()).Равно("openid profile");

КонецПроцедуры

&Тест
Процедура ФормаСодержитОбязательныеПоляИСекрет() Экспорт

	Сессия = НоваяСессия();
	Сессия.ПриPOST("https://idp.example.com/token", 200, ТелоТокенов());
	Клиент = НовыйКлиент(Сессия, "секрет-1");

	Клиент.ОбменятьКодНаТокены("код-123", "verifier-abc");

	// Проверяем ПОЛЯ формы, а не строку тела: url-кодирование и Content-Type —
	// работа 1connector, и переписывать его тесты здесь незачем.
	Ожидаем.Что(Сессия.ПолеФормы("grant_type")).Равно("authorization_code");
	Ожидаем.Что(Сессия.ПолеФормы("code")).Равно("код-123");
	Ожидаем.Что(Сессия.ПолеФормы("code_verifier")).Равно("verifier-abc");
	Ожидаем.Что(Сессия.ПолеФормы("client_id")).Равно("client-1");
	Ожидаем.Что(Сессия.ПолеФормы("redirect_uri")).Равно("https://app.example.com/callback");
	// client_secret_post
	Ожидаем.Что(Сессия.ПолеФормы("client_secret")).Равно("секрет-1");
	Ожидаем.Что(Сессия.ЗаголовокПоследнего("Accept"),
		"без Accept GitHub отвечает формой, а не JSON").Равно("application/json");

КонецПроцедуры

&Тест
Процедура БезСекретаФормаНеСодержитClientSecret() Экспорт

	Сессия = НоваяСессия();
	Сессия.ПриPOST("https://idp.example.com/token", 200, ТелоТокенов());
	Клиент = НовыйКлиент(Сессия, ""); // публичный клиент, без секрета

	Клиент.ОбменятьКодНаТокены("код-123", "verifier-abc");

	Ожидаем.Что(Сессия.ПолеФормы("client_secret")).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура BasicПрячетСекретВЗаголовокАНеВТело() Экспорт

	// client_secret_basic (RFC 6749 §2.3.1) требуют, например, GitLab и часть
	// сборок Keycloak: секрет уходит в Authorization, а не в тело формы.
	Сессия = НоваяСессия();
	Сессия.ПриPOST("https://idp.example.com/token", 200, ТелоТокенов());
	Клиент = НовыйКлиентСоСпособом(Сессия, "секрет:с-двоеточием", "client_secret_basic");

	Клиент.ОбменятьКодНаТокены("код-123", "verifier-abc");

	Заголовок = Сессия.ЗаголовокПоследнего("Authorization");
	Ожидаем.Что(СтрНачинаетсяС(Заголовок, "Basic ")).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Заголовок, Символы.ПС) = 0, "в значении заголовка нет переводов строк").ЭтоИстина();
	// client_id:client_secret, каждый url-кодирован — двоеточие внутри секрета
	// не превращается в разделитель пары
	Ожидаем.Что(РаскодироватьBasic(Заголовок))
		.Равно("client-1:%D1%81%D0%B5%D0%BA%D1%80%D0%B5%D1%82%3A%D1%81-%D0%B4%D0%B2%D0%BE%D0%B5%D1%82%D0%BE%D1%87%D0%B8%D0%B5%D0%BC");
	Ожидаем.Что(Сессия.ПолеФормы("client_secret"), "секрета в форме нет").Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура СпособNoneНеОтправляетСекретВовсе() Экспорт

	Сессия = НоваяСессия();
	Сессия.ПриPOST("https://idp.example.com/token", 200, ТелоТокенов());
	Клиент = НовыйКлиентСоСпособом(Сессия, "секрет-1", "none");

	Клиент.ОбменятьКодНаТокены("код-123", "verifier-abc");

	Ожидаем.Что(Сессия.ПолеФормы("client_secret")).Равно(Неопределено);
	Ожидаем.Что(Сессия.ЗаголовокПоследнего("Authorization")).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ОшибкаТокенEndpointВызываетИсключение() Экспорт

	Тело = "{""error"":""invalid_grant"",""error_description"":""code expired""}";
	Сессия = НоваяСессия();
	Сессия.ПриPOST("https://idp.example.com/token", 400, Тело);
	Клиент = НовыйКлиент(Сессия, "секрет-1");

	Сообщение = "";
	Попытка
		Клиент.ОбменятьКодНаТокены("плохой-код", "verifier-abc");
	Исключение
		Сообщение = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(СтрДлина(Сообщение) > 0).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Сообщение, "invalid_grant") > 0).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПустойКодВызываетИсключение() Экспорт

	Сессия = НоваяСессия();
	Клиент = НовыйКлиент(Сессия, "секрет-1");

	Попытка
		Клиент.ОбменятьКодНаТокены("", "verifier-abc");
		Ожидаем.Что(Ложь, "ожидалось исключение на пустой код").ЭтоИстина();
	Исключение
		Ожидаем.Что(Истина).ЭтоИстина();
	КонецПопытки;

КонецПроцедуры

// --- Служебные ---

Функция НоваяСессия()
	Возврат ЗагрузитьСценарий(ПутьФикстуры("СессияФейковая.os"));
КонецФункции

Функция НовыйКлиент(Знач Сессия, Знач Секрет)
	Возврат НовыйКлиентСоСпособом(Сессия, Секрет, "client_secret_post");
КонецФункции

Функция НовыйКлиентСоСпособом(Знач Сессия, Знач Секрет, Знач Способ)
	Конфиг = Новый Структура;
	Конфиг.Вставить("Издатель", "https://idp.example.com");
	Конфиг.Вставить("ИдентификаторКлиента", "client-1");
	Конфиг.Вставить("СекретКлиента", Секрет);
	Конфиг.Вставить("АдресВозврата", "https://app.example.com/callback");
	Конфиг.Вставить("СпособАутентификацииКлиента", Способ);

	Клиент = Новый КлиентOIDC(Конфиг, Сессия);
	М = Новый Соответствие;
	М.Вставить("issuer", "https://idp.example.com");
	М.Вставить("authorization_endpoint", "https://idp.example.com/authorize");
	М.Вставить("token_endpoint", "https://idp.example.com/token");
	Клиент.УстановитьМетаданные(М);
	Возврат Клиент;
КонецФункции

Функция ТелоТокенов()
	Возврат "{""access_token"":""AT-xyz"",""id_token"":""id.jwt.token"","
		+ """refresh_token"":""RT-456"",""token_type"":""Bearer"","
		+ """expires_in"":3600,""scope"":""openid profile""}";
КонецФункции

// Значение заголовка "Basic <base64>" обратно в строку "client_id:client_secret".
Функция РаскодироватьBasic(Знач Заголовок)
	Кодированное = Сред(Строка(Заголовок), СтрДлина("Basic ") + 1);
	Возврат ПолучитьСтрокуИзДвоичныхДанных(Base64Значение(Кодированное), "UTF-8");
КонецФункции

Функция ПутьФикстуры(Знач Имя)
	Файл = Новый Файл(ТекущийСценарий().Источник);
	Возврат ОбъединитьПути(Файл.Путь, "fixtures", Имя);
КонецФункции
