#Использовать "../"
#Использовать "../src/internal"
#Использовать asserts

// Тесты discovery: загрузка .well-known/openid-configuration через инъекцию
// фейковой сессии (без сети), нормализация issuer, обязательные поля,
// негативные случаи.

&Тест
Процедура ЗагрузкаМетаданныхРазбираетКонечныеТочки() Экспорт

	Сессия = НоваяСессия();
	ЗарегистрироватьDiscovery(Сессия, "https://idp.example.com");
	Клиент = НовыйКлиент(Сессия, "https://idp.example.com");

	Метаданные = Клиент.ЗагрузитьМетаданные();

	Ожидаем.Что(Метаданные.Издатель()).Равно("https://idp.example.com");
	Ожидаем.Что(Метаданные.КонечнаяТочкаАвторизации()).Равно("https://idp.example.com/authorize");
	Ожидаем.Что(Метаданные.КонечнаяТочкаТокена()).Равно("https://idp.example.com/token");
	Ожидаем.Что(Метаданные.КонечнаяТочкаПрофиля()).Равно("https://idp.example.com/userinfo");
	Ожидаем.Что(Метаданные.КонечнаяТочкаКлючей()).Равно("https://idp.example.com/jwks");
	// URL discovery собран корректно
	Ожидаем.Что(Сессия.ПоследнийURL()).Равно("https://idp.example.com/.well-known/openid-configuration");

КонецПроцедуры

&Тест
Процедура IssuerСЗавершающимСлешемНормализуется() Экспорт

	Сессия = НоваяСессия();
	ЗарегистрироватьDiscovery(Сессия, "https://idp.example.com");
	// issuer задан со слешем — discovery-URL не должен содержать двойной слеш
	Клиент = НовыйКлиент(Сессия, "https://idp.example.com/");

	Клиент.ЗагрузитьМетаданные();

	Ожидаем.Что(Сессия.ПоследнийURL()).Равно("https://idp.example.com/.well-known/openid-configuration");

КонецПроцедуры

&Тест
Процедура IssuerСоСлешемНеЛомаетСверкуIss() Экспорт

	// Регрессия: у Authentik per-application issuer оканчивается на "/" и ровно
	// в таком виде приходит в клейме iss. Нормализация не должна затрагивать
	// значение, с которым сверяется iss, — только URL discovery.
	Издатель = "https://sso.example.com/application/o/test/";
	Сессия = НоваяСессия();
	Сессия.ПриGET("https://sso.example.com/application/o/test/.well-known/openid-configuration",
		200, ТелоDiscovery(Издатель));
	Клиент = НовыйКлиент(Сессия, Издатель);

	Клиент.ЗагрузитьМетаданные();
	Клеймы = Клиент.ПроверитьИдентификационныйТокен(ТокенСIss(Издатель), Неопределено);

	Ожидаем.Что(Клеймы.Получить("sub")).Равно("user-42");

КонецПроцедуры

&Тест
Процедура IssБезСлешаПриIssuerСоСлешемОтклоняется() Экспорт

	// Обратная сторона точной сверки: значения различаются — токен не наш.
	Издатель = "https://sso.example.com/application/o/test/";
	Клиент = НовыйКлиент(НоваяСессия(), Издатель);

	Попытка
		Клиент.ПроверитьИдентификационныйТокен(
			ТокенСIss("https://sso.example.com/application/o/test"), Неопределено);
		Ожидаем.Что(Ложь, "ожидалось исключение при несовпадении iss").ЭтоИстина();
	Исключение
		Ожидаем.Что(Истина).ЭтоИстина();
	КонецПопытки;

КонецПроцедуры

&Тест
Процедура МетаданныеАвтозагружаютсяПриПервомОбращении() Экспорт

	Сессия = НоваяСессия();
	ЗарегистрироватьDiscovery(Сессия, "https://idp.example.com");
	Клиент = НовыйКлиент(Сессия, "https://idp.example.com");

	// Метаданные() без явного ЗагрузитьМетаданные должны вызвать discovery
	Метаданные = Клиент.Метаданные();
	Ожидаем.Что(Метаданные.КонечнаяТочкаТокена()).Равно("https://idp.example.com/token");

КонецПроцедуры

&Тест
Процедура DiscoveryНе200ВызываетИсключение() Экспорт

	Сессия = НоваяСессия();
	Сессия.ПриGET("https://idp.example.com/.well-known/openid-configuration", 404, "not found");
	Клиент = НовыйКлиент(Сессия, "https://idp.example.com");

	Попытка
		Клиент.ЗагрузитьМетаданные();
		Ожидаем.Что(Ложь, "ожидалось исключение при 404 discovery").ЭтоИстина();
	Исключение
		Ожидаем.Что(Истина).ЭтоИстина();
	КонецПопытки;

КонецПроцедуры

&Тест
Процедура ОтсутствиеОбязательногоПоляВызываетИсключение() Экспорт

	// discovery без token_endpoint
	Тело = "{""issuer"":""https://idp.example.com"",""authorization_endpoint"":""https://idp.example.com/authorize""}";
	Сессия = НоваяСессия();
	Сессия.ПриGET("https://idp.example.com/.well-known/openid-configuration", 200, Тело);
	Клиент = НовыйКлиент(Сессия, "https://idp.example.com");

	Попытка
		Клиент.ЗагрузитьМетаданные();
		Ожидаем.Что(Ложь, "ожидалось исключение без token_endpoint").ЭтоИстина();
	Исключение
		Ожидаем.Что(Истина).ЭтоИстина();
	КонецПопытки;

КонецПроцедуры

&Тест
Процедура DiscoveryБезIssuerОтклоняется() Экспорт

	// В-2 ревью 7.D: ослабление issuer в МетаданныеПровайдера (0.3.0) — ТОЛЬКО
	// для ручных конечных точек OAuth2. Документ discovery без issuer — брак
	// документа, принимать его молча нельзя.
	Тело = "{""authorization_endpoint"":""https://idp.example.com/authorize"","
		+ """token_endpoint"":""https://idp.example.com/token""}";
	Сессия = НоваяСессия();
	Сессия.ПриGET("https://idp.example.com/.well-known/openid-configuration", 200, Тело);
	Клиент = НовыйКлиент(Сессия, "https://idp.example.com");

	// ловим сообщение отдельно от ассертов: ассерт внутри Попытки сам бросает
	// исключение, и проверка «Содержит» прошла бы по его же тексту
	Сообщение = "";
	Попытка
		Клиент.ЗагрузитьМетаданные();
	Исключение
		Сообщение = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(СтрДлина(Сообщение) > 0, "discovery без issuer принят молча").ЭтоИстина();
	Ожидаем.Что(Сообщение, "ошибка называет недостающее поле").Содержит("issuer");

КонецПроцедуры

&Тест
Процедура МетаданныеПоУмолчаниюТребуютIssuer() Экспорт

	// закрепляет контракт конструктора: без явного ТребоватьИздателя = Ложь
	// issuer обязателен — ослабление не «по умолчанию», а по осознанному выбору
	// вызывающего (путь ручных точек в КлиентOIDC)
	М = МетаданныеСоответствие("https://idp.example.com");
	М.Удалить("issuer");

	Сообщение = "";
	Попытка
		Проба = Новый МетаданныеПровайдера(М);
		Проба = Проба;
	Исключение
		Сообщение = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(СтрДлина(Сообщение) > 0, "метаданные без issuer приняты молча").ЭтоИстина();
	Ожидаем.Что(Сообщение).Содержит("issuer");

КонецПроцедуры

&Тест
Процедура ЗагрузитьМетаданныеБезИздателяДаётВнятнуюОшибку() Экспорт

	// М-1 ревью 7.D: клиент без Издателя (достижим с 0.3.0) не должен идти в
	// сеть за discovery по пустому адресу — ошибка называет причину, а не
	// проявляется как загадочный сетевой отказ на URL "/.well-known/..."
	Конфиг = Новый Структура;
	Конфиг.Вставить("ИдентификаторКлиента", "клиент-1");
	Конфиг.Вставить("АдресВозврата", "https://app.example.com/callback");
	Клиент = Новый КлиентOIDC(Конфиг, НоваяСессия()); // сети быть не должно

	Сообщение = "";
	Попытка
		Клиент.ЗагрузитьМетаданные();
	Исключение
		Сообщение = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(СтрДлина(Сообщение) > 0, "discovery без Издателя не упал").ЭтоИстина();
	Ожидаем.Что(Сообщение, "причина названа по имени поля").Содержит("Издатель");

КонецПроцедуры

&Тест
Процедура УстановкаМетаданныхВручнуюБезСети() Экспорт

	Сессия = НоваяСессия(); // ничего не регистрируем — сети быть не должно
	Клиент = НовыйКлиент(Сессия, "https://idp.example.com");

	Клиент.УстановитьМетаданные(МетаданныеСоответствие("https://idp.example.com"));

	Ожидаем.Что(Клиент.Метаданные().КонечнаяТочкаТокена()).Равно("https://idp.example.com/token");

КонецПроцедуры

// --- Служебные ---

Функция НоваяСессия()
	Возврат ЗагрузитьСценарий(ПутьФикстуры("СессияФейковая.os"));
КонецФункции

Функция НовыйКлиент(Знач Сессия, Знач Издатель)
	Конфиг = Новый Структура;
	Конфиг.Вставить("Издатель", Издатель);
	Конфиг.Вставить("ИдентификаторКлиента", "клиент-1");
	Конфиг.Вставить("АдресВозврата", "https://app.example.com/callback");
	Возврат Новый КлиентOIDC(Конфиг, Сессия);
КонецФункции

Функция МетаданныеСоответствие(Знач Издатель)
	М = Новый Соответствие;
	М.Вставить("issuer", Издатель);
	М.Вставить("authorization_endpoint", Издатель + "/authorize");
	М.Вставить("token_endpoint", Издатель + "/token");
	М.Вставить("userinfo_endpoint", Издатель + "/userinfo");
	М.Вставить("jwks_uri", Издатель + "/jwks");
	Возврат М;
КонецФункции

Процедура ЗарегистрироватьDiscovery(Знач Сессия, Знач Издатель)
	Сессия.ПриGET(Издатель + "/.well-known/openid-configuration", 200, ТелоDiscovery(Издатель));
КонецПроцедуры

Функция ТелоDiscovery(Знач Издатель)
	Возврат ВJSON(МетаданныеСоответствие(Издатель));
КонецФункции

// id_token с заданным iss: aud = client_id из НовыйКлиент, exp — заведомо в будущем
// (часы здесь системные, ручные не инъектируются).
Функция ТокенСIss(Знач Издатель)
	Клеймы = Новый Соответствие;
	Клеймы.Вставить("iss", Издатель);
	Клеймы.Вставить("aud", "клиент-1");
	Клеймы.Вставить("sub", "user-42");
	Клеймы.Вставить("exp", (Дата(2100, 1, 1) - Дата(1970, 1, 1)));

	Заголовок = Новый Соответствие;
	Заголовок.Вставить("alg", "RS256");
	Заголовок.Вставить("typ", "JWT");

	Возврат КодированиеBase64URL.КодироватьСтроку(ВJSON(Заголовок))
		+ "." + КодированиеBase64URL.КодироватьСтроку(ВJSON(Клеймы))
		+ ".fakesignature";
КонецФункции

Функция ВJSON(Знач Данные)
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	Возврат Запись.Закрыть();
КонецФункции

Функция ПутьФикстуры(Знач Имя)
	Файл = Новый Файл(ТекущийСценарий().Источник);
	Возврат ОбъединитьПути(Файл.Путь, "fixtures", Имя);
КонецФункции
