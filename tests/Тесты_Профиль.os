#Использовать "../"
#Использовать asserts

// Тесты запроса userinfo: разбор клеймов, заголовок Authorization, негативы.

&Тест
Процедура ПрофильВозвращаетКлеймы() Экспорт

	Тело = "{""sub"":""user-42"",""email"":""u@example.com"",""email_verified"":true,""groups"":[""dev"",""ops""]}";
	Сессия = НоваяСессия();
	Сессия.ПриGET("https://idp.example.com/userinfo", 200, Тело);
	Клиент = НовыйКлиент(Сессия);

	Профиль = Клиент.ПолучитьПрофиль("AT-xyz");

	Ожидаем.Что(Профиль.Получить("sub")).Равно("user-42");
	Ожидаем.Что(Профиль.Получить("email")).Равно("u@example.com");
	Ожидаем.Что(Профиль.Получить("email_verified")).Равно(Истина);
	Ожидаем.Что(Профиль.Получить("groups").Количество()).Равно(2);
	// заголовок Bearer выставлен
	Ожидаем.Что(Сессия.ЗаголовокПоследнего("Authorization")).Равно("Bearer AT-xyz");

КонецПроцедуры

&Тест
Процедура UserinfoНе200ВызываетИсключение() Экспорт

	Сессия = НоваяСессия();
	Сессия.ПриGET("https://idp.example.com/userinfo", 401, "unauthorized");
	Клиент = НовыйКлиент(Сессия);

	Попытка
		Клиент.ПолучитьПрофиль("AT-xyz");
		Ожидаем.Что(Ложь, "ожидалось исключение при 401 userinfo").ЭтоИстина();
	Исключение
		Ожидаем.Что(Истина).ЭтоИстина();
	КонецПопытки;

КонецПроцедуры

&Тест
Процедура БезUserinfoEndpointВызываетИсключение() Экспорт

	Сессия = НоваяСессия();
	Клиент = НовыйКлиентБезUserinfo(Сессия);

	Попытка
		Клиент.ПолучитьПрофиль("AT-xyz");
		Ожидаем.Что(Ложь, "ожидалось исключение без userinfo_endpoint").ЭтоИстина();
	Исключение
		Ожидаем.Что(Истина).ЭтоИстина();
	КонецПопытки;

КонецПроцедуры

&Тест
Процедура ПустойТокенДоступаВызываетИсключение() Экспорт

	Клиент = НовыйКлиент(НоваяСессия());

	Попытка
		Клиент.ПолучитьПрофиль("");
		Ожидаем.Что(Ложь, "ожидалось исключение на пустой токен").ЭтоИстина();
	Исключение
		Ожидаем.Что(Истина).ЭтоИстина();
	КонецПопытки;

КонецПроцедуры

// --- Служебные ---

Функция НоваяСессия()
	Возврат ЗагрузитьСценарий(ПутьФикстуры("СессияФейковая.os"));
КонецФункции

Функция НовыйКлиент(Знач Сессия)
	Клиент = БазовыйКлиент(Сессия);
	М = БазовыеМетаданные();
	М.Вставить("userinfo_endpoint", "https://idp.example.com/userinfo");
	Клиент.УстановитьМетаданные(М);
	Возврат Клиент;
КонецФункции

Функция НовыйКлиентБезUserinfo(Знач Сессия)
	Клиент = БазовыйКлиент(Сессия);
	Клиент.УстановитьМетаданные(БазовыеМетаданные()); // без userinfo_endpoint
	Возврат Клиент;
КонецФункции

Функция БазовыйКлиент(Знач Сессия)
	Конфиг = Новый Структура;
	Конфиг.Вставить("Издатель", "https://idp.example.com");
	Конфиг.Вставить("ИдентификаторКлиента", "client-1");
	Конфиг.Вставить("АдресВозврата", "https://app.example.com/callback");
	Возврат Новый КлиентOIDC(Конфиг, Сессия);
КонецФункции

Функция БазовыеМетаданные()
	М = Новый Соответствие;
	М.Вставить("issuer", "https://idp.example.com");
	М.Вставить("authorization_endpoint", "https://idp.example.com/authorize");
	М.Вставить("token_endpoint", "https://idp.example.com/token");
	Возврат М;
КонецФункции

Функция ПутьФикстуры(Знач Имя)
	Файл = Новый Файл(ТекущийСценарий().Источник);
	Возврат ОбъединитьПути(Файл.Путь, "fixtures", Имя);
КонецФункции
