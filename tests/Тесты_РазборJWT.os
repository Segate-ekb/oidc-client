#Использовать "../"
#Использовать "../src/internal"
#Использовать asserts

// Тесты модуля РазборJWT: чтение полезной нагрузки и заголовка, негативные
// случаи (не три сегмента, не JSON, не строка). Подпись НЕ проверяется.

&Тест
Процедура ЧтениеПолезнойНагрузки() Экспорт

	Клеймы = Новый Соответствие;
	Клеймы.Вставить("sub", "user-42");
	Клеймы.Вставить("iss", "https://idp.example.com");
	Клеймы.Вставить("exp", 1893456000);

	Токен = СобратьJWT(Клеймы, "RS256");
	Разобрано = РазборJWT.ПрочитатьПолезнуюНагрузку(Токен);

	Ожидаем.Что(Разобрано.Получить("sub")).Равно("user-42");
	Ожидаем.Что(Разобрано.Получить("iss")).Равно("https://idp.example.com");
	Ожидаем.Что(Разобрано.Получить("exp")).Равно(1893456000);

КонецПроцедуры

&Тест
Процедура ЧтениеЗаголовка() Экспорт

	Токен = СобратьJWT(Новый Соответствие, "RS256");
	Заголовок = РазборJWT.ПрочитатьЗаголовок(Токен);

	Ожидаем.Что(Заголовок.Получить("alg")).Равно("RS256");
	Ожидаем.Что(Заголовок.Получить("typ")).Равно("JWT");

КонецПроцедуры

&Тест
Процедура НеТриСегментаВызываетИсключение() Экспорт

	Ожидаем.Что(БылоИсключение("a.b")).ЭтоИстина();       // два сегмента
	Ожидаем.Что(БылоИсключение("a.b.c.d")).ЭтоИстина();   // четыре

КонецПроцедуры

&Тест
Процедура НеJSONВНагрузкеВызываетИсключение() Экспорт

	// нагрузка — base64url валидного текста, но не JSON-объекта
	НеОбъект = КодированиеBase64URL.КодироватьСтроку("просто текст");
	Токен = "заголовок." + НеОбъект + ".подпись";

	Ожидаем.Что(БылоИсключение(Токен)).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПустаяИНеСтрокаВызываютИсключение() Экспорт

	Ожидаем.Что(БылоИсключение("")).ЭтоИстина();
	Ожидаем.Что(БылоИсключение(Неопределено)).ЭтоИстина();

КонецПроцедуры

// --- Служебные ---

Функция БылоИсключение(Знач Токен)
	Попытка
		РазборJWT.ПрочитатьПолезнуюНагрузку(Токен);
	Исключение
		Возврат Истина;
	КонецПопытки;
	Возврат Ложь;
КонецФункции

Функция СобратьJWT(Знач Клеймы, Знач Алгоритм)
	Заголовок = Новый Соответствие;
	Заголовок.Вставить("alg", Алгоритм);
	Заголовок.Вставить("typ", "JWT");
	Возврат КодированиеBase64URL.КодироватьСтроку(ВJSON(Заголовок))
		+ "." + КодированиеBase64URL.КодироватьСтроку(ВJSON(Клеймы))
		+ ".fakesignature";
КонецФункции

Функция ВJSON(Знач Данные)
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	Возврат Запись.Закрыть();
КонецФункции
