#Использовать "../"
#Использовать "../src/internal"
#Использовать asserts

// Тесты сравнения, безопасного по времени (модуль СравнениеСекретов). Проверяется
// ПОВЕДЕНИЕ (что считается равным), а не время выполнения: измерять такты в
// юнит-тесте — гадание, а вот «равно/не равно» обязано быть точным.

&Тест
Процедура ОдинаковыеСтрокиРавны() Экспорт

	Ожидаем.Что(СравнениеСекретов.БезопасноеРавенство("state-abc", "state-abc")).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура РасхождениеВЛюбойПозицииДаётНеравенство() Экспорт

	Ожидаем.Что(СравнениеСекретов.БезопасноеРавенство("Xbcdef", "abcdef"), "первый символ").ЭтоЛожь();
	Ожидаем.Что(СравнениеСекретов.БезопасноеРавенство("abcdeX", "abcdef"), "последний символ").ЭтоЛожь();
	Ожидаем.Что(СравнениеСекретов.БезопасноеРавенство("abXdef", "abcdef"), "середина").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура РазнаяДлинаДаётНеравенство() Экспорт

	Ожидаем.Что(СравнениеСекретов.БезопасноеРавенство("abc", "abcd")).ЭтоЛожь();
	Ожидаем.Что(СравнениеСекретов.БезопасноеРавенство("abcd", "abc")).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура РегистрИПробелыЗначимы() Экспорт

	// state сверяется побайтно: «почти совпало» — это не совпало
	Ожидаем.Что(СравнениеСекретов.БезопасноеРавенство("State", "state")).ЭтоЛожь();
	Ожидаем.Что(СравнениеСекретов.БезопасноеРавенство(" state", "state")).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ДвеПустыеСтрокиФормальноРавны() Экспорт

	// сама функция сравнения — про равенство, а не про пригодность значения
	Ожидаем.Что(СравнениеСекретов.БезопасноеРавенство("", "")).ЭтоИстина();
	Ожидаем.Что(СравнениеСекретов.БезопасноеРавенство(Неопределено, Неопределено)).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура НепустоеИРавноТребуетНепустогоОжидания() Экспорт

	// «нечего сверять» не должно открывать вход: именно так проверяется state
	Ожидаем.Что(СравнениеСекретов.НепустоеИРавно("", "")).ЭтоЛожь();
	Ожидаем.Что(СравнениеСекретов.НепустоеИРавно("   ", "   ")).ЭтоЛожь();
	Ожидаем.Что(СравнениеСекретов.НепустоеИРавно("state-1", "state-1")).ЭтоИстина();
	Ожидаем.Что(СравнениеСекретов.НепустоеИРавно("state-1", "state-2")).ЭтоЛожь();

КонецПроцедуры
