#Использовать "../"
#Использовать "../src/internal"
#Использовать asserts

// Тесты модели транзакции авторизации: обязательные поля, сериализация без URL,
// восстановление из представления, чтение ключей в любом регистре.
//
// Хранилища здесь нет намеренно: библиотека транзакции НЕ ХРАНИТ. Начать отдаёт
// её Соответствием, приложение кладёт куда хочет и возвращает в Завершить.

#Область Модель

&Тест
Процедура ТранзакцияОтдаётСохранённыеЗначения() Экспорт

	Транзакция = НоваяТранзакция();

	Ожидаем.Что(Транзакция.Провайдер()).Равно("keycloak");
	Ожидаем.Что(Транзакция.Состояние()).Равно("state-1");
	Ожидаем.Что(Транзакция.Одноразовость()).Равно("nonce-1");
	Ожидаем.Что(Транзакция.ПроверочныйКод()).Равно("verifier-1");
	Ожидаем.Что(Транзакция.Контекст()).Равно(7);
	Ожидаем.Что(Транзакция.URL()).Равно("https://idp.example.com/authorize?x=1");

КонецПроцедуры

&Тест
Процедура БезПровайдераИлиStateТранзакцияНеСоздаётся() Экспорт

	Ожидаем.Что(Отклонена(Новый Структура("Провайдер, Состояние", "", "state-1"))).ЭтоИстина();
	Ожидаем.Что(Отклонена(Новый Структура("Провайдер, Состояние", "keycloak", ""))).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПредставлениеДляХранилищаНеСодержитURL() Экспорт

	// URL после редиректа бесполезен и содержит те же state/nonce — второй
	// экземпляр секрета в хранилище ни к чему.
	Данные = НоваяТранзакция().КакСоответствие();

	Ожидаем.Что(Данные.Получить("URL")).Равно(Неопределено);
	Ожидаем.Что(Данные.Получить("Провайдер")).Равно("keycloak");
	Ожидаем.Что(Данные.Получить("Состояние")).Равно("state-1");
	Ожидаем.Что(Данные.Получить("Одноразовость")).Равно("nonce-1");
	Ожидаем.Что(Данные.Получить("ПроверочныйКод")).Равно("verifier-1");
	Ожидаем.Что(Данные.Получить("Контекст")).Равно(7);

КонецПроцедуры

&Тест
Процедура ТранзакцияВосстанавливаетсяИзСвоегоПредставления() Экспорт

	Восстановленная = Новый ТранзакцияАвторизации(НоваяТранзакция().КакСоответствие());

	Ожидаем.Что(Восстановленная.Провайдер()).Равно("keycloak");
	Ожидаем.Что(Восстановленная.Одноразовость()).Равно("nonce-1");
	Ожидаем.Что(Восстановленная.ПроверочныйКод()).Равно("verifier-1");
	Ожидаем.Что(Восстановленная.Контекст()).Равно(7);
	Ожидаем.Что(Восстановленная.URL(), "URL не восстанавливается — его и не хранили").Равно("");

КонецПроцедуры

&Тест
Процедура КлючиПредставленияЧитаютсяВЛюбомРегистре() Экспорт

	// хранилища (сессии, JSON-поля БД) нередко приводят имена ключей
	Данные = Новый Соответствие();
	Данные.Вставить("провайдер", "keycloak");
	Данные.Вставить("состояние", "state-1");
	Данные.Вставить("одноразовость", "nonce-1");
	Данные.Вставить("проверочныйкод", "verifier-1");

	Транзакция = Новый ТранзакцияАвторизации(Данные);

	Ожидаем.Что(Транзакция.Провайдер()).Равно("keycloak");
	Ожидаем.Что(Транзакция.Одноразовость()).Равно("nonce-1");
	Ожидаем.Что(Транзакция.ПроверочныйКод()).Равно("verifier-1");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НоваяТранзакция()
	Данные = Новый Структура();
	Данные.Вставить("Провайдер", "keycloak");
	Данные.Вставить("Состояние", "state-1");
	Данные.Вставить("Одноразовость", "nonce-1");
	Данные.Вставить("ПроверочныйКод", "verifier-1");
	Данные.Вставить("Контекст", 7);
	Данные.Вставить("URL", "https://idp.example.com/authorize?x=1");
	Возврат Новый ТранзакцияАвторизации(Данные);
КонецФункции

Функция Отклонена(Знач Данные)
	Попытка
		Проба = Новый ТранзакцияАвторизации(Данные);
		Проба = Проба;
	Исключение
		Возврат Истина;
	КонецПопытки;
	Возврат Ложь;
КонецФункции

#КонецОбласти
