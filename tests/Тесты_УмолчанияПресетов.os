#Использовать "../"
#Использовать "../src/internal"
#Использовать asserts

// Пресеты снаружи: чтение их умолчаний приложением и правило «явно заданное
// побеждает пресет». На этом приложение строит свои области доступа.

#Область ЧтениеУмолчаний

&Тест
Процедура КлючиПовторяютРеестрПресетов() Экспорт

	// ЧТО ЭТОТ ТЕСТ ОХРАНЯЕТ. Из этого списка приложение рисует выбор пресета.
	// Похудевший список — пропавшая кнопка входа, а не отказ на входе.
	Реестр = ПресетыПровайдеров.Ключи();
	Ключи = Новый УмолчанияПресетов().Ключи();

	Ожидаем.Что(Ключи.Количество(), "число пресетов").Равно(Реестр.Количество());
	Для Индекс = 0 По Реестр.Количество() - 1 Цикл
		Ожидаем.Что(Ключи[Индекс], "пресет №" + Индекс).Равно(Реестр[Индекс]);
	КонецЦикла;

	// три пресета обещаны README
	Ожидаем.Что(Ключи.Найти("github") <> Неопределено, "github на месте").ЭтоИстина();
	Ожидаем.Что(Ключи.Найти("gitlab") <> Неопределено, "gitlab на месте").ЭтоИстина();
	Ожидаем.Что(Ключи.Найти("google") <> Неопределено, "google на месте").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура КаждыйКлючРеестраОтдаётУмолчания() Экспорт

	Пресеты = Новый УмолчанияПресетов();

	Ожидаем.Что(Пресеты.Ключи().Количество(), "реестр пресетов не пуст").Больше(0);
	Для Каждого Ключ Из Пресеты.Ключи() Цикл
		Умолчания = Пресеты.Умолчания(Ключ, НастройкиПресета(Ключ));
		Ожидаем.Что(ТипЗнч(Умолчания), Ключ).Равно(Тип("Структура"));
		Ожидаем.Что(Умолчания.Свойство("Тип"), Ключ + ": вид протокола").ЭтоИстина();
		Ожидаем.Что(Умолчания.Свойство("Область"), Ключ + ": область").ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура УмолчанийХватаетЧтобыПовторитьПресетБезНего() Экспорт

	// ЧТО ЭТОТ ТЕСТ ОХРАНЯЕТ. Приложение читает умолчания, чтобы дописать к ним
	// своё. Если отданного не хватает на описание провайдера, дописывать не к
	// чему: часть настройки провайдера пришлось бы завести у себя второй копией.
	Для Каждого Ключ Из Новый УмолчанияПресетов().Ключи() Цикл

		ПоПресету = РазвёрнутоеОписание(СПресетом(Ключ));
		ПоУмолчаниям = РазвёрнутоеОписание(ИзУмолчаний(Ключ));

		Ожидаем.Что(ПоУмолчаниям.Тип, Ключ + ": вид протокола").Равно(ПоПресету.Тип);
		Ожидаем.Что(ПоУмолчаниям.Область, Ключ + ": область").Равно(ПоПресету.Область);
		Ожидаем.Что(ПоУмолчаниям.Издатель, Ключ + ": издатель").Равно(ПоПресету.Издатель);
		СверитьКарты(ПоПресету.КонечныеТочки, ПоУмолчаниям.КонечныеТочки, Ключ + ": конечные точки");
		СверитьКарты(ПоПресету.МаппингПрофиля, ПоУмолчаниям.МаппингПрофиля, Ключ + ": маппинг профиля");
		СверитьКарты(ПоПресету.АлиасыКлеймов, ПоУмолчаниям.АлиасыКлеймов, Ключ + ": алиасы клеймов");

	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ПравкаОтданныхУмолчанийНеМеняетПресетБиблиотеки() Экспорт

	// ЧТО ЭТОТ ТЕСТ ОХРАНЯЕТ. Умолчания берут, чтобы их править. Отданное ссылкой
	// на внутренности означало бы, что первая же правка меняет пресет всем
	// последующим входам процесса — включая чужого провайдера.
	Эталон = РазвёрнутоеОписание(СПресетом("github"));   // снят до порчи

	Пресеты = Новый УмолчанияПресетов();
	Первые = Пресеты.Умолчания("github");
	Первые.Вставить("Область", "испорчено");
	Первые.КонечныеТочки.Вставить("Авторизация", "https://зло.example.com/authorize");
	Первые.МаппингПрофиля.Вставить("Субъект", "login");
	Первые.АлиасыКлеймов.Вставить("preferred_username", "испорчено");

	Вторые = Пресеты.Умолчания("github");

	Ожидаем.Что(Вторые.Область, "область пресета цела").Равно(Эталон.Область);
	Ожидаем.Что(Вторые.КонечныеТочки.Получить("Авторизация"), "точка авторизации цела")
		.Равно(Эталон.КонечныеТочки.Получить("authorization_endpoint"));
	Ожидаем.Что(Вторые.МаппингПрофиля.Получить("Субъект"), "маппинг профиля цел")
		.Равно(Эталон.МаппингПрофиля.Получить("Субъект"));
	Ожидаем.Что(Вторые.АлиасыКлеймов.Получить("preferred_username"), "алиасы клеймов целы")
		.Равно(Эталон.АлиасыКлеймов.Получить("preferred_username"));

	// и сам провайдер после чужой правки собирается прежним
	Ожидаем.Что(РазвёрнутоеОписание(СПресетом("github")).Область, "пресет отдаёт прежнюю область")
		.Равно(Эталон.Область);

КонецПроцедуры

&Тест
Процедура АдресСамостоятельнойИнсталляцииНеПрилипаетКПресету() Экспорт

	// ЧТО ЭТОТ ТЕСТ ОХРАНЯЕТ. Издатель GitLab считается по адресу инсталляции, и
	// заготовке пресета он не принадлежит: иначе прочитавший умолчания следом
	// получил бы издателя чужой инсталляции.
	Пресеты = Новый УмолчанияПресетов();
	Своя = Новый Структура("БазовыйАдрес", "https://git.example.com/");

	Ожидаем.Что(Пресеты.Умолчания("gitlab", Своя).Издатель, "издатель своей инсталляции")
		.Равно("https://git.example.com");
	Ожидаем.Что(Пресеты.Умолчания("gitlab").Издатель, "без адреса — облачный GitLab")
		.Равно("https://gitlab.com");

КонецПроцедуры

&Тест
Процедура НастройкаОдногоПровайдераНеМеняетПресетСоседям() Экспорт

	// ЧТО ЭТОТ ТЕСТ ОХРАНЯЕТ. Заготовка пресета одна на процесс. Провайдер,
	// сузивший себе области, не должен раздать их всем следующим, кто заведён
	// тем же пресетом: второй вход молча ушёл бы с чужим scope.
	Умолчание = Новый УмолчанияПресетов().Умолчания("github").Область;   // снято до

	Свой = СПресетом("github");
	Свой.Вставить("Область", "read:user read:org");
	Ожидаем.Что(РазвёрнутоеОписание(Свой).Область, "свою область провайдер получает")
		.Равно("read:user read:org");

	Ожидаем.Что(РазвёрнутоеОписание(СПресетом("github")).Область,
		"соседу достаётся умолчание пресета, а не чужая область").Равно(Умолчание);
	Ожидаем.Что(Новый УмолчанияПресетов().Умолчания("github").Область,
		"умолчания пресета целы").Равно(Умолчание);

КонецПроцедуры

&Тест
Процедура НеизвестныйКлючОтклоняетсяТемЖеИсключением() Экспорт

	ОтУмолчаний = СообщениеОтказа("нет-такого");
	Ожидаем.Что(ОтУмолчаний, "неизвестный ключ не проходит молча").Заполнено();
	Ожидаем.Что(ОтУмолчаний).Содержит("нет-такого");

	ОтПресетов = "";
	Попытка
		ПресетыПровайдеров.Описание("нет-такого");
	Исключение
		ОтПресетов = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(ОтУмолчаний, "текст отказа тот же, что у разворота пресета").Равно(ОтПресетов);

КонецПроцедуры

#КонецОбласти

#Область ЯвноеПобеждаетПресет

&Тест
Процедура ЯвнаяОбластьПобеждаетПресетАПустаяНет() Экспорт

	// ЧТО ЭТОТ ТЕСТ ОХРАНЯЕТ. Приложению нужны области сверх пресетных (у GitHub
	// без read:org не перечислить репозитории организации). Оно читает умолчание,
	// дописывает своё и кладёт обратно — а незаполненная графа его настройки
	// приходит пустой строкой и обязана оставить умолчание пресета.
	Умолчание = Новый УмолчанияПресетов().Умолчания("github").Область;
	Расширенная = Умолчание + " read:org";

	Данные = СПресетом("github");
	Данные.Вставить("Область", Расширенная);
	Ожидаем.Что(РазвёрнутоеОписание(Данные).Область, "явно заданное побеждает пресет")
		.Равно(Расширенная);

	Данные.Вставить("Область", "");
	Ожидаем.Что(РазвёрнутоеОписание(Данные).Область, "пустая графа не стирает умолчание пресета")
		.Равно(Умолчание);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Описание провайдера после разворота пресета — тем же путём, каким его видит
// приложение.
Функция РазвёрнутоеОписание(Знач Данные)
	Возврат Новый ВходЧерезПровайдера(Данные).Описание();
КонецФункции

Функция СПресетом(Знач Ключ)
	Данные = НастройкиПресета(Ключ);
	Данные.Вставить("Пресет", Ключ);
	Возврат Данные;
КонецФункции

// То же описание, но пресет заменён его умолчаниями, прочитанными снаружи.
Функция ИзУмолчаний(Знач Ключ)
	Данные = НастройкиПресета(Ключ);
	Для Каждого КиЗ Из Новый УмолчанияПресетов().Умолчания(Ключ, Данные) Цикл
		Данные.Вставить(КиЗ.Ключ, КиЗ.Значение);
	КонецЦикла;
	Возврат Данные;
КонецФункции

Функция НастройкиПресета(Знач Ключ)
	Данные = Новый Структура();
	Данные.Вставить("Имя", Ключ);
	Данные.Вставить("ИдентификаторКлиента", "client-1");
	Данные.Вставить("СекретКлиента", "s3cr3t");
	Данные.Вставить("АдресВозврата", "https://app.example.com/callback");
	Данные.Вставить("БазовыйАдрес", "https://git.example.com");
	Возврат Данные;
КонецФункции

// Текст исключения, которым отклонён ключ пресета ("" — если принят).
Функция СообщениеОтказа(Знач Ключ)
	Пресеты = Новый УмолчанияПресетов();
	Попытка
		Пресеты.Умолчания(Ключ);
	Исключение
		Возврат ОписаниеОшибки();
	КонецПопытки;
	Возврат "";
КонецФункции

Процедура СверитьКарты(Знач Ожидаемая, Знач Фактическая, Знач Пояснение)

	Если Ожидаемая = Неопределено Тогда
		Ожидаем.Что(Фактическая, Пояснение).Равно(Неопределено);
		Возврат;
	КонецЕсли;

	Ожидаем.Что(Фактическая.Количество(), Пояснение + ": число ключей").Равно(Ожидаемая.Количество());
	Для Каждого КиЗ Из Ожидаемая Цикл
		Ожидаем.Что(Фактическая.Получить(КиЗ.Ключ), Пояснение + ": " + Строка(КиЗ.Ключ))
			.Равно(КиЗ.Значение);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
